<Window x:Class="KillerShell.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerShell"
        xmlns:shellns="clr-namespace:KillerShell.Shell"
        xmlns:models="clr-namespace:KillerShell.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KillerShell"
        Icon="pack://application:,,,/Resources/ksh-icon.ico"
        Height="710" Width="1140" MinHeight="520" MinWidth="600"
        WindowStyle="None"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="8" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- WINDOW FRAME. Four zero-thickness borders on every ordinary theme, so this costs nothing
         and draws nothing there; on 98SE they become the hard Win98 double frame - a raised outer
         pair and a recessed inner pair, light on top-left and dark on bottom-right. Wrapping the
         root rather than sitting inside it, so the frame is genuinely the window's edge. -->
    <!-- No Padding on this Border. The bevels below are its children, so a padding here pushed
         them INSIDE the frame and the raised edge drew 5px in from the window instead of on it -
         which is the odd border that kept showing up. The frame face fills
         the whole window, the bevels sit on its true edge, and the CONTENT is inset instead, by
         WindowFramePadding on RootGrid below. -->
    <Border x:Name="WindowFrame" Background="{DynamicResource WindowFrameBrush}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="{DynamicResource WindowEdgeThickness}">
        <Grid>
            <!-- THE CLIENT FACE. WindowFrameBrush fills the WHOLE window behind the content, and
                 on 98SE it is a light-to-dark diagonal GRADIENT meant only for the frame's 3px
                 face - so every transparent surface in the client area (the tab band, the
                 bookmarks drawer, the rail gutter) showed the gradient instead of the flat
                 #c0c0c0, each at a slightly different gray depending on where it sat. That is
                 exactly why the sidebar came out a different gray than the details pane:
                 the sidebar was gradient, the details strip was painted PaneBrush.
                 This Border repaints the flat window color over everything INSIDE the frame, so
                 the gradient survives only on the frame face itself. On the other twelve themes
                 WindowFramePadding is 0 and this paints BackgroundBrush at exactly the window's
                 own bounds - identical to the Window Background under it, including the five
                 full-window gradient themes, so nothing moves anywhere else. -->
            <Border Margin="{DynamicResource WindowFramePadding}" Background="{DynamicResource BackgroundBrush}"/>
            <!-- Named so Elevation.cs can repaint the OUTERMOST ring in the accent on an admin
                 window: on 98SE the elevation signal is the window's own edge line, not an
                 overlay ring inside the client. -->
            <Border x:Name="FrameOuterLightBd" BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border x:Name="FrameOuterDarkBd"  BorderBrush="{DynamicResource FrameOuterDarkBrush}"  BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <Border x:Name="FrameInnerLightBd" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border x:Name="FrameInnerDarkBd" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}"  BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>

    <Grid x:Name="RootGrid" Opacity="0" Margin="{DynamicResource WindowFramePadding}">
        <Grid.RowDefinitions>
            <!-- 0: title bar. Height is set from code (Chrome.cs SyncTitleBarMetrics) to whatever
                 the theme's TitleBarHeight is, NOT hardcoded. It WAS hardcoded to 36 while the
                 caption Grid inside it is TitleBarHeight - 22 on 98SE - and a child with an
                 explicit Height CENTERS in its row, so 7px of bare frame gray landed above the
                 caption and another 7 below it. That is the "bar above the titlebar" and the
                 matching one under it; trimming WindowFramePadding could
                 never reach it, because the gap was inside the row rather than outside it.
                 A RowDefinition takes a GridLength, which is why this is code and not a
                 DynamicResource on a Double. -->
            <RowDefinition x:Name="TitleRow" Height="36"/>
            <RowDefinition Height="*"/>    <!-- 1: main content -->
            <!-- FooterHeight, applied in Chrome.cs SyncTitleBarMetrics beside TitleRow. This was
                 the only chrome height in the app still hardcoded, which is why the footer's
                 sunken cell could not grow to fit its own text on 98SE. -->
            <RowDefinition x:Name="FooterRow" Height="24"/>   <!-- 2: footer -->
        </Grid.RowDefinitions>

        <!-- ══════════ ROW 0 - TITLE BAR ══════════
             Height and brush come from the theme (ThemeManager's 98SE chrome contract): 36 and
             BackgroundBrush on every ordinary theme, a short Win98 caption with its own gradient
             on a flat one. Bound rather than hardcoded so 98SE needs no branch here. -->
        <!-- TitleBarBleed is a negative margin (-1,0,-1,0 on 98SE) that lets the caption run out
             over the frame's inner bevel, the way a Win98 title bar meets its frame with no gap.
             Zero everywhere else. -->
        <Grid Grid.Row="0" Height="{DynamicResource TitleBarHeight}"
              Margin="{DynamicResource TitleBarBleed}"
              Background="{DynamicResource TitleBarBrush}">
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <ImageBrush x:Name="TitleGrainBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                </Border.Background>
                <Border.OpacityMask><SolidColorBrush Color="White" Opacity="{DynamicResource GrainOpacity}"/></Border.OpacityMask>
            </Border>

            <!-- App icon + wordmark, exactly like KillerScan: icon in the corner, then the
                 typewriter wordmark with a blurred dark copy behind the crisp text
                 (faded by IconShadowOpacity; 0 in light mode = no shadow). -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource TitleBarPadding}">
                <Image x:Name="TitleIcon" VerticalAlignment="Center"
                       Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                       Margin="{DynamicResource TitleIconMargin}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"
                       MouseWheel="LogoBar_MouseWheel" MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"/>
                <!-- A Win98 caption has no logotype in it - just the icon and the window's name in
                     plain bold. On a flat theme this shows and the wordmark below collapses; on
                     every other theme it is the other way round (ThemeManager sets both). -->
                <!-- Wheel-zoomable like the wordmark: on a flat theme the wordmark is COLLAPSED,
                     so this plain title is the only thing in the caption to roll the wheel over
                     - without these the app zoom was simply unreachable on 98SE.
                     Opting into chrome hit-testing takes it out of the native
                     caption, so drag and double-click-maximize come back via the LogoBar
                     handlers, exactly as the wordmark does it. -->
                <TextBlock x:Name="PlainTitle" Text="KillerShell" VerticalAlignment="Center"
                           Visibility="{DynamicResource PlainTitleVisibility}"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent"
                           MouseWheel="LogoBar_MouseWheel" MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                           FontFamily="{DynamicResource ChromeFontFamily}" FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource ChromeTextBrush}"
                           Margin="{DynamicResource TitleTextMargin}"/>
                <!-- The wordmark drives the app-wide accessibility size: roll the wheel over it
                     (AppScale.cs). Hit-test-visible in the chrome so the wheel reaches it, which
                     also opts it out of the native caption - so window drag and double-click
                     maximize come back via the LogoBar handlers. Family standard; the website
                     link lives on the About card's wordmark. -->
                <Grid x:Name="LogoBar" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      Visibility="{DynamicResource WordmarkVisibility}"
                      Cursor="Hand" ToolTip="{DynamicResource Str_TT_AppSize}" Background="Transparent"
                      MouseWheel="LogoBar_MouseWheel" MouseLeftButtonDown="LogoBar_MouseLeftButtonDown">
                    <!-- Sizes come from the theme: 17/22 by default (the family standard), smaller
                         on a flat theme whose caption bar is far shorter. WordmarkEmbossOpacity is
                         the blurred dark copy behind the crisp text, 0 where an emboss is wrong. -->
                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                               Margin="1,2,0,0" Opacity="{DynamicResource WordmarkEmbossOpacity}">
                        <TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect>
                        <Run Text="Killer" Foreground="#D8000000"/><Run Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" FontWeight="Bold" Foreground="#D8000000"/>
                    </TextBlock>
                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}">
                        <Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </TextBlock>
                </Grid>

                <!-- Elevated only (Elevation.cs). OUTSIDE LogoBar on purpose: the wordmark is
                     the scroll-to-zoom target, and widening its hit area with a caption would
                     mean rolling the wheel next to the logo silently resized the app. -->
                <TextBlock x:Name="ElevatedTag" Visibility="Collapsed" VerticalAlignment="Center"
                           Margin="9,3,0,0" FontFamily="Consolas" FontSize="11.5"
                           Text="{DynamicResource Str_Title_Elevated}"/>
            </StackPanel>

            <!-- CaptionButtonsMargin: 0 on every ordinary theme, so the buttons run flush to the
                 window edge exactly as they did. Win98 left a couple of pixels between the last
                 button and the frame, which 98SE asks for with 0,0,3,0. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="{DynamicResource CaptionButtonsMargin}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Language and theme moved to the icon rail (column 0), the way KillerNotes
                     has them. The title bar keeps only the window buttons. -->
                <Button x:Name="MinimizeBtn" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}" Content="&#xE921;"/>
                <Button x:Name="MaximizeBtn" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}" Content="&#xE922;"/>
                <Button x:Name="CloseBtn"    Click="CloseBtn_Click"    Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;"/>
            </StackPanel>

        </Grid>

        <!-- ══════════ ROW 1 - 2-PANEL GRID ══════════ -->
        <!-- ScaleHost: the app-wide accessibility zoom (AppScale.cs) puts a LayoutTransform
             here, not on the root grid, so the title bar and footer keep a fixed size and the
             wordmark you scroll over never moves. LayoutTransform reflows and re-rasterizes
             text; RenderTransform would bitmap-stretch it. -->
        <Grid x:Name="ScaleHost" Grid.Row="1" Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <!-- Folder tree, then the permanent icon rail on the tree's inner lip, then the
                     results, then the search panel out on the right edge. Both side panels
                     collapse to zero width and are driven from the one rail; the rail itself
                     never moves, which is the whole reason it sits between the tree and the
                     content rather than on the window's outer edge. -->
                <ColumnDefinition x:Name="TreeCol" Width="240" MinWidth="0" MaxWidth="420"/>
                <ColumnDefinition x:Name="RailCol" Width="24"/>
                <ColumnDefinition x:Name="TreeGapCol" Width="6"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition x:Name="SearchGapCol" Width="0"/>
                <ColumnDefinition x:Name="SearchCol" Width="0" MinWidth="0" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Continuous grain behind the whole row: both sidebars, the gaps, and the margins around the results pane -->
            <Border Grid.ColumnSpan="6" IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>

            <!-- COLUMN 0 - FOLDER TREE. Open by default: this is a file manager now, and the
                 tree is how you get around in one. Collapses from the rail. -->
            <!-- ClipToBounds: when the tree is COLLAPSED its column goes to zero width, but the
                 sunken well inside still measures its 2px of bevel and paints it outside the
                 column - and the inner ring of that well is PaneBevelDark2Brush, which is #000000
                 on 98SE. That is the black vertical line that kept showing immediately to the
                 left of the address bar (2026-08-09): it is the collapsed sidebar's well, not
                 anything belonging to the pane, which is why every change made inside the pane
                 left it exactly where it was. Clipping the panel to its own width stops a
                 zero-width column drawing anything at all. -->
            <Grid Grid.Column="0" x:Name="TreePanel" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Auto, so the favorites slide-up's animated Height drives the split and
                         the tree above simply gives up the room (the Killculator arrangement). -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- The edge fades are an OpacityMask on the TREE ITSELF, so its rows dissolve to
                     transparent and the real window shows through. They used to be two Borders
                     painted with BackgroundBrush sitting OVER the tree - which works only while
                     that key is a flat color. On Sepulchre, Decay, Delirium, Ectoplasm and
                     Malaise it is a full-window LinearGradientBrush, so each 30px strip re-ramped
                     the entire window gradient and showed up as a colored band across the
                     sidebar. Stop alphas and offsets are driven from
                     TreePanel.cs SyncTreeEdgeFades. -->
                <!-- SidebarPaneBrush is Transparent on every ordinary theme, so the tree keeps
                     showing the window through it; on 98SE it is the sunken white list well, with
                     the recessed bevel drawn by the two borders below. -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarPaneBrush}"
                        Margin="{DynamicResource SidebarPanelMargin}">
                    <Grid>
                        <!-- SUNKEN, so the brushes are CROSSED against the thicknesses: the dark
                             #808080 takes the TOP-LEFT thickness and the white takes the
                             bottom-right. Paired the obvious way round it comes out raised, which
                             is what the sidebar well was doing. -->
                        <Border BorderBrush="{DynamicResource PaneBevelDarkBrush}"  BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                        <Border BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                        <Border Margin="{DynamicResource PaneBevelInnerMargin}"
                                BorderBrush="{DynamicResource PaneBevelDark2Brush}"  BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                        <Border Margin="{DynamicResource PaneBevelInnerMargin}"
                                BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                <!-- TreePanePadding, not the literal 4,6,2,6. That 6px top inset let the well's
                     own SidebarPaneBrush show above the first row as a white strip inside the
                     sunken frame, and pushed the scrollbar down with it. A
                     Win98 list well is filled edge to edge, so the flat theme zeroes the top,
                     bottom and right; every other theme keeps the literal it had. -->
                <Border x:Name="TreeFadeHost" Background="Transparent" Padding="{DynamicResource TreePanePadding}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="TreeFadeTopOuter" Color="#FF000000" Offset="0"/>
                            <GradientStop x:Name="TreeFadeTopInner" Color="#FF000000" Offset="0.08"/>
                            <GradientStop x:Name="TreeFadeBotInner" Color="#FF000000" Offset="0.92"/>
                            <GradientStop x:Name="TreeFadeBotOuter" Color="#FF000000" Offset="0.995"/>
                            <!-- Full opacity again below the ramp. The horizontal scrollbar lives
                                 INSIDE this masked host, so without restoring alpha here the fade
                                 dissolved the scrollbar along with the last row - a stop's color
                                 carries on past it to the end of the brush. -->
                            <GradientStop x:Name="TreeFadeBotRestore" Color="#FF000000" Offset="0.996"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <TreeView x:Name="FolderTree" Style="{StaticResource FolderTreeView}"
                              TreeViewItem.Expanded="FolderTree_Expanded"
                              TreeViewItem.Collapsed="FolderTree_Collapsed"
                              ContextMenuOpening="FolderTree_ContextMenuOpening"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <!-- Folder-only menu, so it reuses the results menu's strings where they
                             already say the right thing (FolderTree.cs). On the TreeView itself,
                             not the item template - see the results list for why. -->
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <!-- "Open in new tab", not Str_Tab_New ("new search") - this row
                                     opens the node in a NEW TAB and has done for a long time; the
                                     label was left over from when every tab was a search, and it
                                     described the old app rather than what the row does. -->
                                <MenuItem Header="{DynamicResource Str_Menu_OpenInNewTab}" Click="TreeOpenNewTab_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE710;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Menu_ShowExplorer}" Click="TreeShowInExplorer_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE838;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Menu_SearchHere}" Click="TreeSearchHere_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE721;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <!-- The same two terminal rows the saved places carry, and the
                                     Storage Analyzer aimed at this folder. A folder is a folder
                                     wherever it is shown, so the tree, the places and the
                                     listing all offer the same verbs. -->
                                <MenuItem Header="{DynamicResource Str_Menu_OpenTerminal}" Click="TreeTerminal_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE756;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Menu_OpenTerminalAdmin}" Click="TreeTerminalAdmin_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Menu_AnalyzeStorage}" Click="TreeAnalyze_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEDA2;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <!-- The tree's OWN hidden switch, not the listing's Ctrl+H. Checked
                                     state is set as the menu opens (FolderTree.cs
                                     FolderTree_ContextMenuOpening) rather than bound, matching how
                                     the favorite row above flips its own header. -->
                                <!-- NO InputGestureText yet: Ctrl+Shift+H, the obvious pick, is
                                     already Copy SHA-256 (MainWindow.xaml.cs, and it is printed
                                     on that row in the results menu). Awaiting a free key rather
                                     than quietly taking a bound one. -->
                                <MenuItem x:Name="TreeHiddenItem" IsCheckable="True"
                                          Header="{DynamicResource Str_Menu_TreeShowHidden}"
                                          Click="TreeHidden_Click"/>
                                <Separator/>
                                <MenuItem Tag="fav" Header="{DynamicResource Str_Menu_AddFavorite}" Click="TreeFavorite_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE734;"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- E8C8 (Copy, two documents), not E71B (Link, a chain). -->
                                <MenuItem Header="{DynamicResource Str_Menu_CopyPath}" Click="TreeCopyPath_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C8;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Str_Menu_Properties}" Click="TreeProperties_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE946;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Menu_ShellMenu}" Click="TreeShellMenu_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE712;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <!-- Inherits the themed template from Controls.xaml and adds the
                                 two-way state bindings, so RevealInTree can drive the tree from
                                 code when navigation came from somewhere else. -->
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type shellns:FolderNode}"
                                                      ItemsSource="{Binding Children}">
                                <!-- Margin 0 (was 0,1): the same compaction the saved places got.
                                     The tree and the places sit in one column and have to read as
                                     one list, so a row of each has to be the same height. -->
                                <StackPanel Orientation="Horizontal">
                                    <!-- Drawn at 20 but MEASURED at 16: the negative side margins
                                         take the desired width back down, so the icon reads bigger
                                         without widening the row, moving the label or changing the
                                         vertical rhythm. Top and bottom stay 0 - a negative there
                                         would let a tall icon overlap its neighbors. Same trick
                                         the recents menu uses to fit a 20px icon in a fixed 16px
                                         gutter. -->
                                    <Image Source="{Binding Icon}" Width="20" Height="20"
                                           VerticalAlignment="Center" Margin="-2,-2,4,-2"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- No pinned Foreground: it inherits from the TreeViewItem so
                                         FolderTreeItem's selected trigger can turn it white on a
                                         solid selection (98SE) - a local TextBrush here was what
                                         kept selected rows black-on-navy. -->
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
                    </Grid>
                </Border>

                <!-- Edge fades, KillerNotes' NotesFade pattern on both ends: nodes dissolve into
                     the chrome as they scroll off rather than being clipped mid-row. The overlay
                     IS the chrome - BackgroundBrush plus the same grain - under an opacity mask,
                     so it fades to an exact match for the sidebar (never darker, grain intact)
                     instead of a flat black band. Inset 12px on the right to clear the
                     scrollbar, and hit-test-transparent so the tree still takes clicks under it.
                     Each one is only there while there is something PAST it - none at the very
                     top, none at the very bottom, the way the sites do it. A fade over an edge
                     that is already flush just looks like that row has been smudged. Both ramp
                     in over their own height as a row slides under them
                     (TreePanel.SyncTreeEdgeFades), so they arrive exactly as fast as they become
                     true and neither pops. -->
                <!-- A straight 2-stop linear ramp (0 -> 1 alpha) reads as a hard edge against a
                     busy tree of text and icons - the eye is far more sensitive to the first bit
                     of opacity than the last, so a "smooth" linear fade still looks like it snaps
                     on. Eased with extra stops instead, and the band is taller (18->30, 22->34)
                     so the curve has room to read as a dissolve rather than a stripe.
                     A first pass (2026-08-03) still finished the ramp exactly AT the outer
                     edge - full opacity landed on the very last pixel, which still reads as a
                     snap because there is no room left to perceive it arriving. Both now reach
                     their terminal value (fully solid for Bottom, fully clear for Top) with the
                     LAST QUARTER of the band held flat at that value, so the transition visibly
                     finishes with margin to spare rather than exactly on the boundary. -->

                <!-- FAVORITES SLIDE-UP (Bookmarks.cs). Height animates 0 -> open so it rises
                     out of the sidebar's bottom edge, the way KillerNotes' Killculator does.
                     No header and no close button by design: the rail star is the handle and
                     the rows are the whole content. A hairline on top is the only separator,
                     since a full card would read as a second panel rather than a drawer. -->
                <Border x:Name="BookmarksPanel" Grid.Row="1" Height="0" Visibility="Collapsed"
                        ClipToBounds="True" AllowDrop="True"
                        BorderBrush="{DynamicResource TreeLineBrush}" BorderThickness="0,1,0,0"
                        DragOver="BookmarksPanel_DragOver" Drop="BookmarksPanel_Drop">
                    <Grid>
                        <!-- Transparent, so the window's own background shows through the drawer.
                             This used to paint BackgroundBrush, which is a full-window
                             LinearGradientBrush on five of the themes - so the drawer re-ramped
                             the entire left-to-right gradient inside its own width and could
                             never line up with the sidebar it drops out of. Still a Border
                             rather than nothing: Transparent keeps it hit-testable, which the
                             panel's drag-and-drop needs. -->
                        <Border Background="Transparent"/>
                        <!-- NO grain layer here. The row-wide Border at the top of this Grid
                             already paints grain across both sidebars, the gaps and the margins,
                             and a second tile inside the drawer doubled it - which is why the
                             drawer read as a different shade from the rail right beside it
                             (2026-08-09). The drawer is transparent, so the continuous grain
                             shows through and the two surfaces match by construction. -->
                        <ListBox x:Name="BookmarksList" Background="Transparent" BorderThickness="0"
                                 Padding="4,4,2,4" Focusable="False" FocusVisualStyle="{x:Null}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 PreviewMouseWheel="BookmarksList_PreviewMouseWheel">
                            <!-- Bare template, so the list's only vertical chrome IS its Padding.
                                 The DEFAULT ListBox template wraps the ScrollViewer in a Border
                                 with a hardcoded Padding="1", which no measurement in Bookmarks.cs
                                 counts - BookmarksContentHeight/TryMeasureBookmarksContent both
                                 add Padding.Top+Bottom (8) while the template really took 10, so
                                 the content sat 2px taller than the drawer, the viewport sheared
                                 the last row's rounded corners flat, and the wheel/scrollbar
                                 suppression (same 8px math) hid any way to scroll them back into
                                 view. Making the geometry agree at the source
                                 beats teaching the measurements about a hidden template literal. -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <!-- Edge fades as an OpacityMask on the LIST ITSELF, the tree's own
                                 mechanism (TreeFadeHost): rows dissolve to TRANSPARENT and
                                 whatever is genuinely behind them shows through. They were two
                                 overlay Borders painted with BackgroundBrush, which is a
                                 full-window gradient on five themes - each strip re-ramped the
                                 entire gradient inside its own 18/22px and the list faded to the
                                 WRONG color. Stop alphas are
                                 driven from Bookmarks.cs SyncBookmarksEdgeFades. -->
                            <ListBox.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="BmFadeTopOuter" Color="#FF000000" Offset="0"/>
                                    <GradientStop x:Name="BmFadeTopInner" Color="#FF000000" Offset="0.10"/>
                                    <GradientStop x:Name="BmFadeBotInner" Color="#FF000000" Offset="0.90"/>
                                    <GradientStop x:Name="BmFadeBotOuter" Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </ListBox.OpacityMask>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type shellns:Bookmark}">
                                    <!-- Padding 4,1 (was 4,3): the places list is a dense index you
                                         scan, not a set of buttons, and two pixels a row is four
                                         more places visible before anything has to scroll. Keep
                                         BookmarksRowHeight in Bookmarks.cs in step with this -
                                         the drawer sizes itself from that constant. -->
                                    <Border Padding="4,1" CornerRadius="{DynamicResource SmallCornerRadius}" Cursor="Hand"
                                            ToolTip="{Binding Path}"
                                            PreviewMouseLeftButtonDown="Bookmark_DragDown"
                                            PreviewMouseMove="Bookmark_DragMove"
                                            MouseLeftButtonUp="Bookmark_DragUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <!-- Inherited by the row's label and glyph, so the
                                                     selected trigger below can flip both at once. -->
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <!-- Tag="on" set from code (Bookmarks.cs UpdateBookmarksSelection) when this
                                                         row is where the active tab actually is. Before IsMouseOver so a hover
                                                         still reads on top of a selected row rather than being hidden by it. -->
                                                    <Trigger Property="Tag" Value="on">
                                                        <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                                                        <!-- SelectionFg, the color that PAIRS with that fill. The label used to
                                                             be hardcoded to TextBrush, which is black on 98SE - black text on a
                                                             navy selection bar. -->
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource Str_Menu_OpenTerminal}"
                                                          Click="BookmarkTerminal_Click">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE756;"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource Str_Menu_OpenTerminalAdmin}"
                                                          Click="BookmarkTerminalAdmin_Click">
                                                    <!-- E7EF (admin shield), not the plain E756 both
                                                         rows used to carry - two identical icons on
                                                         two different actions is a menu that reads
                                                         as one repeated item. -->
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource Str_Menu_AnalyzeStorage}"
                                                          Click="BookmarkAnalyze_Click">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEDA2;"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource Str_Menu_Properties}"
                                                          Click="BookmarkProperties_Click">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE946;"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource Str_Menu_RemoveFavorite}"
                                                          Click="BookmarkRemove_Click">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE738;"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 20 drawn, 16 measured - see the tree's own icon
                                                 above. The saved places and the tree rows have to
                                                 move together or the sidebar reads as two
                                                 different lists.
                                                 The VERTICAL negatives matter as much as the
                                                 horizontal ones: with only the sides canceled the
                                                 row measured 20 tall instead of 16, every place
                                                 grew 4px, and the drawer could no longer fit its
                                                 own contents - a permanent scrollbar (2026-08-09).
                                                 2px of bleed each way sits inside the row's own
                                                 padding, so nothing overlaps its neighbor. -->
                                            <Image Source="{Binding Icon}" Width="20" Height="20"
                                                   VerticalAlignment="Center" Margin="-2,-2,4,-2"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <!-- No Foreground here: it inherits TextElement.Foreground
                                                 from the row Border, which flips to SelectionFg when
                                                 the row is the active one. -->
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The old overlay fade Borders lived here - replaced by the OpacityMask
                             on BookmarksList above, which dissolves to what is really behind the
                             rows instead of repainting BackgroundBrush at the wrong bounds. -->

                        <!-- The resize grip that lived here was removed 2026-08-15: the drawer
                             always auto-fits its content now (Bookmarks.cs, note at
                             BookmarksHeightMin), so there is nothing left to drag. The panel
                             Border's own 1px top edge remains the visible divider. -->
                    </Grid>
                </Border>

                <!-- RESIZE GRIP. A Thumb rather than a GridSplitter: a splitter resizes the two
                     columns either side of it, and this column's neighbor is the 24px rail,
                     which must never move. Driving TreeCol's width by hand lets the star column
                     absorb the change instead, and keeps the drag from fighting the collapse
                     animation, which sets that same Width property (TreePanel.cs).
                     Spans both rows so the whole edge is grabbable, favorites included, and
                     sits last so it is above the edge fades. -->
                <Thumb x:Name="TreeResizeGrip" Grid.RowSpan="2" Panel.ZIndex="50"
                       HorizontalAlignment="Right" Width="5" Cursor="SizeWE"
                       DragDelta="TreeResizeGrip_DragDelta" DragCompleted="TreeResizeGrip_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <!-- Transparent, not empty: a Border with no Background is not
                                 hit-testable, so the grip would be invisible AND unusable. -->
                            <Border x:Name="grip" Background="Transparent">
                                <Rectangle x:Name="hint" Width="1" HorizontalAlignment="Right"
                                           Fill="{DynamicResource TreeLineBrush}" Opacity="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                    <Setter TargetName="hint" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

            <!-- COLUMN 1 - ICON RAIL, on the tree's inner lip. That placement is the
                 KillerNotes / KillerPDF pattern and it is the point of it: the icons sit right
                 next to the results whether the tree is open or shut and never move when it
                 collapses. Putting the rail on the window's outer edge instead makes them jump.
                 Layout is the family standard: ONE chevron pinned at the top that collapses the
                 sidebars, and a bottom stack of feature toggles. The 2px left margin on
                 centered elements is a 1px shift toward the pane, so the icons read as
                 centered on the strip. -->
            <Grid Grid.Column="1">
                <!-- Collapses THIS sidebar - the tree - and nothing else, exactly like
                     KillerNotes. The tree is the sidebar's default content, so it needs no
                     separate rail icon; the search panel on the far right is not this
                     chevron's business and has its own toggle below. -->
                <Button x:Name="SidebarToggleBtn" Style="{StaticResource RailButton}"
                        Content="&#xE76B;" FontSize="12"
                        VerticalAlignment="Top" HorizontalAlignment="Center" Margin="2,10,0,0"
                        ToolTip="{DynamicResource Str_TT_CollapseSidebar}" Click="TreePanel_Click"/>
                <StackPanel x:Name="RailBottom" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="2,0,0,6">
                    <!-- E721 (magnifier): the search panel, out on the right edge. Glyph never
                         changes - RailButton draws it in TextBrush and switches to the accent
                         on Tag="on", which is the open/shut tell. -->
                    <Button x:Name="SearchPanelBtn" Style="{StaticResource RailButton}" Content="&#xE721;"
                            FontSize="12" Margin="0,0,0,10" Click="SearchPanel_Click"
                            ToolTip="{DynamicResource Str_TT_SearchPanel}"/>
                    <!-- E734 (star): the saved-locations slide-up under the tree
                         (Bookmarks.cs). Accents while open, like the search toggle. -->
                    <Button x:Name="BookmarksBtn" Style="{StaticResource RailButton}" Content="&#xE734;"
                            FontSize="12" Margin="0,0,0,10" Click="BookmarksBtn_Click"
                            ToolTip="{DynamicResource Str_TT_Bookmarks}"/>
                    <!-- E8A1 (list): results density. Click cycles Comfortable -> Compact ->
                         Minimal, the wheel steps through them - the same gesture and the same
                         glyph KillerNotes uses for its sidebar density (Density.cs). -->
                    <Button x:Name="DensityBtn" Style="{StaticResource RailButton}" Content="&#xE8A1;"
                            FontSize="12" Margin="0,0,0,10" Click="Density_Click"
                            MouseWheel="Density_MouseWheel"
                            ToolTip="{DynamicResource Str_TT_Density}"/>
                    <!-- E70F (pencil): a blank document in a new tab in the FOCUSED pane, the
                         same glyph an editor tab carries (EditorTabs.GlyphEdit). No shortcut of
                         its own - F7 is the editor key and it belongs to the row you have
                         selected; this is the one way in that starts from nothing, and nothing
                         is written to disk until the first save asks where it goes. -->
                    <Button x:Name="NewDocRailBtn" Style="{StaticResource RailButton}" Content="&#xE70F;"
                            FontSize="12" Margin="0,0,0,10" Click="NewDoc_Click"
                            ToolTip="{DynamicResource Str_TT_NewDoc}"/>
                    <!-- E756 (command prompt): opens a PowerShell here on a left click, and
                         right-click picks the shell. Four rows rather than four rail icons -
                         the rail is family furniture and a column of near-identical prompts
                         would read as clutter, while the pair you actually reach for most is
                         one click and one chord away regardless (F8 / Ctrl+F8). -->
                    <Button x:Name="TerminalRailBtn" Style="{StaticResource RailButton}" Content="&#xE756;"
                            FontSize="12" Margin="0,0,0,10" Click="TerminalRail_Click"
                            ToolTip="{DynamicResource Str_TT_Terminal}">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top">
                                <MenuItem Header="{DynamicResource Str_Term_PowerShell}" Click="RailShellPs_Click" InputGestureText="F8">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE756;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Term_PowerShellAdmin}" Click="RailShellPsAdmin_Click" InputGestureText="Ctrl+F8">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Str_Term_Cmd}" Click="RailShellCmd_Click" InputGestureText="Shift+F8">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE756;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Term_CmdAdmin}" Click="RailShellCmdAdmin_Click" InputGestureText="Ctrl+Shift+F8">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <!-- Rows are built as the submenu OPENS (ProfileMenu.cs), from
                                     the PowerShell hosts actually installed - PowerShell 7 gets
                                     installed on a machine mid-session often enough that a fixed
                                     pair would go on lying for the rest of the session. The
                                     placeholder child is what makes WPF draw the arrow and fire
                                     SubmenuOpened at all; it is replaced before it is seen. -->
                                <MenuItem Header="{DynamicResource Str_Prof_Edit}" InputGestureText="Ctrl+,"
                                          SubmenuOpened="RailProfileMenu_Opened">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE70F;"/></MenuItem.Icon>
                                    <MenuItem/>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Open or close the second pane, right-click flips side-by-side / stacked.
                         On the rail rather than in a pane toolbar because it acts on the WINDOW -
                         in the toolbar there were two of them, one per pane, doing the identical
                         thing, and either could be shed into the overflow chevron on a narrow
                         split. Accents while open, like the search and bookmarks toggles above.
                         ClosePane/OpenPane (E89F/E8A0), the dedicated glyph pair picked for this
                         (2026-08-02) - the glyph itself is kept in sync from code (DualPane.cs
                         ApplyPaneLayout) on every open/close/orientation change, so E89F here is
                         only the closed starting glyph before the first toggle ever runs.
                         Moved ABOVE the tool tabs so the admin tools sit together
                         - dual pane is a VIEW verb, so it rides with the view block
                         and the four admin/tool tabs below sit as one contiguous group. -->
                    <Button x:Name="DualPaneRailBtn" Style="{StaticResource RailButton}" Content="&#xE89F;"
                            FontSize="12" Margin="0,0,0,10" Click="DualPane_Click"
                            MouseRightButtonUp="DualPaneOrient_Click"
                            ToolTip="{DynamicResource Str_TT_DualPane}"/>
                    <!-- E8FD (ViewAll/list, corrected 2026-08-02 - this comment used to say E9D9,
                         which was never what the button below actually rendered; E9D9 was always
                         reserved for the future Performance tab, now built below): opens or
                         focuses the Task Manager tab - a live, filterable list of every process on
                         the machine (Shell/ProcessTabs.cs, Tools/ProcessListControl.cs). Left click
                         is the plain F9 open; right-click offers the Ctrl+F9 elevated relaunch too,
                         same shape as the Terminal menu above, so the tooltip no longer has to
                         spell out the elevated path in prose. -->
                    <Button x:Name="TaskManagerRailBtn" Style="{StaticResource RailButton}" Content="&#xE8FD;"
                            FontSize="12" Margin="0,0,0,10" Click="TaskManagerRail_Click"
                            ToolTip="{DynamicResource Str_TT_TaskManager}">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top">
                                <MenuItem Header="{DynamicResource Str_Rail_ProcessesOpen}" Click="RailProcessesOpen_Click" InputGestureText="F9">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8FD;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Rail_ProcessesAdmin}" Click="RailProcessesAdmin_Click" InputGestureText="Ctrl+F9">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- E9D9 (Processing): opens or focuses the Performance Monitor tab - hardware
                         info plus live CPU/RAM/network/disk gauges (Shell/PerformanceTabs.cs,
                         Tools/PerformanceMonitorControl.cs). Plain click only, no elevated variant
                         - Performance needs none of the extra access an admin relaunch would grant
                         (PerformanceTabs.cs has the full reasoning). -->
                    <Button x:Name="PerformanceRailBtn" Style="{StaticResource RailButton}" Content="&#xE9D9;"
                            FontSize="12" Margin="0,0,0,10" Click="PerformanceRail_Click"
                            ToolTip="{DynamicResource Str_TT_Performance}"/>
                    <!-- EDA2 (HardDrive) - already proven to render as the folder picker's drive
                         glyph, and distinct from Processes' E8FD, Event Viewer's E81C and
                         Performance's E9D9. Opens or focuses the Storage Analyzer tab - scan a
                         folder or drive into a WizTree-style treemap (Shell/StorageTabs.cs,
                         Tools/StorageAnalyzerControl.cs). Right-click offers the elevated scan,
                         same open/admin pair as Processes above (F4 / Ctrl+F4). -->
                    <Button x:Name="StorageRailBtn" Style="{StaticResource RailButton}" Content="&#xEDA2;"
                            FontSize="12" Margin="0,0,0,10" Click="StorageRail_Click"
                            ToolTip="{DynamicResource Str_TT_Storage}">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top">
                                <MenuItem Header="{DynamicResource Str_Rail_StorageOpen}" Click="RailStorageOpen_Click" InputGestureText="F4">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEDA2;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Str_Rail_StorageAdmin}" Click="RailStorageAdmin_Click" InputGestureText="Ctrl+F4">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- E74C (OEM) - a four-pane window with a corner mark, which reads as the
                         registry's hive/key structure far better than a plain list did. Went
                         through E945 (rendered as a lightning bolt, not the intended
                         database-cylinder glyph), E713 (Settings gear, too generic) and E71D
                         (List) before landing here (2026-08-08). NOTE: RegistryEditorTabs.cs
                         RegistryEditorGlyph still carries E71D for the TAB strip - the two used to
                         match deliberately, so change both or neither. Opens or focuses the
                         Registry Editor tab - a real
                         regedit-equivalent browser/editor over the five hives
                         (Shell/RegistryEditorTabs.cs, Tools/RegistryEditorControl.cs). Ctrl+F11
                         ONLY - there is no unelevated variant at all (the registry needs admin to
                         write most of what a registry editor exists to edit), so unlike Processes
                         above this one gets no context menu; there is nothing to choose between. -->
                    <Button x:Name="RegistryEditorRailBtn" Style="{StaticResource RailButton}" Content="&#xE74C;"
                            FontSize="12" Margin="0,0,0,10" Click="RegistryEditorRail_Click"
                            ToolTip="{DynamicResource Str_TT_RegistryEditor}"/>
                    <!-- E71D (List): the glyph Registry Editor used to carry, handed over when
                         Registry moved to E74C (2026-08-08). A list of log lines is what
                         this tab actually is, and E81C (History) read as a clock, which is not
                         the same idea. Opens or focuses the Event Viewer tab - a filterable grid
                         over the Application/System/Security event logs (Shell/EventViewerTabs.cs,
                         Tools/EventViewerControl.cs). Ctrl+F12 ONLY - same reasoning as Registry
                         Editor above: the Security log refuses a standard token outright, so there
                         is no unelevated mode to offer and no context menu here either. -->
                    <Button x:Name="EventViewerRailBtn" Style="{StaticResource RailButton}" Content="&#xE71D;"
                            FontSize="12" Margin="0,0,0,10" Click="EventViewerRail_Click"
                            ToolTip="{DynamicResource Str_TT_EventViewer}"/>
                    <!-- "?" (a literal, in Consolas): the shortcuts card, F1. Sits directly above
                         the globe, which is where KillerNotes and KillerScan put it - the rail
                         order is family furniture, so it has to match. -->
                    <Button Style="{StaticResource RailButton}" Content="?"
                            FontFamily="Consolas" FontSize="18" Margin="0,0,0,10"
                            Click="Shortcuts_Click" ToolTip="{DynamicResource Str_Help_Shortcuts}"/>
                    <!-- F2B7 (LocaleLanguage - globe with characters in front): the locale menu,
                         filled on click by BuildLanguageMenu (Language.cs). Family standard for the
                         language button, in preference to the bare E774 globe. Placement="Top" so it
                         opens upward off the rail's bottom rather than off the bottom of the window. -->
                    <Button x:Name="LangButton" Style="{StaticResource RailButton}" Content="&#xF2B7;"
                            Margin="0,0,0,10" Click="LangButton_Click"
                            ToolTip="{DynamicResource Str_TT_Language}">
                        <Button.ContextMenu>
                            <!-- Family flyout standard, ported verbatim from KillerPDF: chrome
                                 ONLY from FlyoutCard + FlyoutGrain, PanelMenuItem stripping the
                                 MenuItem container. Content built in code (Language.cs
                                 BuildLanguageMenu) as RadioButtons in a single StackPanel, same
                                 shape as PDF's XAML-built LangFlyout. Placement set in code
                                 (LangButton_Click, via FlyoutPlacement.cs) - pinned to the
                                 content pane's bottom-left corner, PDF's own mechanism. -->
                            <ContextMenu x:Name="LangMenu">
                                <!-- The raised bevel pair around the card is KillerNotes' exact
                                     treatment (its LangMenu template): two Borders aligned to the
                                     FlyoutCard itself, zero-thickness on every theme but 98SE, where
                                     the flyout becomes a hard raised Win98 box - the locale and
                                     theme flyouts carry the same beveled edge as KillerNotes'. -->
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Grid>
                                            <Border Style="{StaticResource FlyoutCard}">
                                                <Grid>
                                                    <ItemsPresenter/>
                                                    <Border Style="{StaticResource FlyoutGrain}"/>
                                                </Grid>
                                            </Border>
                                            <Border IsHitTestVisible="False" Margin="22,18,22,26"
                                                    BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                            <Border IsHitTestVisible="False" Margin="22,18,22,26"
                                                    BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource PanelMenuItem}"/>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- E790 (paint roller): the theme + accent flyout, same family standard as
                         LangMenu above - Button.ContextMenu, FlyoutCard/FlyoutGrain chrome,
                         PanelMenuItem stripping. Content is XAML-built RadioButtons, matching
                         KillerPDF's ThemeFlyout verbatim (Str_Theme_* names, ThemeGroup radios,
                         AccentDot rows under Dark/Light/Black), plus KillerShell's own Fonts and
                         File Associations rows kept below the theme picker - those two rows have
                         no equivalent in PDF and were not part of what looked wrong, so they stay. -->
                    <Button x:Name="ThemeButton" Style="{StaticResource RailButton}" Content="&#xE790;"
                            Click="ThemeButton_Click" ToolTip="{DynamicResource Str_TT_Theme}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ThemeFlyout">
                                <!-- Same raised bevel pair as LangMenu above - the KillerNotes
                                     flyout treatment, inert off 98SE. -->
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Grid>
                                            <Border Style="{StaticResource FlyoutCard}">
                                                <Grid>
                                                    <ItemsPresenter/>
                                                    <Border Style="{StaticResource FlyoutGrain}"/>
                                                </Grid>
                                            </Border>
                                            <Border IsHitTestVisible="False" Margin="22,18,22,26"
                                                    BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                            <Border IsHitTestVisible="False" Margin="22,18,22,26"
                                                    BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource PanelMenuItem}"/>
                                </ContextMenu.ItemContainerStyle>
                                <Grid Margin="12,10,3,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                <!-- Content-sized for the two command rows below. The former
                                     fixed 120px clipped even English "File associations..." and
                                     could not accommodate the longer localized labels at all. -->
                                <StackPanel x:Name="ThemeSubmenu" MinWidth="150" Grid.Column="0">
                                    <RadioButton x:Name="ThemeDarkRadio"
                                                 Content="{DynamicResource Str_Theme_Dark}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeDarkRadio_Checked"/>
                                    <RadioButton x:Name="ThemeLightRadio"
                                                 Content="{DynamicResource Str_Theme_Light}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeLightRadio_Checked"/>
                                    <RadioButton x:Name="ThemeHCRadio"
                                                 Content="{DynamicResource Str_Theme_Black}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeHCRadio_Checked"/>
                                    <RadioButton x:Name="Theme98SERadio"
                                                 Content="{DynamicResource Str_Theme_SE98}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="Theme98SERadio_Checked"/>
                                    <RadioButton x:Name="ThemeBloodRadio"
                                                 Content="{DynamicResource Str_Theme_Blood}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeBloodRadio_Checked"/>
                                    <RadioButton x:Name="ThemeGreedRadio"
                                                 Content="{DynamicResource Str_Theme_Greed}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeGreedRadio_Checked"/>
                                    <RadioButton x:Name="ThemeCyanoticRadio"
                                                 Content="{DynamicResource Str_Theme_Cyanotic}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeCyanoticRadio_Checked"/>
                                    <RadioButton x:Name="ThemeEctoplasmRadio"
                                                 Content="{DynamicResource Str_Theme_Ectoplasm}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeEctoplasmRadio_Checked"/>
                                    <RadioButton x:Name="ThemeDecayRadio"
                                                 Content="{DynamicResource Str_Theme_Decay}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeDecayRadio_Checked"/>
                                    <!-- Last four in KillerNotes' picker order: Malaise, Sepulchre,
                                         Delirium, Mourning. There is no logic to it, but the two
                                         apps listing the same thirteen themes in different orders
                                         is worse than an arbitrary order shared by both.
                                         Note this is NOT the enum's order, which
                                         KillerNotes also keeps separate - the enum is persistence,
                                         this is presentation. -->
                                    <RadioButton x:Name="ThemeMalaiseRadio"
                                                 Content="{DynamicResource Str_Theme_Malaise}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeMalaiseRadio_Checked"/>
                                    <RadioButton x:Name="ThemeSepulchreRadio"
                                                 Content="{DynamicResource Str_Theme_Sepulchre}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeSepulchreRadio_Checked"/>
                                    <RadioButton x:Name="ThemeDeliriumRadio"
                                                 Content="{DynamicResource Str_Theme_Delirium}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeDeliriumRadio_Checked"/>
                                    <RadioButton x:Name="ThemeMourningRadio"
                                                 Content="{DynamicResource Str_Theme_Mourning}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Checked="ThemeMourningRadio_Checked"/>

                                    <!-- Fonts/File Associations: KillerShell-only rows, kept from
                                         the old flyout content - not part of PDF's menu, and not
                                         part of what was reported wrong, so left in place. -->
                                    <Border Height="1" Margin="0,12,0,6" Background="{DynamicResource MenuBorderBrush}"/>
                                    <Button x:Name="FontsRowBtn" Click="FontsRow_Click"
                                            Style="{StaticResource MenuRowButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Str_Fonts_Row}" FontFamily="Consolas"
                                                       FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AssocRowBtn" Click="AssocRow_Click"
                                            Style="{StaticResource MenuRowButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Str_Assoc_Row}" FontFamily="Consolas"
                                                       FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                    <Grid x:Name="AccentStripHost" Grid.Column="1" Width="0" ClipToBounds="True">
                                        <Border Width="1" HorizontalAlignment="Left" Margin="0,6"
                                                Background="{DynamicResource MenuBorderBrush}"/>
                                        <Grid x:Name="AccentStrip" Margin="7,6,2,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="AccentStripDot0" Grid.Row="0" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                            <Border x:Name="AccentStripDot1" Grid.Row="1" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                            <Border x:Name="AccentStripDot2" Grid.Row="2" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                            <Border x:Name="AccentStripDot3" Grid.Row="3" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                            <Border x:Name="AccentStripDot4" Grid.Row="4" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                            <Border x:Name="AccentStripDot5" Grid.Row="5" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0" MouseLeftButtonUp="AccentStripDot_Click"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- COLUMN 5 - SEARCH CONFIG, out on the right edge (textured, flows into the bars
                 above / footer below). Collapsed by default and toggled from the rail. -->
            <Grid Grid.Column="5" x:Name="SearchPanel" Visibility="Collapsed">
              <DockPanel Background="Transparent" LastChildFill="True">
                <Border DockPanel.Dock="Bottom" Padding="12,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="SearchButton" Content="{DynamicResource Str_Btn_Search}" Style="{StaticResource OutlineButton}" Height="32" FontSize="13" Click="Search_Click"/>
                            <!-- New search: opens a fresh tab -->
                            <!-- Background Transparent, overriding SurfaceButton's ChipFaceBrush
                                 face. These three buttons are one group, and SEARCH beside them
                                 is an OutlineButton with no fill - so a filled + and CLEAR put a
                                 slab of pane color behind their labels while the button they sit
                                 with had none. This panel is not on a pane either: the search
                                 column shows the window's own background, which is a gradient on
                                 five themes, so the flat fill read as a gray block on it.
                                 Set locally, NOT on the SurfaceButton style - that style is the
                                 app's secondary button everywhere (tool tab toolbars, dialog
                                 footers, the details strip) and those all DO sit on a pane, where
                                 the face is doing its job.
                                 Hover and press still fill: the template's triggers set the
                                 Border's own Background, which beats this. -->
                            <Button Grid.Column="1" Content="+" Width="32" Height="32" Margin="6,0,0,0" Padding="0"
                                    FontFamily="Consolas" FontSize="15" Style="{StaticResource SurfaceButton}"
                                    Background="Transparent"
                                    ToolTip="{DynamicResource Str_TT_NewTab}" Click="NewTab_Click"/>
                        </Grid>
                        <Button Content="{DynamicResource Str_Btn_Clear}" Style="{StaticResource SurfaceButton}"
                                Background="Transparent" Height="28" Margin="0,6,0,0" Click="Clear_Click"/>
                    </StackPanel>
                </Border>

                <!-- Terms over filters with a draggable divider between them, clamped so
                     neither section can be crushed against an edge. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="140"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="80" MaxHeight="430"/>
                    </Grid.RowDefinitions>

                <!-- Bottom-anchored so any slack in the row sits ABOVE the section: the
                     collapsed "advanced" line seats flat against the buttons below. -->
                <Border Grid.Row="2" Padding="12,8,12,2" VerticalAlignment="Bottom">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Lbl_Filters}" Style="{StaticResource SectionHeader}"/>

                        <!-- Filter rows: [field v] on top, [condition toggle][value] below. AND-ed with
                             the terms. The condition is a toggle button with SHORT localized words
                             (is/not, before/after, over/under) so nothing ever truncates. -->
                            <ItemsControl x:Name="FiltersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SearchFilter}">
                                        <!-- Shadow on a SEPARATE sibling border, per the rule Controls.xaml states
                                             twice: an Effect on the border the text lives in rasterizes the whole
                                             subtree and the text loses ClearType. This card carried ShadowBar on
                                             its own content border until 2026-08-10. -->
                                        <Grid Margin="0,0,0,6">
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Effect="{StaticResource ShadowBar}"/>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="6">
                                            <Grid>
                                            <Border IsHitTestVisible="False" CornerRadius="4" Margin="-6"
                                                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" SelectedIndex="{Binding FieldIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="{DynamicResource Str_Filter_Ext}"/>
                                                        <ComboBoxItem Content="{DynamicResource Str_Filter_Date}"/>
                                                        <ComboBoxItem Content="{DynamicResource Str_Filter_Size}"/>
                                                    </ComboBox>
                                                    <Button Grid.Column="2" Content="x" Style="{StaticResource DangerButton}" Width="22" Height="22" Padding="0"
                                                            Tag="{Binding}" Click="RemoveFilter_Click"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource ModeButton}" Width="74" Height="26"
                                                            Tag="{Binding}" Click="ToggleFilterCondition_Click">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding FieldIndex}" Value="0"/>
                                                                                <Condition Binding="{Binding ConditionIndex}" Value="0"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{DynamicResource Str_Cond_Is}"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding FieldIndex}" Value="0"/>
                                                                                <Condition Binding="{Binding ConditionIndex}" Value="1"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{DynamicResource Str_Cond_IsNot}"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding FieldIndex}" Value="1"/>
                                                                                <Condition Binding="{Binding ConditionIndex}" Value="0"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{DynamicResource Str_Cond_Before}"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding FieldIndex}" Value="1"/>
                                                                                <Condition Binding="{Binding ConditionIndex}" Value="1"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{DynamicResource Str_Cond_After}"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding FieldIndex}" Value="2"/>
                                                                                <Condition Binding="{Binding ConditionIndex}" Value="0"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{DynamicResource Str_Cond_Larger}"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding FieldIndex}" Value="2"/>
                                                                                <Condition Binding="{Binding ConditionIndex}" Value="1"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{DynamicResource Str_Cond_Smaller}"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Grid Grid.Column="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.ColumnSpan="2" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding IsExt, Converter={StaticResource BoolToVis}}"/>
                                                        <DatePicker Grid.ColumnSpan="2" SelectedDate="{Binding Date, Mode=TwoWay}"
                                                                    Visibility="{Binding IsDate, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBox Grid.Column="0" Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding IsSize, Converter={StaticResource BoolToVis}}"/>
                                                        <ComboBox Grid.Column="1" Width="56" Margin="4,0,0,0" SelectedIndex="{Binding UnitIndex, Mode=TwoWay}"
                                                                  Visibility="{Binding IsSize, Converter={StaticResource BoolToVis}}">
                                                            <ComboBoxItem Content="KB"/>
                                                            <ComboBoxItem Content="MB"/>
                                                        </ComboBox>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        <!-- Transparent face, like every other button in this panel. -->
                        <Button HorizontalAlignment="Left" Content="{DynamicResource Str_Btn_AddFilter}" Style="{StaticResource SurfaceButton}"
                                Background="Transparent"
                                Padding="8,3" FontSize="10" Margin="0,2,0,0" Click="AddFilter_Click"/>

                        <!-- "advanced" accordion: include/exclude/case collapse out of the way -->
                        <Border Margin="0,10,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,2">
                          <StackPanel>
                            <Border Background="Transparent" Cursor="Hand" MouseLeftButtonUp="AdvancedToggle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AdvancedChevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{DynamicResource DimTextBrush}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                    <TextBlock Text="{DynamicResource Str_Lbl_Advanced}" Foreground="{DynamicResource DimTextBrush}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                        <Grid Margin="0,9,0,3">
                            <TextBlock Text="{DynamicResource Str_Lbl_Include}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" VerticalAlignment="Center"/>
                            <!-- Pattern cheat-sheet card, like KillerPDF's keyboard shortcuts overlay -->
                            <Button HorizontalAlignment="Right" Width="16" Height="16" Padding="0" Cursor="Hand"
                                    ToolTip="{DynamicResource Str_TT_PatternHelp}" Click="PatternHelp_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="hb" Background="Transparent" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock x:Name="ht" Text="?" Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hb" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="ht" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <TextBox x:Name="IncludePatternsBox" Text="*.*" ToolTip="{DynamicResource Str_TT_Include}"/>
                        <TextBlock Text="{DynamicResource Str_Lbl_Exclude}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Margin="0,7,0,3"/>
                        <TextBox x:Name="ExcludePatternsBox" Text="" ToolTip="{DynamicResource Str_TT_Exclude}"/>
                        <CheckBox x:Name="CaseSensitiveCheck" Content="{DynamicResource Str_Chk_CaseSensitive}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0"/>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Draggable divider between terms and filters -->
                <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                              Cursor="SizeNS" ShowsPreview="False" Focusable="False">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent">
                                <Border x:Name="line" Height="1" VerticalAlignment="Center"
                                        Background="{DynamicResource CardBorderBrush}" Margin="12,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="line" Property="Background" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="line" Property="Background" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Border Grid.Row="0" Padding="12,8,12,10">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_Lbl_SearchTerms}" Style="{StaticResource SectionHeader}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TermsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TermGroup}">
                                        <!-- Shadow on a SEPARATE sibling border - same fix and same reason as the
                                             filter card below (Controls.xaml's own rule; effects rasterize text). -->
                                        <Grid Margin="0,0,0,8">
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Effect="{StaticResource ShadowBar}"/>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="6">
                                            <Grid>
                                            <Border IsHitTestVisible="False" CornerRadius="4" Margin="-6"
                                                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                                            <StackPanel>
                                                <!-- Group header: ANY/ALL combiner toggle + remove-group -->
                                                <Grid Margin="0,0,0,5">
                                                    <Button HorizontalAlignment="Left" Content="{Binding ModeLabel, Mode=OneWay}" Style="{StaticResource ModeButton}"
                                                            Width="44" Height="20" FontSize="10" ToolTip="{Binding ModeTooltip}" Tag="{Binding}" Click="ToggleGroupMode_Click"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Terms}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:SearchTerm}">
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="5"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" Content="{Binding ModeName, Mode=OneWay}" Style="{StaticResource ModeButton}"
                                                                        ToolTip="{Binding ModeTooltip}" Tag="{Binding}" Click="ToggleMode_Click"/>
                                                                <TextBox Grid.Column="2" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ModeTooltip}"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding MatchBadge}" Foreground="{DynamicResource PrimaryBrush}"
                                                                           FontFamily="{DynamicResource MonoFont}" FontSize="10" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="6" Content="x" Style="{StaticResource DangerButton}" Width="22" Height="22" Padding="0"
                                                                        Tag="{Binding}" Click="RemoveTerm_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Transparent face, like every other button in
                                                     this panel - see the note on the search
                                                     buttons below. -->
                                                <Button HorizontalAlignment="Left" Content="{DynamicResource Str_Btn_AddTerm}" Style="{StaticResource SurfaceButton}"
                                                        Background="Transparent"
                                                        Padding="8,3" FontSize="10" Margin="0,2,0,0" Tag="{Binding}" Click="AddTerm_Click"/>
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>
              </DockPanel>
            </Grid>
            <!-- end COLUMN 5 search panel -->

            <!-- COLUMN 3 - THE PANES. One tab = one whole search or one folder. Tab visuals
                 mirror KillerPDF: active tab takes the pane background with a 3px accent
                 stripe on top and a soft shadow.
                 PaneHost carries BOTH panes on one 3x3 grid rather than one grid per
                 orientation. Side-by-side uses the columns and collapses the rows; stacked
                 uses the rows and collapses the columns; DualPane.cs moves RightPane and the
                 splitter between the two slots. One host means the panes are never rebuilt
                 when the orientation flips, so neither one loses its tabs or its scroll
                 position. Second pane is Collapsed until asked for, and its column/row is 0
                 wide, so a single-pane window lays out exactly as it did before. -->
            <!-- ContentPaneMargin: 0 everywhere, 0,5,0,0 on 98SE, which drops the content clear of
                 the menu bar's raised bottom edge instead of butting straight against it. -->
            <Grid Grid.Column="3" x:Name="PaneHost" Margin="{DynamicResource ContentPaneMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneColA" Width="*" MinWidth="300"/>
                    <ColumnDefinition x:Name="PaneColSplit" Width="0"/>
                    <ColumnDefinition x:Name="PaneColB" Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PaneRowA" Height="*" MinHeight="120"/>
                    <RowDefinition x:Name="PaneRowSplit" Height="0"/>
                    <RowDefinition x:Name="PaneRowB" Height="0" MinHeight="0"/>
                </Grid.RowDefinitions>

                <local:FilePane x:Name="LeftPane" Grid.Column="0" Grid.Row="0"
                                LayoutUpdated="PaneLayout_LayoutUpdated"/>

                <!-- Both splitters exist; DualPane.cs shows whichever the orientation needs.
                     PaneSplitV's ResizeBehavior is set in code (DualPane.cs PaneSplitV_DragStarted)
                     rather than fixed here: floating windows use PreviousOnly so the drag only ever
                     touches pane A (pane B's own width never changes - the window grows/shrinks
                     instead), maximized/snapped windows fall back to the PreviousAndNext trade
                     below because there is no room left to grow. -->
                <!-- FocusVisualStyle nulled on both: a GridSplitter is focusable and KEEPS focus
                     after a drag, and WPF's stock focus visual is a dotted rectangle - which is
                     the full-height dashed line that sat between the panes after any resize
                     (dual pane). Same fix the tab strip's ScrollViewer has. -->
                <GridSplitter x:Name="PaneSplitV" Grid.Column="1" Grid.Row="0" Width="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE" Visibility="Collapsed"
                              FocusVisualStyle="{x:Null}"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              DragStarted="PaneSplitV_DragStarted" DragDelta="PaneSplitV_DragDelta"/>
                <GridSplitter x:Name="PaneSplitH" Grid.Row="1" Grid.Column="0" Height="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeNS" Visibility="Collapsed"
                              FocusVisualStyle="{x:Null}"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

                <local:FilePane x:Name="RightPane" Grid.Column="2" Grid.Row="0"
                                Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- ══════════ ROW 2 - FOOTER (blends with the sidebar/panes, no divider line) ══════════ -->
        <!-- The footer's own bevel. Zero-thickness on every ordinary theme; on 98SE it is the
             SUNKEN status strip - dark along the top edge, light along the bottom.

             The two Thickness tokens are named for POSITION, not for the brush that goes in them:
             *LightThickness is "1,1,0,0" (top + left) and *DarkThickness is "0,0,1,1" (bottom +
             right). So a sunken control CROSSES them - Dark brush in the Light slot - and only a
             RAISED control pairs them up by name. Pairing by name here is what made the footer
             stand proud four times running; the version cell below was already
             crossed, which is why one half of the footer looked right and the other did not. -->
        <!-- FooterPadding is a MARGIN, not a Padding: 98SE's value is 0,0,-2,0 and WPF throws
             outright on a negative Padding ("'0,0,-2,0' is not a valid value for property
             'Padding'"). The negative pulls the strip out past the frame's
             inner bevel, which only a margin can do. -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}"
                Margin="{DynamicResource FooterPadding}">
          <Grid x:Name="FooterLayout">
          <!-- NO strip-wide bevel here. There was one, and crossing its brushes to make it sunken
               only turned one wrong footer into a different wrong footer.
               A Win98 status bar is not a beveled strip with things on it - it is a row of sunken
               CELLS sitting on the plain window face, and what looks like a divider between them
               is simply the gap. Beveling the whole strip AND the version block put a box inside
               a box, which is what read as "weird". KillerNotes is the reference (its footer is
               the family's, ported from KillerScan) and it has no strip bevel at all: just the
               cells. The status line gets its own cell below, the way it does there. -->
          <!-- Two columns: the status area takes what is left, the version block sizes to its
               content on the right. The portable badge is deliberately NOT a column - it stays
               a CENTERED overlay spanning both, which is where it has always sat. Giving it its
               own column pinned it against the version text instead.
               Because it overlays, column 0 runs underneath it and cannot bound the status line
               on its own - ElideFooterStatus (MainWindow.xaml.cs) clamps the line at the badge's
               left edge while the badge is showing, and drops the clamp once the app is
               installed and the badge is gone, so the line then runs on toward the version text.
               The short per-TAB facts (scanned / matches / query) are NOT here - they live in
               each pane's own status bar (FilePane.xaml). This bar carries the one item that
               needs real width. -->
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
            <!-- 10.5 left, not the 16 the rest of the family uses: the status dot is the first
                 thing in this row and it should sit on the same vertical line as the icon rail
                 above it (RailCol, 24 wide, so its icons center at 12). The dot is 3 wide, so
                 the row starts at 12 - 1.5. Everything after it moves with it, which is the
                 "tiny bit left" this is for. -->
            <!-- The status line's own SUNKEN CELL, matching the version cell on the right. This
                 is the half KillerShell was missing: it had the version block in a cell and the
                 status line loose on the strip, then a bevel round the whole strip to make up for
                 it. KillerNotes puts BOTH in cells and bevels nothing else, and the visible gap
                 between the two is the divider.
                 Crossed, like every sunken thing: DARK brush on the *LightThickness (top-left).
                 FooterCellMargin is 0 and both brushes transparent on the twelve rounded themes,
                 so this wrapper is inert there and the inner Grid keeps its exact old geometry. -->
            <Grid Grid.Column="0" Margin="{DynamicResource FooterCellMargin}">
              <Border IsHitTestVisible="False" Panel.ZIndex="2"
                      BorderBrush="{DynamicResource FooterBevelDarkBrush}"  BorderThickness="{DynamicResource FooterCellLightThickness}"/>
              <Border IsHitTestVisible="False" Panel.ZIndex="2"
                      BorderBrush="{DynamicResource FooterBevelLightBrush}" BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
            <!-- FooterCellPadding - the SAME key KillerNotes' status cell uses, because KillerNotes
                 is the family reference and its footer is the one that looks
                 right. KillerShell was the odd one
                 out, carrying a hardcoded 10.5,0,12,0 here while its version cell beside it
                 already used the token - which is why this cell alone never matched.
                 Do NOT invent a separate key for this. One was tried (FooterStatusPadding) on the
                 theory that reusing FooterCellPadding would move the other twelve themes; the
                 twelve default it to the same value, and KillerNotes has shipped this exact
                 binding on both cells all along. -->
            <Grid VerticalAlignment="Center" Margin="{DynamicResource FooterCellPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- App-wide zoom level (AppScale.cs). Leftmost in the status area at the same
                     16px inset, ChromeTextBrush, mono 11.5 - the exact slot and treatment
                     KillerScan gives its footer StatusText (MainWindow.xaml row 3). Hidden at
                     100%; a collapsed element takes no width or margin. -->
                <!-- Column 2, the SAME slot as StatusText: while the readout shows, AppScale.cs
                     collapses the status line so this takes its place - it replaces the Ready
                     text, while the green traffic dot stays put in the corner at all times. -->
                <TextBlock x:Name="AppScaleLabel" Grid.Column="2" Visibility="Collapsed" Foreground="{DynamicResource ChromeTextBrush}"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11.5" VerticalAlignment="Center"
                           ToolTip="{DynamicResource Str_TT_AppSize}"/>
                <!-- Traffic light: OkBrush / WarnBrush / DangerRed, set by ApplyStatusTone. The
                     resting state is green, not the accent - see MainWindow.xaml.cs. -->
                <!-- Height pinned. With none it defaults to Stretch and grew to the full cell
                     interior, which pinned the row's minimum height and stopped the cell ever
                     shrinking to fit its own text. -->
                <Border x:Name="StatusDot" Grid.Column="1" Width="3" Height="12" Background="{DynamicResource OkBrush}" Margin="0,3,7,3" CornerRadius="2"/>
                <!-- The running commentary: "Ready", "Opening C:\...", "164 item(s)", "Cannot
                     open X". No MaxWidth - the * column IS the bound, so the line uses whatever
                     the window gives it: it stops at the portable badge while that is showing,
                     and once the app is installed the badge collapses to zero width and the
                     line simply runs on toward the version text.
                     NO TextTrimming: that ellipsizes the TAIL, which on a path throws away the
                     file name - the only part worth reading. ElideFooterStatus
                     (MainWindow.xaml.cs) trims from the FRONT instead, and SizeChanged
                     re-runs it so a window resize re-cuts the path.
                     11.5 status / 10 corner type is the family footer standard. -->
                <TextBlock x:Name="StatusText" Grid.Column="2" Text="{DynamicResource Str_Status_Ready}" Foreground="{DynamicResource TextFooter}"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11.5" VerticalAlignment="Center"
                           SizeChanged="StatusText_SizeChanged"/>
            </Grid>
            </Grid>
            <!-- Compact portable install action (hidden when installed), matching KillerPDF.
                 In side-by-side dual-pane mode its center follows the pane divider; otherwise it
                 follows the center of the content pane, accounting for the sidebar. It stays an
                 overlay rather than a column so the version block keeps its natural width.
                 IsVisibleChanged re-runs the status elision, because the line's usable width
                 changes the moment this appears or goes away. -->
            <StackPanel x:Name="PortableBadge" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        IsVisibleChanged="PortableBadge_IsVisibleChanged">
                <Button x:Name="InstallBtn" Content="{DynamicResource Str_Btn_Install}" Click="Install_Click"
                        Style="{StaticResource OutlineButton}" FontFamily="{DynamicResource ChromeFontFamily}"
                        FontSize="10" Padding="8,1" VerticalAlignment="Center">
                    <Button.Resources>
                        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                    </Button.Resources>
                </Button>
            </StackPanel>
            <!-- On 98SE a status bar is a row of sunken CELLS rather than plain text on a strip,
                 so the version block gets a margin and padding of its own there. Both are 0
                 elsewhere, leaving the existing 0,0,16,0 to position it as before. -->
            <!-- STRETCH, not Center. This is the recurring copyright/version cell
                 bug (2026-08-09): a vertically CENTERED StackPanel collapses to its content's
                 height, so the sunken cell Grid inside it was only as tall as the text and could
                 never match the status cell beside it, which sits directly in its column and
                 stretches. No amount of tuning FooterCellMargin, FooterCellPadding or the row
                 height could fix that - the cell was not short because of its own numbers, it was
                 short because its PARENT refused to give it the row's height. The inner content
                 keeps its own VerticalAlignment="Center" below, so the text still centers. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,0,16,0">
                <!-- A Win98 status cell is SUNKEN: dark along the top and left, light along the
                     bottom and right. Only the dark half was here, which drew half a box round
                     the version text. Both are zero-thickness elsewhere. -->
                <!-- SUNKEN, so the brushes are crossed against the thicknesses: the DARK brush
                     takes the top-left thickness and the LIGHT brush the bottom-right. Wired the
                     obvious way round it comes out RAISED, which is what the footer was
                     doing. A status cell is a recess, not a button. -->
                <Grid Margin="{DynamicResource FooterCellMargin}">
                    <Border BorderBrush="{DynamicResource FooterBevelDarkBrush}"  BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border BorderBrush="{DynamicResource FooterBevelLightBrush}" BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{DynamicResource FooterCellPadding}">
                <TextBlock x:Name="VersionLabel" Text="v0.99" Foreground="{DynamicResource TextFooter}" FontFamily="{DynamicResource MonoFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"
                           Cursor="Hand" ToolTip="About" MouseLeftButtonUp="VersionLabel_Click"/>
                <!-- 14px trailing margin keeps the copyright clear of the corner grip (family standard) -->
                <TextBlock FontSize="10" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}" Margin="0,0,14,0">
                    <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextFooter}"/>
                    <Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource TextFooter}" TextDecorations="None">
                        <Run Text="Steve the Killer"/>
                    </Hyperlink>
                </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <!-- Bottom-right resize grip: dotted triangle at the content corner, forwards a
                 HTBOTTOMRIGHT resize to Windows on drag (same as KillerPDF/KillerScan). -->
            <Canvas x:Name="ResizeGripDots" Grid.ColumnSpan="2" Width="13" Height="13"
                    Visibility="{DynamicResource GripDotsVisibility}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                    Background="Transparent" Cursor="SizeNWSE"
                    MouseLeftButtonDown="ResizeGrip_MouseDown">
                <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            </Canvas>
            <!-- The 98SE grip: three beveled DIAGONAL lines, bottom-left to top-right, each a
                 white highlight with a gray shadow one pixel down-right of it - the standard Win98
                 sizing gripper. Collapsed on every other theme, which keeps
                 the dots above.

                 Lines rather than a 3x3 of squares: at 13px the diagonals have to be true
                 hairlines to read, and SnapsToDevicePixels keeps them from smearing across two
                 rows. Drawn shadow-first so the white sits on top where they touch, which is the
                 order that makes the ridge read as raised. -->
            <Canvas x:Name="ResizeGripLines" Grid.ColumnSpan="2" Width="13" Height="13"
                    Visibility="{DynamicResource GripLinesVisibility}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                    Background="Transparent" Cursor="SizeNWSE"
                    SnapsToDevicePixels="True"
                    MouseLeftButtonDown="ResizeGrip_MouseDown">
                <Line X1="12" Y1="1"  X2="1"  Y2="12" Stroke="{DynamicResource FrameOuterDarkBrush}"  StrokeThickness="1"/>
                <Line X1="11" Y1="1"  X2="1"  Y2="11" Stroke="{DynamicResource FrameOuterLightBrush}" StrokeThickness="1"/>
                <Line X1="12" Y1="5"  X2="5"  Y2="12" Stroke="{DynamicResource FrameOuterDarkBrush}"  StrokeThickness="1"/>
                <Line X1="11" Y1="5"  X2="5"  Y2="11" Stroke="{DynamicResource FrameOuterLightBrush}" StrokeThickness="1"/>
                <Line X1="12" Y1="9"  X2="9"  Y2="12" Stroke="{DynamicResource FrameOuterDarkBrush}"  StrokeThickness="1"/>
                <Line X1="11" Y1="9"  X2="9"  Y2="11" Stroke="{DynamicResource FrameOuterLightBrush}" StrokeThickness="1"/>
            </Canvas>
          </Grid>
          </Grid>
        </Border>

        <!-- ══════════ ABOUT OVERLAY (dim backdrop + centered card) ══════════ -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="AboutOverlay_Click">
            <!-- Card structure copied from KillerScan (the rules for every About card):
                 the SHA-256 line is the ONLY thing that sets the width - it never wraps, so the
                 info panel sizes to it and the card sizes to the info panel. The header grid
                 below pins its width to that panel so a long tagline wraps instead of widening
                 the card. The drop shadow lives on a SEPARATE border so the card text never
                 renders through a bitmap effect (stays ClearType-crisp), and the whole surface
                 is grain-wrapped. -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="AboutCard_Click">
                <Border Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270"
                                                     Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                </Border>
                <!-- AppBorderBrush, not CardBorderBrush: the card is a floating SURFACE, so its
                     edge is the app's own frame color - the same line that rings the window -
                     rather than the flatter card edge used for panels sitting inside one. On
                     several palettes the two differ sharply (Ectoplasm's frame is the pink), and
                     the card was reading as unrelated to the app around it (2026-08-09). -->
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="{DynamicResource OverlayCardBorderThickness}" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                        <!-- Raised card bevel. Nothing on any theme but 98SE. -->
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterDarkBrush}"  BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                        <!-- The inner half of the raised 98SE window frame. The outer pair alone
                             leaves only a hairline; together these make the classic two-stage
                             light top/left and dark bottom/right bevel. All four thicknesses are
                             zero on the ordinary themes. -->
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                Margin="{DynamicResource FrameInnerMargin}"
                                BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                Margin="{DynamicResource FrameInnerMargin}"
                                BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>

                        <!-- Close X: ChromeCloseButton, the SAME style as the title bar's close, so
                             every X in the app is the same X (the KillerNotes
                             rule). On 98SE that makes it a real beveled caption button
                             that sinks on press; elsewhere it is the bare glyph with the red
                             hover fill the main window has. Size and margin come from the
                             AboutClose* tokens (ThemeManager): a small Win98 button inside the
                             caption band on a flat theme, the old 28x26 corner slot otherwise. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="AboutClose_Click" Style="{StaticResource OverlayCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Margin="{DynamicResource AboutCloseMargin}"/>

                        <!-- A caption BAND above the card's content. 0 high on every theme that
                             does not ask for one, so their cards keep the exact layout they had;
                             a flat theme gets the same band height as its dialogs, and the
                             content drops below it. AboutCaptionMargin insets the band from the
                             card's overdrawn 2px bevel on 98SE (see the key's comment in the
                             theme); 0 everywhere else. The title is the same family, size, weight
                             and brush as the main window's plain caption ("About KillerShell",
                             matching KillerNotes' card). -->
                        <Border VerticalAlignment="Top" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource DialogTitleBarBrush}">
                            <TextBlock Text="{DynamicResource Str_About_Title}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>
                        <!-- AboutContentMargin, no longer AboutCaptionMargin: same 0 default, but
                             98SE states extra TOP inset so the wordmark gets breathing room under
                             the caption band. -->
                        <StackPanel Margin="{DynamicResource AboutContentMargin}">
                        <StackPanel Margin="18,10,18,18">
                            <!-- Header: icon left, wordmark (links to the site) + tagline right.
                                 Width is pinned to the info panel below so the tagline wraps
                                 instead of widening the card - the SHA-256 line stays the driver. -->
                            <Grid Margin="0,4,0,14" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="AboutIcon" Grid.Column="0" Width="58" Height="58" Margin="0,0,15,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Direction="270"
                                                                    Opacity="{DynamicResource IconShadowOpacity}"/></Image.Effect>
                                </Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left" Cursor="Hand" ToolTip="killershell.net"
                                          Background="Transparent" MouseLeftButtonUp="Wordmark_Click">
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource IconShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="2"/></TextBlock.Effect><Run Text="Killer" FontSize="22" Foreground="#C0000000"/><Run Text="Shell" FontSize="28.6" FontWeight="Bold" Foreground="#C0000000"/></TextBlock>
                                        <!-- The 98SE emboss: a hard WHITE copy 1px UP-LEFT, no
                                             blur - light catching the top-left edges of a RAISED
                                             glyph. Down-right was tried first and read as sunken
                                             instead of raised. AboutEmbossOpacity is 0
                                             everywhere but 98SE. -->
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource AboutEmbossOpacity}"><TextBlock.RenderTransform><TranslateTransform X="-1" Y="-1"/></TextBlock.RenderTransform><Run Text="Killer" FontSize="22" Foreground="#FFFFFF"/><Run Text="Shell" FontSize="28.6" FontWeight="Bold" Foreground="#FFFFFF"/></TextBlock>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}"><Run Text="Killer" FontSize="22" Foreground="{DynamicResource TextBrush}"/><Run Text="Shell" FontSize="28.6" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                                    </Grid>
                                    <!-- Tagline is composed here, not in the .xaml string files: GPLv3 and
                                         "Killer Tools" are proper nouns and stay out of the translations
                                         (same split KillerScan and KillerNotes use). -->
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Str_About_DescA}"/><Run Text="GPLv3 "/><Hyperlink NavigateUri="https://killertools.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Killer Tools</Hyperlink><Run Text="{DynamicResource Str_About_DescB}"/></TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Info panel - matte, lifted above the grainy card. The shadow lives on
                                 its own border so the field text never renders through a bitmap effect
                                 (stays ClearType-crisp). Field spacing and sizes match KillerScan. -->
                            <Grid x:Name="AboutInfoGrid">
                                <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270"
                                                                     Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                                </Border>
                                <!-- Grain on the info panel too. The card behind it is grainy, but
                                     this panel painted an OPAQUE fill straight over that texture,
                                     so the one surface carrying the card's actual content was the
                                     only flat thing on it (2026-08-09). Its own layer, between the
                                     fill and the fields: text renders ABOVE it and stays crisp,
                                     which is the same order the card itself uses. 98SE needs no
                                     special case - its GrainOpacity is 0, so this draws nothing
                                     there. -->
                                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                                <!-- Transparent, so the fill and the grain below both show: the
                                     opaque fill lives on the shadow border above. -->
                                <Border Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="14,12,14,4"
                                        BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <!-- One row, two ends: the version in the accent on the left, the
                                                 release date muted and italic hard right against the panel edge.
                                                 Bottom-aligned rather than centered so the two sizes sit on a
                                                 shared baseline. Only the version text is clickable. -->
                                            <Grid Margin="0,1,0,0">
                                                <TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}"
                                                           FontFamily="Consolas" FontSize="13" Cursor="Hand"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                           MouseLeftButtonUp="AboutVersion_Click"/>
                                                <TextBlock x:Name="AboutReleaseDateBlock" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontFamily="Consolas" FontSize="11" FontStyle="Italic"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutPublisherBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,1,0,0"/>
                                            <!-- Shown only on a signed exe, where the certificate subject is the
                                                 legal name - this ties it back to the name people know. The alias
                                                 itself is an accent link to thekiller.net; "AKA" stays muted so
                                                 the eye lands on the name (same plain-text + accent-link split as
                                                 the tagline above). -->
                                            <TextBlock x:Name="AboutAkaBlock" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,3,0,0"><Run Text="AKA "/><Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None" ToolTip="thekiller.net"><Run x:Name="AboutAkaRun"/></Hyperlink></TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutThumbprintBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Sha}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutSha256Block" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- This used to be a bespoke Button+ControlTemplate that tried to hand its
                                 own Foreground down through TextElement.Foreground inheritance/a
                                 DataTrigger, and kept rendering with illegible text (2026-08-03,
                                 the recurring black-on-accent bug). The shared
                                 OutlineButton style (Controls/Controls.xaml) already solves exactly
                                 this - outline at rest, fills with the accent on hover, and a
                                 TextStroke effect on the ContentPresenter so the label stays legible
                                 either way - and is what every other outline button in the family
                                 already uses (ConfirmDialog's OK button, etc). Using it here instead of
                                 reinventing it is the actual fix. -->
                            <Button x:Name="AboutUpdateButton" Style="{StaticResource OutlineButton}"
                                    Visibility="Collapsed" Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Click="AboutUpdateButton_Click">
                                <TextBlock x:Name="AboutUpdateText" FontSize="12"/>
                            </Button>

                            <!-- Settings footer. KillerPDF's About card carries the same kind of
                                 row (its recent-files toggle and Clear all Data), so this is the
                                 family precedent rather than a new idea. It does not break the
                                 locked About standard: the rule there is no COPYRIGHT footer,
                                 because GPLv3 is already in the tagline.
                                 It is here because About is already the app's "what is this thing
                                 actually doing" screen - the signature, the thumbprint and the exe
                                 hash live on it - and because the delete prompt's don't-ask-again
                                 box needs somewhere to be undone from.
                                 Sized and spaced off KillerPDF's equivalent row: 12px above it and
                                 no rule, no padding. It carried a hairline and 26px of vertical
                                 space at first, which made one checkbox read as a whole section.
                                 NO FontSize HERE. The implicit CheckBox style is Consolas 11
                                 (Controls.xaml) and every other checkbox in the app takes it; the
                                 12 that was set on this TextBlock made this the largest one in the
                                 app and the only one off the app's own scale.
                                 WIDTH IS PINNED to AboutInfoGrid, exactly like the header above:
                                 the SHA-256 line is the only thing allowed to set the card width,
                                 so the label wraps inside this instead of widening the card. A
                                 bare Content string, which is what KillerPDF uses, cannot wrap and
                                 would be clipped by that pin once a locale runs long. -->
                            <Border Margin="0,12,0,0"
                                    Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <!-- Toggle left, the destructive link hard right, the way
                                     KillerPDF's footer is laid out. LastChildFill off so the
                                     checkbox keeps its own width and the link stays pinned to the
                                     edge rather than being centered in whatever is left. -->
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" FontSize="10"
                                               VerticalAlignment="Center">
                                        <Hyperlink TextDecorations="None" Cursor="Hand" Click="AboutClearData_Click">
                                            <Hyperlink.Style>
                                                <Style TargetType="Hyperlink">
                                                    <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Hyperlink.Style>
                                            <Run Text="{DynamicResource Str_About_ClearData}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <CheckBox x:Name="AboutConfirmFolderDelete" DockPanel.Dock="Left"
                                              Checked="AboutConfirmFolderDelete_Changed"
                                              Unchecked="AboutConfirmFolderDelete_Changed">
                                        <TextBlock Text="{DynamicResource Str_About_ConfirmFolderDelete}"
                                                   TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════ FONTS OVERLAY (dim backdrop + centered card) ══════════ -->
        <!-- One slot per surface that has its own face. Deliberately a dialog and not part of
             the theme flyout: a system font list runs to hundreds of entries, and a flyout is
             for things you pick at a glance. Built to take more rows without restructuring. -->
        <Grid x:Name="FontsOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="FontsOverlay_Click">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource WindowCornerRadius}" MouseLeftButtonDown="FontsCard_Click">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Direction="270"
                                                 Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                <Grid>
                <Border IsHitTestVisible="False" CornerRadius="7" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <StackPanel Margin="24,20">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Str_Fonts_Title}" Style="{StaticResource SectionHeader}"
                                   FontSize="13" Margin="0" VerticalAlignment="Center"/>
                        <Button Content="&#xE8BB;" Click="FontsClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="30" Height="26" FontSize="10" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource DangerButton}" BorderThickness="0"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Fonts_App}" Foreground="{DynamicResource DimTextBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FontAppCombo" Height="26" FontSize="12" Margin="0,0,0,14"
                              SelectionChanged="FontCombo_Changed" PreviewMouseWheel="FontCombo_Wheel"/>

                    <TextBlock Text="{DynamicResource Str_Fonts_Terminal}" Foreground="{DynamicResource DimTextBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FontTermCombo" Height="26" FontSize="12"
                              SelectionChanged="FontCombo_Changed" PreviewMouseWheel="FontCombo_Wheel"/>

                    <!-- Size belongs to the two surfaces that show a WALL of monospaced text and
                         nothing else: a shell and a document. The rest of the app grows through
                         the wordmark zoom (AppScale.cs) instead, because a file list wants to
                         stay in proportion with its chrome. Ctrl+wheel inside either still
                         nudges the same value from the keyboard. -->
                    <Grid Margin="0,10,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FontTermSize" Style="{StaticResource ThinSlider}"
                                Minimum="8" Maximum="28" SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="FontTermSize_Changed"/>
                        <TextBlock x:Name="FontTermSizeLabel" Grid.Column="1" Margin="10,0,0,0"
                                   MinWidth="26" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontFamily="Consolas" FontSize="11"/>
                    </Grid>

                    <!-- Editor text. Fixed-width only, filtered the same way the terminal list
                         is: a proportional face does not merely look wrong over code, it puts
                         every line number and every column of an indented block out of line. -->
                    <TextBlock Text="{DynamicResource Str_Fonts_Editor}" Foreground="{DynamicResource DimTextBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FontEditorCombo" Height="26" FontSize="12"
                              SelectionChanged="FontCombo_Changed" PreviewMouseWheel="FontCombo_Wheel"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FontEditorSize" Style="{StaticResource ThinSlider}"
                                Minimum="8" Maximum="28" SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="FontEditorSize_Changed"/>
                        <TextBlock x:Name="FontEditorSizeLabel" Grid.Column="1" Margin="10,0,0,0"
                                   MinWidth="26" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontFamily="Consolas" FontSize="11"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Fonts_Hint}" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ ASSOCIATIONS OVERLAY (register with the Windows shell) ══════════ -->
        <!-- Registration and DEFAULTING are two different things and the card has to keep them
             apart. This button writes the ProgID, the Open With hints and the folder verbs;
             only Windows can promote KillerShell to the default, and only when the user says so
             in Settings. See Associations.cs for why forging UserChoice is not on the table. -->
        <Grid x:Name="AssocOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="AssocOverlay_Click">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource WindowCornerRadius}" MouseLeftButtonDown="AssocCard_Click">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Direction="270"
                                                 Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                <Grid>
                <Border IsHitTestVisible="False" CornerRadius="7" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <StackPanel Margin="24,20">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Str_Assoc_Title}" Style="{StaticResource SectionHeader}"
                                   FontSize="13" Margin="0" VerticalAlignment="Center"/>
                        <Button Content="&#xE8BB;" Click="AssocClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="30" Height="26" FontSize="10" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource DangerButton}" BorderThickness="0"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Assoc_Intro}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Str_Assoc_What}" Foreground="{DynamicResource DimTextBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AssocExtList" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource Str_Assoc_Safe}" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <CheckBox x:Name="AssocAllUsers" Content="{DynamicResource Str_Assoc_AllUsers}"
                              FontSize="11.5" Margin="0,0,0,14"/>

                    <TextBlock x:Name="AssocStatus" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Button x:Name="AssocRegisterBtn" Click="AssocRegister_Click"
                            Style="{StaticResource OutlineButton}" Height="30" Margin="0,0,0,8"
                            Content="{DynamicResource Str_Assoc_Register}"/>
                    <Button x:Name="AssocRemoveBtn" Click="AssocRemove_Click"
                            Style="{StaticResource OutlineButton}" Height="30" Margin="0,0,0,8"
                            Content="{DynamicResource Str_Assoc_Remove}"/>
                    <Button x:Name="AssocSettingsBtn" Click="AssocSettings_Click"
                            Style="{StaticResource OutlineButton}" Height="30"
                            Content="{DynamicResource Str_Assoc_OpenSettings}"/>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ PATTERN HELP OVERLAY (dim backdrop + centered cheat-sheet card) ══════════ -->
        <Grid x:Name="PatternHelpOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="PatternHelpOverlay_Click">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource WindowCornerRadius}" MouseLeftButtonDown="PatternHelpCard_Click">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Direction="270"
                                                 Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                <Grid>
                <!-- One dark surface with grain across the whole card - no inner box. -->
                <Border IsHitTestVisible="False" CornerRadius="7" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <StackPanel Margin="24,20">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Str_Help_Title}" Style="{StaticResource SectionHeader}" FontSize="13" Margin="0" VerticalAlignment="Center"/>
                        <!-- Foreground lives in a Style setter so the hover/press triggers can win
                             (a local value would beat them - that's why hover never turned red). -->
                        <Button Content="&#xE8BB;" Click="PatternHelpClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="30" Height="26" FontSize="10" FontFamily="Segoe MDL2 Assets"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                        <Setter TargetName="bg" Property="Background" Value="#33C42B1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style x:Key="HelpPat" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Margin" Value="0,0,10,7"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                                <Style x:Key="HelpDesc" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="0,1,0,7"/>
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource HelpPat}" Text="*.log"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource HelpDesc}" Text="{DynamicResource Str_Help_Star}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource HelpPat}" Text="report*"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpDesc}" Text="{DynamicResource Str_Help_Prefix}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource HelpPat}" Text="*2024*"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpDesc}" Text="{DynamicResource Str_Help_Middle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource HelpPat}" Text="log?.txt"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource HelpDesc}" Text="{DynamicResource Str_Help_Q}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource HelpPat}" Text="*.txt;*.log"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource HelpDesc}" Text="{DynamicResource Str_Help_List}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource HelpPat}" Text="log"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource HelpDesc}" Text="{DynamicResource Str_Help_Plain}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource HelpPat}" Text="bin;obj"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource HelpDesc}" Text="{DynamicResource Str_Help_Exclude}"/>
                    </Grid>

                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ SHORTCUTS OVERLAY (F1) - family standard, same chrome as the card above ══════════ -->
        <Grid x:Name="ShortcutsOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="ShortcutsOverlay_Click">
            <!-- A large shortcuts surface is still bounded by the app window. MaxWidth is selected
                 per view in KeyboardMapOverlay.cs; Stretch plus this inset means a narrow window
                 shrinks the card instead of allowing a fixed 1000px board to escape its edge. -->
            <Border x:Name="ShortcutCard" Margin="32" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" MouseLeftButtonDown="ShortcutsCard_Click">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Direction="270"
                                                 Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                <Grid>
                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <!-- Raised card bevel, the same EDGE_RAISED pair the About card carries. Nothing
                     on any theme but 98SE, where the shortcuts card becomes a hard Win98 dialog
                     box instead of a flat sheet - the shortcuts window is themed like the
                     rest. -->
                <Border IsHitTestVisible="False" Panel.ZIndex="6"
                        BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                <Border IsHitTestVisible="False" Panel.ZIndex="6"
                        BorderBrush="{DynamicResource FrameOuterDarkBrush}"  BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                <!-- Caption band + shared close X, the About card's exact treatment: band and
                     title only exist on a flat theme (height 0 / transparent elsewhere), the X is
                     ChromeCloseButton everywhere so every X in the app is the same X. -->
                <Border VerticalAlignment="Top" ClipToBounds="True"
                        Height="{DynamicResource AboutCaptionHeight}"
                        Margin="{DynamicResource AboutCaptionMargin}"
                        Background="{DynamicResource DialogTitleBarBrush}">
                    <TextBlock Text="{DynamicResource Str_Help_Shortcuts}" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontFamily="{DynamicResource ChromeFontFamily}"
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"/>
                </Border>
                <Button Content="{DynamicResource AboutCloseGlyph}" Click="ShortcutsClose_Click" Style="{StaticResource OverlayCloseButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="7"
                        Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                        Margin="{DynamicResource AboutCloseMargin}"/>
                <Grid Margin="{DynamicResource ShortcutsContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <!-- Hidden on a flat theme - the caption band above carries the title
                             there, and this in-card copy would duplicate it. -->
                        <TextBlock Text="{DynamicResource Str_Help_Shortcuts}" Style="{StaticResource SectionHeader}" FontSize="13" Margin="0" VerticalAlignment="Center"
                                   Visibility="{DynamicResource WordmarkVisibility}"/>
                    </Grid>

                    <!-- LIST / KEYBOARD. Both views are generated from ONE table
                         (ShortcutsOverlay.cs KsAll), so a new binding shows up in both instead
                         of being hand-copied into the card. It really is one table now: the
                         board used to keep a second copy in KeyboardMapOverlay.cs and the two
                         had drifted apart. Each row carries a SCOPE as well as a category, so
                         the list groups by applet and the board can show a keycap's meaning on
                         the tab you are actually on. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <StackPanel.Resources>
                            <!-- Bare template: a text toggle, no panel chrome. The code-behind
                                 sets Foreground per selection, so nothing here may pin it. -->
                            <Style x:Key="KsViewToggle" TargetType="Button">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="KsViewListBtn" Content="{DynamicResource Str_Ks_ViewList}"
                                Style="{StaticResource KsViewToggle}" Click="KsViewList_Click"/>
                        <TextBlock Text="/" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas"
                                   FontSize="10.5" Margin="7,0" VerticalAlignment="Center"/>
                        <Button x:Name="KsViewKeyboardBtn" Content="{DynamicResource Str_Ks_ViewKeyboard}"
                                Style="{StaticResource KsViewToggle}" Click="KsViewKeyboard_Click"/>
                    </StackPanel>

                    <!-- The star row is the viewport. It takes whatever height remains inside the
                         window-bounded card, and this viewer owns every excess row.
                         Both hosts filled in code: BuildShortcutsList (ShortcutsOverlay.cs) and
                         BuildKeyboardView (KeyboardMapOverlay.cs), each once and lazily. -->
                    <ScrollViewer x:Name="ShortcutScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False">
                    <StackPanel>
                        <StackPanel x:Name="ShortcutListHost"/>
                        <StackPanel x:Name="ShortcutKeyboardHost" Visibility="Collapsed"/>
                    </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Text="{DynamicResource Str_Ks_Hint}" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Tab drag layer (PaneDrag.cs). Lives at the WINDOW level, not inside a pane,
             because a tab being dragged between panes is over neither of them for most of the
             journey - parented to a pane it would be clipped at that pane's edge.
             Hit-test transparent throughout, or the ghost would sit under the cursor and stop
             the drop from ever finding the pane beneath it. -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="3" Panel.ZIndex="90"
                IsHitTestVisible="False" Visibility="Collapsed">
            <!-- A half-real copy of the tab, carrying the same accent lip and glyph so it is
                 obviously THE tab rather than a generic drag box. -->
            <Border x:Name="TabDragGhost" Opacity="0.72" CornerRadius="6,6,0,0" Padding="12,2,10,5"
                    Background="{DynamicResource PaneBrush}"
                    BorderThickness="0,3,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3"
                                      Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TabDragGhostGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Margin="0,0,5,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="TabDragGhostText" FontFamily="Consolas" FontSize="11.5"
                               FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Where it would land. Only shown over the target strip, because anywhere else
                 in the pane means "append" and there is no gap to point at. -->
            <Border x:Name="TabDropCaret" Width="2" Visibility="Collapsed"
                    Background="{DynamicResource PrimaryBrush}"/>
        </Canvas>

        <!-- Elevation halo: an accent ring around the whole window when this process is
             running as administrator (Elevation.cs). Drawn as an overlay rather than as a
             border on RootGrid, because a Grid has no border to give it, and hit-test
             transparent so it cannot swallow a click on the chrome underneath.
             Two rings, not a blur: the outer solid one is the signal, the inner translucent
             one softens it into a glow. A DropShadowEffect would be clipped by the window
             edge anyway, and bitmap effects over this window would cost ClearType. -->
        <!-- CornerRadius 8 / 6: Windows 11 rounds every top-level window itself (this one asks
             WindowChrome for CornerRadius 0, so the rounding is the DWM's, not ours). A square
             ring inside a rounded window gets its corners sliced off by that rounding and the
             accent reads as four broken lines instead of one loop. On Windows 10, where the
             window really is square, a rounded ring costs a couple of pixels at each corner -
             the cheaper of the two errors, and the one nobody notices. -->
        <!-- The admin ring. Radius follows the window, so on 98SE it squares off with everything
             else instead of curving inside a hard rectangular frame - which read as a stray
             rounded outline round the admin window. -->
        <Border x:Name="ElevationHalo" Grid.RowSpan="3" Panel.ZIndex="100"
                CornerRadius="{DynamicResource WindowCornerRadius}"
                Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2">
            <Border x:Name="ElevationHaloInner" BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}" Opacity="0.35"/>
        </Border>

    </Grid>
        </Grid>
    </Border>
</Window>
