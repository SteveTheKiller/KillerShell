<!-- Rename prompt. ConfirmDialog's chrome with a text box instead of bullet lines.

     A separate small window rather than an in-place edit in the results row: the name is edited
     the same way from all three views and from the tree, and an inline editor would need a copy
     in each template plus its own focus and commit handling in each. -->
<Window x:Class="KillerShell.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KillerShell"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Border x:Name="RootBorder" Opacity="0"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" CornerRadius="6"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource IconShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="Killer" Foreground="#D8000000"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                        </Grid>
                        <Button Content="&#x2715;" Click="Cancel_Click" HorizontalAlignment="Right"
                                Width="28" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource MutedTextBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,16,24,12">
                    <TextBlock Text="{DynamicResource Str_Fo_RenameTitle}"
                               Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,0,0,10"/>
                    <TextBox x:Name="NameBox"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource PrimaryBrush}"
                             BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                             Padding="6,5" KeyDown="NameBox_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,18">
                    <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}" MinWidth="86" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource Str_Btn_Rename}" Click="OK_Click"
                            Style="{StaticResource PrimaryButton}" MinWidth="86"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
