<!-- Rename prompt. ConfirmDialog's chrome with a text box instead of bullet lines.

     A separate small window rather than an in-place edit in the results row: the name is edited
     the same way from all three views and from the tree, and an inline editor would need a copy
     in each template plus its own focus and commit handling in each. -->
<Window x:Class="KillerShell.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:picker="clr-namespace:KillerShell"
        xmlns:icons="clr-namespace:KillerShell.Controls"
        Title="KillerShell"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <picker:PickerBorder x:Name="RootBorder" Opacity="0"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="{DynamicResource DialogOuterBorderThickness}" CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </Border.Effect>
        <Grid>
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
<Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>
            <Grid Margin="{DynamicResource DialogContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{DynamicResource DialogTitleBarRowHeight}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                    <Grid>
                        <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}"
                                Opacity="{DynamicResource GrainOpacity}"/>
                    <Grid Margin="{DynamicResource DialogTitleBarPadding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- The app icon leads the caption, as it does in the main title bar. -->
                        <icons:AppIcon x:Name="TitleIcon" VerticalAlignment="Center"
                               Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                               Margin="{DynamicResource TitleIconMargin}"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Grid VerticalAlignment="Center" Margin="0,-18,0,-22">
                            <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Visibility="{DynamicResource DialogWordmarkVisibility}"
                                        Opacity="{DynamicResource WordmarkShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                       Visibility="{DynamicResource DialogWordmarkVisibility}" Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                       Visibility="{DynamicResource DialogWordmarkVisibility}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                        </Grid>
                            <!-- Outside the wordmark grid so the wordmark's lift and bleed never move it. -->
                            <TextBlock Text="KillerShell" FontFamily="{DynamicResource ChromeFontFamily}" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"
                                       Visibility="{DynamicResource DialogPlainTitleVisibility}"/>
                        </StackPanel>
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="Cancel_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Style="{StaticResource OverlayCloseButton}"/>
                    </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,16,24,12">
                    <TextBlock x:Name="PromptText" Text="{DynamicResource Str_Fo_RenameTitle}"
                               Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,0,0,10"/>
                    <TextBox x:Name="NameBox"
                             Background="{DynamicResource TextFieldBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource PrimaryBrush}"
                             BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                             Padding="6,5" KeyDown="NameBox_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,18">
                    <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}" MinWidth="86" Margin="0,0,8,0"/>
                    <Button x:Name="OkButton" Content="{DynamicResource Str_Btn_Rename}" Click="OK_Click"
                            Style="{StaticResource OutlineButton}" MinWidth="86"/>
                </StackPanel>
            </Grid>
        </Grid>
    </picker:PickerBorder>
</Window>
