<!--
    KillerShell - KillerUI/Grunge control styles. Theme-independent; merge AFTER a Themes/{Theme}.xaml
    palette and BEFORE AppStyles.xaml. All brushes use DynamicResource so theme/accent changes repaint.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kui="clr-namespace:KillerShell"
                    xmlns:cm="clr-namespace:System.ComponentModel;assembly=System">

    <ImageBrush x:Key="GrainTileBrush" TileMode="Tile"
                ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>

    <kui:ThumbViewportFloorConverter x:Key="ThumbFloor"/>
    <kui:LastChildConverter x:Key="IsLastChild"/>
    <kui:TabFolderIconConverter x:Key="TabFolderIcon"/>
    <!-- True when TabFolderIcon resolves to art, so the tab template can hide the MDL2 glyph
         and avoid drawing a picture and a character for the same tab. -->
    <kui:TabHasArtConverter x:Key="TabHasArt"/>

    <FontFamily x:Key="WordmarkFont">/KillerShell;component/Fonts/#Typewriter - a602 (dead postman 2004)</FontFamily>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.45"/></Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Hover/press are a translucent white/black tint OVER the accent, so every
                         theme + accent gets identical feedback from this one template. The old
                         PrimaryHoverBrush swap was invisible whenever a palette left hover ==
                         primary (which most did) - no per-palette hover brushes to sync now. -->
                    <Grid>
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource ButtonEdgeBrush}" BorderThickness="0">
                        <Grid>
                            <Border x:Name="tint" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent"/>
                            <!-- Black stroke behind the white-on-accent label, per the family rule (null on Light) -->
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource TextStroke}"/>
                        </Grid>
                    </Border>
                    <!-- Raised bevel. Nothing on any theme but 98SE, where a default button is a
                         real raised control rather than a flat accent slab. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tint" Property="Background" Value="#2EFFFFFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="tint" Property="Background" Value="#38000000"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <!-- TRANSPARENT at rest. This is the family's outline button: an accent OUTLINE at rest
             that fills solid on hover. It was filled with RowSelectedBrush, which on the newer
             themes is a 27% white wash - so the Install button in the portable badge came up as
             a milky lozenge in a color belonging to no tier, with the accent text fighting it.
             A filled rest state also leaves nowhere for hover to go. -->
        <Setter Property="Background" Value="{DynamicResource OutlineFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OutlineTextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineRestBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <!-- Black stroke so the label stays legible when hover turns it white-on-accent (null on Light) -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource TextStroke}"/>
                    </Border>
                    <!-- Raised button bevel. Nothing on any theme but 98SE. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- OnOutlineBtnBrush, NOT OnPrimaryBrush: the fill here is
                             OutlineBtnBrush, and the two tokens diverge. White on Sepulchre's
                             #4faaa8 measures 2.75:1 and on Black's #00ff66 just 1.36:1.
                             ThemeManager derives this one against the actual fill, after the
                             accent overlay, so it clears AA on every theme and every accent. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlineHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OutlineHoverTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlinePressedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OutlineTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Surface Button (secondary): fill one tier lighter than what it sits on, a dim border, and a
         hover that dims rather than colors. Accent on hover belongs to OutlineButton and
         PrimaryButton; a secondary button that lights up accent reads as the primary action. -->
    <!-- ChipFaceBrush: the pane tier on every ordinary theme, a raised #c0c0c0 Win98 button face
         on a flat one. Its hover follows ChipHoverBrush for the same reason. -->
    <Style x:Key="SurfaceButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ChipFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- ChipEdgeBrush, defaulting to PaneBorderBrush: a button sitting ON a pane takes the
             pane's own edge color (CardBorderBrush is #787878 on Black, which drew a bright gray
             box round every button). 98SE sets it transparent - its bevel is the edge. -->
        <Setter Property="BorderBrush" Value="{DynamicResource ChipEdgeBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Raised bevel. Nothing on any theme but 98SE. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Order matters: IsPressed after IsMouseOver so it wins. -->
                        <!-- A real fill change, not an opacity fade - the fade is invisible on a
                             dark panel and the button reads as dead. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource OutlineBtnBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        </Trigger>
                        <!-- Checked/selected state - same Tag="on" convention and the same
                             SelectionBg/SelectionFg pair every other checkable button style in
                             this file uses (ToolbarButton, RailButton). Declared after
                             IsMouseOver/IsPressed so an "on" row stays reading as ON while
                             hovered rather than fading to the plain hover tint - editors, gear
                             menu toggles (EditorBar.cs SyncEditorGear) and the shell/document
                             bars all set this Tag and had nothing here to answer it, so the
                             menu options were not showing their selected state. -->
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextFieldBrush and the selection pair come from the theme: the usual dark field on every
         ordinary theme, a sunken white Win98 field with a recessed bevel on a flat one. -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource TextFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <!-- InputEdgeBrush, not InputBorderBrush: 98SE sets it transparent, because a Win98 field
             is defined by its recessed bevel and a flat line drawn beside it reads as a doubled
             edge. Defaults to InputBorderBrush, so every other theme is unchanged. -->
        <Setter Property="BorderBrush" Value="{DynamicResource InputEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}"/>
        <!-- The text ON a selection. WPF ignores this unless SelectionTextBrush is set, which is
             why 98SE's white-on-navy needs it stated: at 100% selection opacity the default
             leaves the original foreground showing through, i.e. black on navy. -->
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextSelectionTextBrush}"/>
        <Setter Property="SelectionOpacity" Value="{DynamicResource TextSelectionOpacity}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <!-- Recessed field bevel - brushes CROSSED against the thicknesses so it
                         sinks rather than raises. Nothing on any theme but 98SE. -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource PaneBevelDarkBrush}"  BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit TextBox style so the search inputs pick up the theme without per-box styling. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ═══════════ Grunge ComboBox: recessed input face, grain-wrapped themed dropdown. ═══════════ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bg" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- ComboHighlightTextBrush = the PrimaryBrush this always set, except on
                             98SE where MenuHoverBrush is solid NAVY and PrimaryBrush IS that navy
                             - invisible highlighted items. White there. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <!-- ComboFieldBrush = BackgroundBrush everywhere but 98SE, where an edit field is a
             WHITE client area - dropdowns are white there. -->
        <Setter Property="Background" Value="{DynamicResource ComboFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <!-- The drop arrow. On every ordinary theme this renders exactly the
                                 bare chevron it always was (transparent face, zero bevels, same
                                 margin); on 98SE it becomes the era's raised gray button filling
                                 the field's right edge, with Marlett's solid triangle - the
                                 dropdown button takes the gray button style. -->
                            <Grid Grid.Column="1" Margin="{DynamicResource ComboChevMargin}" MinWidth="{DynamicResource ComboButtonMinWidth}">
                                <Border Background="{DynamicResource ComboButtonBrush}"/>
                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                <TextBlock x:Name="chev" Text="{DynamicResource ComboChevGlyph}" FontFamily="{DynamicResource ComboChevFont}" FontSize="8"
                                           Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{DynamicResource ComboChevGlyphMargin}"/>
                            </Grid>
                        </Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <!-- ComboPopupBrush: MenuBackgroundBrush everywhere, WHITE on 98SE -
                                 a Win98 dropdown list is a white well with the navy highlight. -->
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource ComboPopupBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Margin="6"
                                    Effect="{DynamicResource ComboPopupShadow}">
                                <Grid>
                                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                                    <ScrollViewer Margin="0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Grunge DatePicker + Calendar. ═══════════ -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <ContentControl x:Name="PART_Watermark" Focusable="False" IsHitTestVisible="False" Opacity="0"/>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrungeCalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                        <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrungeCalendarButton" TargetType="CalendarButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrungeCalendarNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrungeCalendarItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- Day-of-week header row (M T W ...) -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource PanelCornerRadius}" Margin="6" Padding="8,6">
                        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55"/></Border.Effect>
                        <Grid>
                            <!-- Margin cancels PART_Root's Padding above. The grain is a child of
                                 the padded content, so without it the texture stops 8px short of
                                 the card's edges and a flat ring frames the month grid - the
                                 same defect the details dialogs had. -->
                            <Border IsHitTestVisible="False" Margin="-8,-6" CornerRadius="{DynamicResource PanelCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PreviousButton" Grid.Column="0" Style="{StaticResource GrungeCalendarNavButton}" Content="&#xE76B;" Focusable="False"/>
                                    <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False" Cursor="Hand"
                                            Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent"><ContentPresenter x:Name="hdr" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource GrungeCalendarNavButton}" Content="&#xE76C;" Focusable="False"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid x:Name="PART_MonthView" HorizontalAlignment="Center" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" HorizontalAlignment="Center" Visibility="Hidden">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrungeCalendar" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource GrungeCalendarDayButton}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource GrungeCalendarButton}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource GrungeCalendarItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CalendarStyle" Value="{StaticResource GrungeCalendar}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="border" Background="{DynamicResource TextFieldBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="7,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" VerticalAlignment="Center"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Cursor="Hand" Width="22" Height="22">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <TextBlock x:Name="glyph" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" PopupAnimation="Fade"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Track and thickness come from the theme: a transparent 12px overlay bar on every ordinary
         theme, a wider Win98 bar with a visible dithered track and a recessed edge on a flat one. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
        <Setter Property="Width" Value="{DynamicResource ScrollBarThickness}"/>
        <Setter Property="MinWidth" Value="{DynamicResource ScrollBarThickness}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- Three rows: an arrow button at each end and the track between. The arrow
                         rows are ScrollArrowSize high, which is 0 on every ordinary theme - so
                         they collapse to nothing and the bar is the plain overlay it always was.
                         98SE asks for 16 and gets real Win98 stepper buttons. -->
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ArrowUpRow"   Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition x:Name="ArrowDownRow" Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Columns as well as rows, so ONE template serves both orientations. The
                             steppers used to be laid out in rows only and were simply Collapsed on
                             a horizontal bar, which is why a horizontal Win98 bar had no arrows.
                             Now the Orientation trigger MOVES them: vertical parks them in
                             row 0 / row 2 of column 1, horizontal in column 0 / column 2 of row 1.
                             Both tracks are Auto, so whichever pair is empty measures to zero and
                             the other twelve themes (ScrollArrowSize 0) still get nothing at all. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ArrowLeftCol"  Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ArrowRightCol" Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Marlett, not Segoe MDL2 - the MDL2 scrollbar arrows looked
                             wrong. E70E/E70D are thin CHEVRONS, and at 8px they rendered
                             as a wispy caret with ClearType color fringes. Marlett is the actual
                             Win9x marker font - '5'/'6'/'3'/'4' are the solid up/down/left/right
                             scrollbar triangles - and it is TrueType, so WPF can render it
                             (unlike MS Sans Serif). Aliased, because the real thing was: a 5px
                             triangle drawn through ClearType smears into color. Only 98SE ever
                             sees these buttons (ScrollArrowSize is 0 everywhere else). -->
                        <RepeatButton x:Name="ArrowUp" Grid.Row="0" Grid.Column="1" Command="ScrollBar.LineUpCommand"
                                      Focusable="False" IsTabStop="False"
                                      Width="{DynamicResource ScrollArrowSize}"
                                      Height="{DynamicResource ScrollArrowSize}"
                                      Content="5" FontFamily="Marlett" FontSize="10"
                                      TextOptions.TextRenderingMode="Aliased"
                                      TextOptions.TextFormattingMode="Display"
                                      Foreground="{DynamicResource CaptionGlyphBrush}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Grid>
                                        <Border Background="{DynamicResource SortButtonBrush}"/>
                                        <Border BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                        <Border BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>

                        <RepeatButton x:Name="ArrowDown" Grid.Row="2" Grid.Column="1" Command="ScrollBar.LineDownCommand"
                                      Focusable="False" IsTabStop="False"
                                      Width="{DynamicResource ScrollArrowSize}"
                                      Height="{DynamicResource ScrollArrowSize}"
                                      Content="6" FontFamily="Marlett" FontSize="10"
                                      TextOptions.TextRenderingMode="Aliased"
                                      TextOptions.TextFormattingMode="Display"
                                      Foreground="{DynamicResource CaptionGlyphBrush}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Grid>
                                        <Border Background="{DynamicResource SortButtonBrush}"/>
                                        <Border BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                        <Border BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>

                        <Track x:Name="PART_Track" Grid.Row="1" Grid.Column="1" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.ViewportSize>
                                <MultiBinding Converter="{StaticResource ThumbFloor}" ConverterParameter="64">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ViewportSize"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Orientation"/>
                                </MultiBinding>
                            </Track.ViewportSize>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageBack" Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageForward" Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid>
                                                        <Border x:Name="thumbBorder" Background="{DynamicResource ScrollThumbBrush}"
                                                                CornerRadius="{DynamicResource ScrollThumbRadius}"
                                                                Margin="{DynamicResource ScrollThumbMargin}"/>
                                                        <!-- Raised thumb bevel: 98SE only. -->
                                                        <Border IsHitTestVisible="False" Margin="{DynamicResource ScrollThumbMargin}"
                                                                BorderBrush="{DynamicResource ScrollTrackBevelLight}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                        <Border IsHitTestVisible="False" Margin="{DynamicResource ScrollThumbMargin}"
                                                                BorderBrush="{DynamicResource ScrollTrackBevelDark}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <!-- ScrollThumbMarginH, not the literal 0,4: that squeeze is the
                                                                 slim-overlay look, and on 98SE it left an 8px thumb floating in
                                                                 a 16px track - the skinny tree scrollbar.
                                                                 The token defaults to exactly the literal it replaced. -->
                                                            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
                                                                <Setter TargetName="thumbBorder" Property="Margin" Value="{DynamicResource ScrollThumbMarginH}"/>
                                                            </DataTrigger>
                                                            <!-- Margin and Effect are theme tokens now (ThemeManager,
                                                                 ScrollThumbHover*): the literals shrank the thumb out from
                                                                 under its own bevel ring and glowed on a shadowless theme.
                                                                 Defaults are exactly the old literals. -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                                <Setter TargetName="thumbBorder" Property="Margin" Value="{DynamicResource ScrollThumbHoverMargin}"/>
                                                                <Setter TargetName="thumbBorder" Property="Effect" Value="{DynamicResource ScrollThumbHoverEffect}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- IsDirectionReversed is declared True on the Track above because a
                             VERTICAL track needs it: without it the thumb rises as the content
                             scrolls down. A horizontal track wants the opposite, and one shared
                             template serves both orientations here, so it has to be undone -
                             otherwise the horizontal thumb sits at the right when the content is
                             scrolled hard left, which is what it was doing. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="PageBack"    Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            <!-- The steppers MOVE rather than hiding. They used to be Collapsed
                                 here because the template only had rows, so a horizontal bar would
                                 have put its arrows above and below the track; with the columns
                                 added above they relocate to either end of the track instead, and
                                 a horizontal 98SE bar gets real Win98 steppers like the vertical
                                 one always had. Glyph and command flip with them - Marlett '3'/'4'
                                 are the solid left/right triangles, against '5'/'6' up/down. -->
                            <Setter TargetName="ArrowUp"   Property="Grid.Row"    Value="1"/>
                            <Setter TargetName="ArrowUp"   Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ArrowUp"   Property="Content"     Value="3"/>
                            <Setter TargetName="ArrowUp"   Property="Command"     Value="ScrollBar.LineLeftCommand"/>
                            <Setter TargetName="ArrowDown" Property="Grid.Row"    Value="1"/>
                            <Setter TargetName="ArrowDown" Property="Grid.Column" Value="2"/>
                            <Setter TargetName="ArrowDown" Property="Content"     Value="4"/>
                            <Setter TargetName="ArrowDown" Property="Command"     Value="ScrollBar.LineRightCommand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <!-- ScrollBarThickness, not a literal 12: 98SE asks for a 16px bar and the
                     horizontal one stayed 12 while the vertical one grew, so the two disagreed
                     and the corner block never squared up. -->
                <Setter Property="Height" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="MinHeight" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="Width" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ported to KillerPDF's context menu surface value for value (KillerPDF MainWindow.xaml,
         the ContextMenu style): Grid Margin 5, CornerRadius 4, Padding 4, and a 12/2/0.55-ish
         shadow at Opacity 0.5. It used to carry KillerShell's own flyout shadow - 22 blur, 4
         depth, radius 6 - which is nearly double the blur and double the drop, and read as a
         much heavier halo than the rest of the family.
         The shadow still lives on its OWN border behind the content, never on the one the menu
         text renders inside: a DropShadowEffect rasterizes its whole subtree through a bitmap
         pass and the text loses ClearType. KillerPDF splits it the same way. -->
    <Style TargetType="ContextMenu">
        <!-- IDEAL text here, not the window's Display. A menu is a Popup with
             AllowsTransparency, and WPF cannot render ClearType onto a layered surface - it
             silently drops to grayscale antialiasing. Display mode then snaps every stem to the
             pixel grid, and grid-snapped stems with grayscale edges is exactly the "pixelated,
             letters bleeding into each other" look (2026-08-09). Ideal positions glyphs at
             subpixel offsets, which is what grayscale AA needs to read cleanly. The window keeps
             Display, because on its own opaque surface ClearType works and Display is crisper.
             SnapsToDevicePixels stays for the BORDERS - it does not affect glyph rasterization. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <!-- GRAYSCALE, stated explicitly. TextRenderingMode is an INHERITED property and the
             window sets ClearType (MainWindow.xaml), which flows down into the menu through the
             logical tree - a popup is not a visual child of the window but it inherits like
             one. ClearType asks for subpixel (RGB-stripe) coverage, and on a layered
             AllowsTransparency popup there is no opaque backdrop for those stripes to be
             correct against, so the edges come out fringed and chunky. Naming Grayscale stops
             the inheritance at the menu and gives smooth, neutral edges.
             Formatting mode above and rendering mode here are two different things and BOTH
             were wrong: Ideal fixes WHERE the glyph sits, Grayscale fixes HOW it is filled. -->
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <!-- The menu can be positioned at a fractional offset, which puts every glyph in it at a
             subpixel origin however well the text options are set. -->
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <!-- Compensates the shadow halo so a menu lands where it did when that halo was 5 (this
             template) or 6 (FlyoutCard). Those two differ by a pixel, so the rail flyouts sit 1px
             off their old spot; the menus are exact. -->
        <Setter Property="HorizontalOffset" Value="-17"/>
        <Setter Property="VerticalOffset" Value="-13"/>
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- FADE IN. A ContextMenu has no PopupAnimation property - it is not a Popup,
                         it is hosted inside one WPF owns - so the fade is driven from the template
                         with an EventTrigger on Loaded. Submenus already faded, so a menu appeared
                         instantly while its own children faded in, which is backwards. 150ms
                         ease-out, the curve Anim.FadeIn uses. -->
                    <!-- Opacity 1 as the BASE value, with the fade below set to FillBehavior=Stop.
                         This was Opacity="0" plus a HoldEnd animation to 1, and a held animation
                         leaves the property permanently "animated" even sitting at 1.0 - WPF then
                         keeps compositing this subtree through an intermediate surface, which
                         disables ClearType and softens every glyph in the menu for as long as it
                         is open. That is the pixelated, bleeding text, and it is why setting the
                         text options alone changed nothing (2026-08-09). Stopping the animation
                         hands the property back to this base value and the menu renders on the
                         ordinary path. -->
                    <!-- Halo sized to MenuShadowEffect's 22/4: WPF expands render bounds by the FULL
                         BlurRadius, so 22 each way, less the 4px lift off the top and plus it on the
                         bottom. The offsets on the style above hold the card in place. -->
                    <Grid x:Name="MenuRoot" Opacity="1" Margin="22,18,22,26">
                        <!-- MenuShadow*: the family flyout shadow on every ordinary theme (opacity
                             follows FlyoutShadowOpacity, 22/4 soft), and a HARD offset shadow at
                             full opacity on 98SE - Win98 context menus cast a solid drop shadow. -->
                        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}" IsHitTestVisible="False"
                                Opacity="{DynamicResource MenuShadowOpacity}"
                                Effect="{DynamicResource MenuShadowEffect}">
                        </Border>
                        <!-- Raised menu bevel, two pairs. Nothing on any theme but 98SE, whose
                             menus are a hard raised box rather than a rounded shadowed card. -->
                        <Border IsHitTestVisible="False" Panel.ZIndex="4"
                                BorderBrush="{DynamicResource MenuBevelLightBrush}" BorderThickness="{DynamicResource MenuBevelLightThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="4"
                                BorderBrush="{DynamicResource MenuBevelDarkBrush}"  BorderThickness="{DynamicResource MenuBevelDarkThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="4" Margin="{DynamicResource MenuBevelInnerMargin}"
                                BorderBrush="{DynamicResource MenuBevel2LightBrush}" BorderThickness="{DynamicResource MenuBevel2LightThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="4" Margin="{DynamicResource MenuBevelInnerMargin}"
                                BorderBrush="{DynamicResource MenuBevel2DarkBrush}"  BorderThickness="{DynamicResource MenuBevel2DarkThickness}"/>
                        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="4" SnapsToDevicePixels="True">
                            <Grid>
                                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="-4"
                                        Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ContextMenu.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- FillBehavior=Stop: the fade releases the property when it
                                         finishes instead of holding it, so the menu stops being
                                         composited and its text goes back to being crisp. See the
                                         note on MenuRoot's base Opacity above. -->
                                    <DoubleAnimation Storyboard.TargetName="MenuRoot" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop">
                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu icon glyph: Segoe MDL2 at 12, left-aligned in the 16px gutter. The 2026-08-09
         selection/hover color language: icons rest on the plain text color and go accent with
         the hovered row - never accent at rest, never accent on an accent fill. The hover
         brush is ComboHighlightTextBrush rather than PrimaryBrush for the 98SE navy-wash
         reason documented on the MenuItem template below. -->
    <Style x:Key="MenuGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ported wholesale from KillerPDF's MenuItem template (MainWindow.xaml), brush names
         translated. What changed from KillerShell's own version:
           - Padding 24,7 -> 8,6,10,6. The old row carried 24px of padding IN FRONT of a 28px
             icon gutter, so text started roughly twice as far in as KillerPDF's.
           - Icon gutter: an Auto column holding an 18px presenter plus a 10px margin -> a fixed
             16px column, which is also the check-glyph column. Items with no icon no longer
             collapse the gutter, so every row's text lines up whether or not it has an icon.
           - Highlight gets CornerRadius 3 instead of a square block running edge to edge, and
             no longer recolors the text to the accent - KillerPDF moves the background only.
           - InputGestureText column and submenu arrow: KillerShell's template had NEITHER, so a
             shortcut hint on a menu item silently rendered nothing and a submenu had no
             affordance. Both are here now, with the same collapse-when-empty trigger.
           - Submenu popup mirrors the ContextMenu surface and fades (PopupAnimation), which was
             the one fade KillerPDF had that KillerShell could not match for want of submenus. -->
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <!-- Restated on the ITEM as well as on the ContextMenu that holds it: a MenuItem in a
             submenu lives in its OWN popup, which is not inside the parent menu's visual tree,
             so the parent's text options do not reach it. Same reasoning as the ContextMenu
             style above. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- TextBrush, not MenuTextBrush: menu items are body text, not secondary labels.
             Family standard, see KillerUI/README.md surface rules. -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6,10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuBd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource SmallCornerRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icon slot: MenuItem.Icon renders in the same 16px gutter the
                                 check glyph uses. -->
                            <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <TextBlock x:Name="SubArrow" Grid.Column="3" Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="Collapsed"/>
                            <Popup x:Name="SubPopup" AllowsTransparency="True" Placement="Right"
                                   HorizontalOffset="-21" VerticalOffset="-13" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <!-- Mirrors the ContextMenu surface so submenus match the parent.
                                     Halo sized to the 22/4 shadow; the offsets above carry the
                                     -17,-13 compensation (this halo grew from 5) on top of the -4 gap. -->
                                <Grid Margin="22,18,22,26">
                                    <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.5"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource MenuBackgroundBrush}"
                                            BorderBrush="{DynamicResource MenuBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="4">
                                        <Grid>
                                            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" Margin="-4" Background="{DynamicResource GrainTileBrush}"/>
                                            <ItemsPresenter/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- HOVER, not selection: accent text on the neutral MenuHoverBrush wash.
                             The 2026-08-09 selection/hover color language - SELECTED is white on
                             the accent-tinted block, HOVER is accent on the neutral wash - and a
                             hovered menu row is a hover, not a selection. The old SelectionBg
                             fill was the "accent on accent" surface: it put the accent check
                             glyph and accent-adjacent icons on an accent-tinted fill.
                             ComboHighlightTextBrush, NOT PrimaryBrush, for the same reason the
                             ComboBoxItem trigger above uses it: 98SE's MenuHoverBrush is solid
                             navy and its PrimaryBrush IS that navy - accent-on-wash would be
                             invisible there, so the token goes white on 98SE. Check, gesture and
                             chevron ride the same brush so nothing muted is left to fight the
                             navy. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuBd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
                            <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
                            <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
                        </Trigger>
                        <!-- Collapse the shortcut column when there is no gesture, so items
                             without one do not reserve its 24px left margin as phantom padding. -->
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MenuBd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NOTE: inside a Menu or ContextMenu, WPF does NOT use this implicit style - it looks up
         MenuItem.SeparatorStyleKey and falls back to the stock Aero separator, the bright gray
         3D line. That is what the caption system menu was showing between Maximize and Close
         (Chrome.cs ShowCaptionMenu adds a Separator there). The keyed alias just below is what
         actually applies in menus; this one covers separators used anywhere else. -->
    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The key WPF actually resolves for a Separator sitting in a menu. Same look as above;
         registering it here is what stops the stock light-gray line. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource {x:Type Separator}}"/>

    <!-- Glyph for a MenuItem.Icon, so an icon in the new gutter is one line at the call site
         and the size/color live in one place (family standard, see KillerScan App.xaml).
         Same rest/hover treatment as MenuGlyph above: plain text color at rest, accent (via
         the 98SE-safe ComboHighlightTextBrush) on the hovered row. -->
    <Style x:Key="MenuIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- ============================================================
         Family flyout standard, ported verbatim from KillerPDF - the exact KillerPDF menu is
         the reference for everything here. The rail's theme and language flyouts are
         Button.ContextMenus whose chrome comes ONLY from FlyoutCard + FlyoutGrain, with
         PanelMenuItem stripping the MenuItem container for panel content (a StackPanel of
         RadioButtons, not clickable rows).
         ============================================================ -->

    <!-- The card: fill, frame, radius, shadow-room margin and the shadow itself. -->
    <Style x:Key="FlyoutCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgFlyout}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}"/>
        <!-- Margin is the room the drop shadow renders into: a Popup clips to its own bounds, so
             anything the shadow throws past it is cut off square. Sized to FlyoutCardEffect's 22/4:
             WPF expands render bounds by the FULL BlurRadius, so 22 each way, less the 4px lift off
             the top and plus it on the bottom. CONSUMERS MUST COMPENSATE with
             HorizontalOffset/VerticalOffset - see the ContextMenu style. -->
        <Setter Property="Margin" Value="22,18,22,26"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- FlyoutCardEffect: CardShadowEffect on every ordinary theme exactly as before, and a
             HARD offset shadow on 98SE - Win98 drew its menus with a solid drop shadow, so the
             flyouts get it back with the bevel. -->
        <Setter Property="Effect" Value="{DynamicResource FlyoutCardEffect}"/>
    </Style>

    <!-- The grain overlay. LAST child of the card, so it lies OVER the items - including a
         highlighted row's solid SelectionBg fill. Radius 5 = the card's 6 minus its 1px
         border, so the texture stops exactly inside the frame. -->
    <Style x:Key="FlyoutGrain" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource GrainTileBrush}"/>
        <Setter Property="Opacity" Value="{DynamicResource GrainOpacity}"/>
    </Style>

    <!-- ItemContainerStyle for a flyout whose content is a PANEL (swatches, radio lists)
         rather than rows you click. Strips the MenuItem container down to its content: no
         hover highlight bleeding across the card, no icon gutter. -->
    <Style x:Key="PanelMenuItem" TargetType="MenuItem">
        <Setter Property="Padding" Value="0"/>
        <!-- A click inside the panel that bubbles up to this container counts as a MenuItem
             click and closes the flyout without this. The theme flyout must survive a pick so
             themes can be compared; the language flyout closes itself explicitly either way. -->
        <Setter Property="StaysOpenOnClick" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <ContentPresenter ContentSource="Header"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent picker dot, family-standard (KillerPDF AccentDot). 18px filled circle, rings
         in TextBrush when it is the family's current pick (set from code). -->
    <Style x:Key="AccentDot" TargetType="Border">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Ringed radio row for the theme/language flyouts (KillerPDF ThemeRadio). PrimaryBrush
         stands in for PDF's RadioAccent, which KillerShell has no separate resource for. -->
    <Style x:Key="ThemeRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Transparent ROW, not RadioWellBrush: that key is the little white circle
                         well behind the radio RING (see KillerNotes' copy of this template), and
                         painting it across the whole row turned every flyout option into a WHITE
                         pill on 98SE - the "wrong color" flyouts. The well
                         ellipse below is where it actually belongs; both are transparent on every
                         ordinary theme, so nothing changes there. -->
                    <Border x:Name="bd" Background="Transparent"
                            CornerRadius="{DynamicResource SmallCornerRadius}"
                            Margin="-8,0,2,0" Padding="10,4,10,4">
                        <!-- DockPanel (not a horizontal StackPanel) so the content fills the row
                             width, letting a right-aligned column (e.g. language codes) reach the
                             right edge. -->
                        <DockPanel LastChildFill="True" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left">
                                <Ellipse Width="14" Height="14" Fill="{DynamicResource RadioWellBrush}"/>
                                <Ellipse x:Name="ring" Width="14" Height="14"
                                         Stroke="{DynamicResource DimTextBrush}" StrokeThickness="1.5"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeSwatch" TargetType="Button">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="dot" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="dot" Property="StrokeThickness" Value="2"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="dot" Property="StrokeThickness" Value="3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width row inside a popup menu: transparent until hovered, then the menu's own
         hover fill. Needed because a Button with no Style keeps the default WPF template, whose
         hover is the system light blue - setting Background alone does not reach it, since the
         template's own trigger paints over whatever the property says. -->
    <Style x:Key="MenuRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed"   Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact horizontal slider. The default WPF Slider brings its own chrome, tick bar and
         system colors, none of which belong on a themed card - so the template is a thin track
         with an accent fill up to the thumb, and a small round grip. The fill is a second Border
         inside the same cell driven by the RepeatButton's width, which is what actually reports
         the value's position without a converter. -->
    <Style x:Key="ThinSlider" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- SliderTrack: the input edge on every ordinary theme, a #808080 sunken
                             groove on 98SE. -->
                        <Border Height="3" CornerRadius="{DynamicResource SmallCornerRadius}" VerticalAlignment="Center"
                                Background="{DynamicResource SliderTrack}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="{DynamicResource SmallCornerRadius}" VerticalAlignment="Center"
                                                    Background="{DynamicResource PrimaryBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Grip" Width="13" Height="13" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="knob" Fill="{DynamicResource PrimaryBrush}"
                                                     Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="knob" Property="StrokeThickness" Value="1"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="DangerRed" Color="#e04444"/>
    <!-- Fixed, non-theme status colors, alongside DangerRed above - a severity dot has to read
         the same regardless of which theme or accent is active, the way DangerRed already does
         for a Processes tab. Added for the Event Viewer's Level column (Tools/EventViewerControl.cs). -->
    <SolidColorBrush x:Key="WarningAmber" Color="#e0a83f"/>
    <SolidColorBrush x:Key="InfoBlue" Color="#4a90d9"/>

    <!-- Geometry and face come from the theme (ThemeManager's 98SE chrome contract), not from
         literals: 44x36 with a transparent face and a row-hover wash on every ordinary theme, and
         a short beveled Win98 button with a real face and no hover on a flat one. Bound, so
         98SE needs no branch and no second style. -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CaptionButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource CaptionGlyphBrush}"/>
        <Setter Property="FontWeight" Value="{DynamicResource CaptionGlyphWeight}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="{DynamicResource CaptionButtonMargin}"/>
        <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}"/>
        <Setter Property="Height" Value="{DynamicResource CaptionButtonHeight}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <!-- Raised bevel. Zero-thickness and transparent on every theme but 98SE,
                             so it costs nothing and draws nothing there. -->
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main-window close button: the WHOLE button fills danger red with a white glyph on
         hover, like KillerPDF's. The dialog close X's keep the glyph-only treatment. -->
    <!-- Inherits geometry and the bevel from ChromeButton; only the corner and the hover differ.
         On a flat theme it is a beveled gray button with a black glyph and NO hover fill, which
         is how Win98 drew it - it reacted to being pressed, not hovered. -->
    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Foreground" Value="{DynamicResource CaptionCloseBrush}"/>
        <Setter Property="Margin" Value="{DynamicResource CaptionCloseGap}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- The corner follows the WINDOW's radius: this button sits IN the
                             top-right corner, so a square red fill runs past the curve and the
                             DWM slices the overhang off, leaving a chewed edge on hover. Squares
                             itself on a flat theme, where the window is square too. -->
                        <Border x:Name="Bd" Background="{DynamicResource CaptionButtonBrush}"
                                CornerRadius="{DynamicResource CaptionCloseCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="bevelLight" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border x:Name="bevelDark" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CaptionCloseHoverFgBrush}"/>
                        </Trigger>
                        <!-- PRESSED: the bevel inverts, so the button visibly sinks. That is the
                             only feedback a Win98 caption button ever gave - it had no hover
                             state at all. Both bevels are zero-thickness on
                             every other theme, so this trigger does nothing there. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bevelDark"  Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A check-marked option row for the editor's gear and encoding popups: reads like a
         MenuItem - transparent row, hover wash, a 16px check column that shows E73E while
         Tag="on" - instead of the accent-filled buttons these were, which read as pressed
         buttons rather than toggled options. The Tag="on" signal is the
         SAME one the code already sets for SurfaceButton, so no code changes anywhere. -->
    <Style x:Key="CheckRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="4,3,10,3">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="check" DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" Width="16" VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close X for the About card and the Shortcuts card. Theme-split entirely through tokens
         (AboutClose* in ThemeManager): on every ordinary theme it renders the ORIGINAL treatment
         - a bare muted U+2715 that reddens on hover, no fill - and on 98SE it is a real Win98
         caption button: gray beveled face, black bold E8BB, sinks on press, no hover state.
         ChromeCloseButton was tried here first and dragged the main window's red hover fill and
         glyph onto the cards, which read wrong on the ordinary themes. -->
    <Style x:Key="OverlayCloseButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AboutCloseFg}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AboutCloseFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="{DynamicResource CaptionGlyphWeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{DynamicResource CaptionButtonBrush}"/>
                        <Border x:Name="bevelLight" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border x:Name="bevelDark" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AboutCloseHoverFg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bevelDark"  Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elevation (KillerPDF ShadowBar): lifts panels/cards slightly off the surface. -->
    <DropShadowEffect x:Key="ShadowBar" Color="Black" BlurRadius="6" ShadowDepth="3" Direction="270" Opacity="0.38"/>
    <!-- Stronger elevation for the results pane; casts down over the footer. -->
    <!-- Kept for anything still referencing it directly. The LIVE one is PaneShadowEffect, built
         per palette load in ThemeManager at that theme's PaneShadowOpacity and set to NULL on a
         flat theme - 98SE has no shadows at all. A StaticResource here could never follow a theme
         change, which is why the pane kept its shadow on 98SE. -->
    <DropShadowEffect x:Key="PaneShadow" Color="Black" BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.6"/>

    <!-- Themed checkbox: small square, accent check, mono label. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="15" Height="15" CornerRadius="{DynamicResource SmallCornerRadius}" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" Effect="{DynamicResource TextStrokeSoft}"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- KillerUI sidebar icon-rail button: bare
         glyph with a soft shadow, turning the accent color on hover. Set Content to the glyph;
         override FontFamily/FontSize for text glyphs like a "?" button. -->
    <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- 20 logical hugs the 16px glyphs; the RailW=24 column (SearchPanel.cs) leaves only a
             2px inset per side, so zooming scales the icons rather than blank strip. -->
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="270"
                                                  Opacity="{DynamicResource IconShadowOpacity}"/>
                            </TextBlock.Effect>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                        <!-- Tag="on" marks a rail toggle whose panel is open. -->
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="on">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- View-mode toggles (results pane list / icons / details). Tag="on" marks the active one,
         the same convention the folder picker's own strip uses. -->
    <Style x:Key="ViewToggleBtn" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{DynamicResource SortButtonBrush}"
                                CornerRadius="{DynamicResource SmallCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Raised bevel: 98SE only, where a toolbar button is a real button. -->
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover = accent glyph on the neutral wash (2026-08-09 color language).
                             Declared BEFORE Tag="on" so a hovered SELECTED button keeps white-on-
                             accent - the later trigger wins the Foreground, never accent-on-accent. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Details-view column header buttons: a label plus a sort arrow, flat until hovered. -->
    <Style x:Key="ColHeaderBtn" TargetType="Button">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ FOLDER TREE ═══════════ -->
    <!-- The stock WPF TreeView brings its own chrome with it: a white SystemColors selection
         highlight, Aero triangles, and a ScrollViewer whose corner square between the two
         scrollbars is painted with the system Control brush - the white box that showed up at
         the end of the horizontal bar. All three are replaced here rather than patched. -->

    <!-- Expander triangle. Two Paths rather than a glyph font so it stays crisp at any app
         scale and takes the accent on hover like everything else. -->
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <!-- Canvas so the geometry coordinates below are absolute within the
                             16px gutter and line up with the connecting line, which sits at
                             x=7.5-8.5. A bare Path would be positioned by layout instead, and
                             the alignment this whole style exists for would drift.
                             The two states are separate geometries rather than one chevron on a
                             RotateTransform: rotating about the bounding-box center swings the
                             arms back across the line, which is what drew an X over it.
                             FILL is what makes the line read as a zigzag rather than something
                             with a chevron laid over it - an unclosed figure still fills as if
                             closed, so the triangle between the arms is painted in the panel's
                             own background and the line disappears behind it. -->
                        <Canvas Width="16" Height="16">
                            <!-- TWO paths, not one. The mask and the visible chevron want
                                 different left edges: the stroke sits a pixel clear of the line
                                 so the two read as separate marks, but a fill that started
                                 there would leave the line showing along the inside of the
                                 arms. The fill path reaches back to x=7 - past the line's left
                                 edge at 7.5 - so the whole 1px is covered. It has no stroke, so
                                 all it ever does is paint background. -->
                            <!-- TreeChevronMaskBrush, which defaults to SolidBackgroundBrush -
                                 this fill exists to vanish into whatever is behind the chevron,
                                 and BackgroundBrush itself cannot be used because it is a
                                 gradient on five themes and re-ramps inside this 16px box
                                 (ThemeManager has the full note).
                                 It is its own key rather than SolidBackgroundBrush directly
                                 because "whatever is behind" is not the same surface in every
                                 tree: the folder tree shows the window, the Registry Editor's
                                 tree shows its control's PaneBrush. That tree overrides this key
                                 on its own Resources, and a DynamicResource resolves up the tree
                                 from the element, so it wins there and nowhere else. -->
                            <Path x:Name="arrowFill" Data="M 7,3.5 L 13,7.5 L 7,11.5"
                                  Fill="{DynamicResource TreeChevronMaskBrush}" SnapsToDevicePixels="False"/>
                            <Path x:Name="arrow" Data="M 8.5,3.5 L 13,7.5 L 8.5,11.5"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource DimTextBrush}" SnapsToDevicePixels="False"/>
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Points down, vertex landing on x=8 - the line's center - so the
                                 line runs into the point of the V rather than off to one side.
                                 Arm length and angle match the collapsed chevron (these are its
                                 own three points rotated 90 degrees, worked out by hand: a
                                 RenderTransform cannot be reached by TargetName, MC4111).
                                 Fill and stroke share a geometry here, unlike the collapsed
                                 state - the line passes through the V's interior rather than
                                 along its edge, so the plain triangle already covers it. -->
                            <Setter TargetName="arrow"     Property="Data" Value="M 4,5.25 L 8,9.75 L 12,5.25"/>
                            <Setter TargetName="arrowFill" Property="Data" Value="M 4,5.25 L 8,9.75 L 12,5.25"/>
                            <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FolderTreeItem" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <!-- 2,0 (was 2,1), matching the saved places' own compaction: the tree is a dense index
             you scan down, and with the row's StackPanel margin also dropped a row is the same
             height in both halves of the sidebar. -->
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 16px gutter carries the expander AND the connecting lines, so
                                 the lines land dead center on the triangle at every depth. -->
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Connecting lines. The vertical runs the full height of the node and
                             its children; the horizontal is the stub out to this node's icon.
                             For the last child the vertical is cut to an elbow (see trigger)
                             so it stops at the join instead of trailing into empty space. -->
                        <Rectangle x:Name="VerLine" Grid.RowSpan="2" Width="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                   Fill="{DynamicResource TreeLineBrush}" SnapsToDevicePixels="True"/>
                        <!-- Only drawn for a node with no expander. Where there IS one the
                             chevron is the connector - its tips meet the vertical line at x=8
                             and it carries the eye out to the icon, so a stub underneath it
                             would just be the line showing through the arms again. -->
                        <Rectangle x:Name="HorLine" Height="1" Margin="8,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                   Visibility="Collapsed"
                                   Fill="{DynamicResource TreeLineBrush}" SnapsToDevicePixels="True"/>

                        <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}"
                                      ClickMode="Press" VerticalAlignment="Center"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <Border x:Name="Bd" Grid.Column="1" CornerRadius="{DynamicResource SmallCornerRadius}" Margin="2,0,0,0"
                                Background="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- No children means no chevron, so the elbow stub takes over as the
                             connector. The vertical stays either way: a leaf still belongs to
                             the run of siblings drawn down the gutter. -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="HorLine" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <!-- SelectionBg + SelectionFg, the SAME pair the places/bookmarks rows
                             use - the tree used RowSelectedBrush, which on Delirium, Sepulchre,
                             Malaise, Decay and Ectoplasm is a gray wash while the bookmarks
                             below glow the accent, and the mismatch read as a bug - the tree
                             should light the accent too. One selection treatment
                             everywhere; the trees' item templates must NOT pin their own
                             Foreground or the Fg half cannot reach the text. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                        <!-- Last sibling: cut the vertical to an elbow. Bound to the container
                             itself so a recycled container re-evaluates (LastChildConverter.cs). -->
                        <DataTrigger Value="True"
                                     Binding="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource IsLastChild}}">
                            <Setter TargetName="VerLine" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="VerLine" Property="Height" Value="11"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollViewer with NO corner element. The stock template puts a Rectangle in the gap
         where the two scrollbars meet, filled with SystemColors.ControlBrushKey - white in
         every theme this app ships, and the little square that kept showing up at the end of
         the horizontal bar. Retemplating the TreeView alone did not remove it: the TreeView's
         template still hosted a plain ScrollViewer, which brings its own default template and
         the corner with it. The cell is simply left empty here. -->
    <Style x:Key="BareScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False"
                                                CanVerticallyScroll="False"/>

                        <!-- The PART_ names are what ScrollViewer wires its own scrolling to, so
                             Value binds one-way and the control drives it from there. -->
                        <!-- RowSpan 2: the vertical bar runs down THROUGH the corner block rather
                             than stopping above it. The corner was a bare 16x16 hole whenever a
                             horizontal bar appeared, and the only thing that sensibly fills it is
                             the bar itself. -->
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                   Orientation="Vertical" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                                   Orientation="Horizontal" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>

                        <!-- Row 1 / Column 1 deliberately left empty: that is the corner. -->
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FolderTreeView" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FolderTreeItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                        <ScrollViewer Style="{StaticResource BareScrollViewer}"
                                      Padding="{TemplateBinding Padding}"
                                      CanContentScroll="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File and folder picker internals: row container, text tiers, view-toggle and
     column-header buttons, and the view templates with their panels. -->

    <!-- The places / bookmarks rail. Same behavior as PickerRow but tight: PickerRow's 8,5 padding
         plus 2,1 margin made each place about 28px tall around a 16px icon, so the rail showed far
         fewer entries than it had room for. Its own style, because the file list uses PickerRow for
         rows carrying three columns of detail that need the breathing room. -->
    <Style x:Key="PickerPlaceRow" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="6,1" Margin="2,0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row container: hover + accent selection. -->
    <Style x:Key="PickerRow" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,5" Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Black drop-shadow "stroke" behind white-on-accent row content. -->
    <Style x:Key="PickerRowContent" TargetType="Panel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Effect" Value="{DynamicResource TextStroke}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Glyph: accent for folders, dim for files, white while selected. -->
    <Style x:Key="PickerGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFolder}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Entry name: normal for folders, muted for files, white while selected. -->
    <Style x:Key="PickerName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFolder}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Size / modified columns in details view. -->
    <Style x:Key="PickerMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- View toggle buttons; Tag="on" marks the active mode. -->
    <Style x:Key="PickerViewBtn" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{DynamicResource SortButtonBrush}"
                                CornerRadius="{DynamicResource SmallCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Raised bevel: 98SE only, where a toolbar button is a real button. -->
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border IsHitTestVisible="False"
                                BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover = accent glyph on the neutral wash (2026-08-09 color language).
                             Declared BEFORE Tag="on" so a hovered SELECTED button keeps white-on-
                             accent - the later trigger wins the Foreground, never accent-on-accent. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sortable column header buttons (details view). -->
    <Style x:Key="PickerColBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LIST view row: real 16px shell icon + name, sized so columns line up when the panel
         wraps vertically. Fixed Width is what makes the columns even; without it every column
         is as wide as its longest name and the grid looks ragged. -->
    <DataTemplate x:Key="RowTemplate">
        <StackPanel Orientation="Horizontal" Style="{StaticResource PickerRowContent}" Width="210">
            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                   Margin="0,0,8,0" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource PickerName}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ICONS view: 32px icon above a centered, wrapping name. Genuinely different from the
         list view - previously both used RowTemplate and only the panel differed, which read
         as two list modes. -->
    <DataTemplate x:Key="IconTemplate">
        <StackPanel Style="{StaticResource PickerRowContent}" Width="84">
            <Image Source="{Binding IconLarge}" Width="32" Height="32"
                   HorizontalAlignment="Center" Margin="0,2,0,4" SnapsToDevicePixels="True"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource PickerName}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxHeight="30"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- Details view: name | size | modified. -->
    <DataTemplate x:Key="DetailsTemplate">
        <Grid Style="{StaticResource PickerRowContent}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                       Margin="0,0,8,0" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource PickerName}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Style="{StaticResource PickerMeta}" TextAlignment="Right" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding ModifiedLabel}" Style="{StaticResource PickerMeta}" Margin="10,0,0,0"/>
        </Grid>
    </DataTemplate>

<!-- Details view: one row per entry, scrolls down. -->
    <ItemsPanelTemplate x:Key="PanelStack"><VirtualizingStackPanel/></ItemsPanelTemplate>

    <!-- LIST view: fills a column top-to-bottom then starts the next column to the right, so
         the pane scrolls HORIZONTALLY - Explorer's List view. Vertical
         orientation is what makes it wrap downward-then-across; the ListBox must also have
         VerticalScrollBarVisibility="Disabled" or the panel gets infinite height and never
         wraps at all. ItemHeight keeps the columns aligned. -->
    <ItemsPanelTemplate x:Key="PanelListCols">
        <WrapPanel Orientation="Vertical" ItemHeight="26"/>
    </ItemsPanelTemplate>

    <!-- ICONS view: left-to-right, wrapping down, scrolls vertically. -->
    <ItemsPanelTemplate x:Key="PanelIconGrid">
        <WrapPanel Orientation="Horizontal" ItemWidth="96" ItemHeight="76"/>
    </ItemsPanelTemplate>

    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID  -  KillerScan's DataGrid styling (MainWindow.xaml), ported rather than
         reinvented: this is the FIRST DataGrid in KillerShell (Tools/ProcessListControl.cs, the
         Task Manager tab's process list), so the row/cell/header treatment lives here rather
         than beside that one call site - any future grid in the app reuses these three keys
         instead of growing its own. Every brush is one already themed elsewhere in the app
         (TableHeaderBrush, MutedTextBrush, HeaderLineBrush, RowHoverBrush, RowAltBrush,
         RowSelectedBrush, PrimaryBrush, TextBrush) - nothing new was added to the palette.
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="DarkDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <!-- GridRowAltBrush, not RowAltBrush: identical on every ordinary theme (the token
                 mirrors it), but 98SE states its own solid stripe so the Events/Processes/
                 Registry tables read white-and-gray striped. -->
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource GridRowAltBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- GridSelectedTextBrush mirrors PrimaryBrush - exactly the accent this trigger
                 always set, so nothing changes on the ordinary themes. 98SE states WHITE: its
                 selected row is a solid navy block and PrimaryBrush IS that navy, which is what
                 made selected text unreadable in the Registry/Events/Processes tables. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GridSelectedTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sortable column header: TableHeaderBrush behind, MutedTextBrush type at 11, and the
         accent stripe underneath as a 1px HeaderLineBrush bottom border - the same treatment
         FilePane.xaml's own details-view header already carries, so a DataGrid header and the
         file-listing header read as the same furniture. Resize grippers are wired to the exact
         PART_ names WPF expects; a template that drops them silently kills column resizing. -->
    <Style x:Key="DarkDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="hdrBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <TextBlock x:Name="sortGlyph" Grid.Column="1"
                                           Text="&#x25B2;" FontSize="8"
                                           VerticalAlignment="Center" Margin="6,1,0,0"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Width="8" Margin="-4,0,0,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Ascending}">
                            <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sortGlyph" Property="Text" Value="&#x25B2;"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Descending}">
                            <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sortGlyph" Property="Text" Value="&#x25BC;"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
