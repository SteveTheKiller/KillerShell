<Window x:Class="KillerShell.FolderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:icons="clr-namespace:KillerShell.Controls"
        xmlns:picker="clr-namespace:KillerShell"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Str_Dlg_SelectFolder}"
        Width="980" Height="620" MinWidth="600" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Row, view and column styles live in Controls.xaml, shared with FileDialog. -->

<picker:PickerBorder x:Name="RootBorder" Tag="{DynamicResource UseDialogCaption}" Opacity="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource DialogOuterBorderThickness}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>  <!-- status bar, 98SE only -->
            </Grid.RowDefinitions>

            <!-- Shared film grain over the whole dialog surface -->
            <Border Grid.RowSpan="6" IsHitTestVisible="False"
                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>

            <!-- Raised dialog bevel, the same pair ConfirmDialog and ProcessDetailsDialog carry.
                 Both brushes are Transparent and both thicknesses 0 on every ordinary theme, so
                 this is inert on the twelve rounded ones and draws the full Win98 raised frame on
                 98SE. This picker was the last window in the app still missing it, so it came up
                 as a modern card while everything behind it was flat. -->
            <Border Grid.RowSpan="6" IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border Grid.RowSpan="6" IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}"  BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <Border Grid.RowSpan="6" IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border Grid.RowSpan="6" IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>


            <!-- Title bar -->
            <!-- DialogTitleBarBrush, not a literal Transparent: the token RESOLVES to Transparent
                 on every theme that does not ask for a caption band, so the twelve rounded themes
                 keep showing the card's own face here exactly as before. 98SE sets
                 UseDialogCaption, and ThemeManager then points this key at the accent's
                 TitleBarBrush, which is what gives the dialog a real Win98 caption. -->
            <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                <Grid>
                    <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <Grid Margin="16,0">
                    <!-- KillerScan-style wordmark: a blurred dark copy behind the crisp text,
                         faded by WordmarkShadowOpacity (off on 98SE). -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- The app icon leads the caption, as it does in the main title bar. -->
                        <icons:AppIcon x:Name="TitleIcon" VerticalAlignment="Center"
                               Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                               Margin="{DynamicResource TitleIconMargin}"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Grid VerticalAlignment="Center" Margin="0,-18,0,-22">
                            <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Visibility="{DynamicResource DialogWordmarkVisibility}"
                                        Opacity="{DynamicResource WordmarkShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                       Visibility="{DynamicResource DialogWordmarkVisibility}" Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                       Visibility="{DynamicResource DialogWordmarkVisibility}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shell" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                        </Grid>
                            <!-- Outside the wordmark grid so the wordmark's lift and bleed never move it. -->
                            <TextBlock Text="KillerShell" FontFamily="{DynamicResource ChromeFontFamily}" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"
                                       Visibility="{DynamicResource DialogPlainTitleVisibility}"/>
                        </StackPanel>
                    <!-- The family overlay and dialog close (Controls.xaml, OverlayCloseButton). -->
                    <Button Content="{DynamicResource AboutCloseGlyph}" Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                            ToolTip="{DynamicResource Str_Sys_Close}" AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                            Style="{StaticResource OverlayCloseButton}"/>
                </Grid>
                </Grid>
            </Border>

            <!-- DialogRowMargin: the 16px side inset, 3 on 98SE. -->
            <Border Grid.Row="1" Padding="{DynamicResource DialogRowMargin}">
                <TextBlock Text="{DynamicResource Str_Dlg_SelectFolder}" Margin="0,0,0,8"
                           Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12"/>
            </Border>

            <!-- Path row: up one level + current path + view modes -->
            <Border Grid.Row="2" Padding="{DynamicResource DialogRowMargin}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="UpButton" Grid.Column="0" Content="&#xE74A;" Click="Up_Click" ToolTip="{DynamicResource Str_TT_Up}"
                        Width="30" Height="28" Margin="0,0,6,0" FontSize="12" FontFamily="Segoe MDL2 Assets"
                        Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- ControlCornerRadius is 4 on all twelve rounded themes, the
                                 literal this replaces, and 0 on 98SE. -->
                            <Grid><Border x:Name="ubRing" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=ub}" BorderThickness="{Binding BorderThickness, ElementName=ub}" BorderBrush="{Binding Background, ElementName=ub}" Margin="{Binding Margin, ElementName=ub}" Visibility="{Binding Visibility, ElementName=ub}" Opacity="{Binding Opacity, ElementName=ub}"/><Border x:Name="ub" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border></Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ub" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox x:Name="PathBox" Grid.Column="1" Style="{StaticResource DialogPickerTextBox}" VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown"
                         AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="ViewListBtn"    Style="{StaticResource PickerViewBtn}" Content="&#xE8FD;" ToolTip="{DynamicResource Str_TT_ViewList}"    Click="ViewList_Click"/>
                    <Button x:Name="ViewIconsBtn"   Style="{StaticResource PickerViewBtn}" Content="&#xE80A;" ToolTip="{DynamicResource Str_TT_ViewIcons}"   Click="ViewIcons_Click"   Margin="2,0"/>
                    <Button x:Name="ViewDetailsBtn" Style="{StaticResource PickerViewBtn}" Content="&#xE700;" ToolTip="{DynamicResource Str_TT_ViewDetails}" Click="ViewDetails_Click"/>
                </StackPanel>
            </Grid>
            </Border>

            <!-- Main: quick places on the left, folder contents on the right -->
            <Grid Grid.Row="3" Margin="{DynamicResource DialogRowMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Picker clients use the content surface. Keep BackgroundBrush on the window
                     so relative full-window gradients do not restart inside either column. -->
                <!-- PanelCornerRadius is 6 on all twelve rounded themes, the literal it replaces
                     here and on the results pane below, and 0 on 98SE - where a client area is a
                     square white well, never a rounded card. -->
                <Border Grid.Column="0" Background="{DynamicResource FileDialogPaneBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                  <Grid>
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                            Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                    <ListBox x:Name="PlacesList" Background="Transparent" BorderThickness="0" Padding="2,4"
                             ItemContainerStyle="{StaticResource PickerPlaceRow}" SelectionChanged="Places_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource PickerRowContent}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource FileDialogPaneBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                  <Grid>
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                            Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                    <DockPanel>
                        <!-- Sortable column headers - details view only -->
                        <Grid DockPanel.Dock="Top" x:Name="DetailsHeader" Visibility="Collapsed" Margin="12,4,26,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PickerColBtn}" Click="SortName_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Name}"/>
                                    <TextBlock x:Name="NameArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,1,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource PickerColBtn}" HorizontalContentAlignment="Right" Click="SortSize_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Size}"/>
                                    <TextBlock x:Name="SizeArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,1,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource PickerColBtn}" Margin="10,0,0,0" Click="SortModified_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Modified}"/>
                                    <TextBlock x:Name="ModArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,1,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid>
                            <!-- PanelListCols + the two scroll directions, matching what
                                 ApplyView sets for list view: PanelStack with horizontal
                                 scrolling DISABLED gave the pane one tall single column until
                                 the first view-button press (2026-08-09). ApplyView owns both
                                 from then on; these are just the same starting state. -->
                            <ListBox x:Name="FolderList" Background="Transparent" BorderThickness="0" Padding="2,4"
                                     AutomationProperties.Name="{DynamicResource Str_Col_Name}"
                                     ItemContainerStyle="{StaticResource PickerRow}"
                                     ItemTemplate="{StaticResource RowTemplate}"
                                     ItemsPanel="{StaticResource PanelListCols}"
                                     SelectionChanged="Folders_SelectionChanged" MouseDoubleClick="Folders_DoubleClick"
                                     PreviewMouseWheel="FolderList_PreviewMouseWheel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                            <TextBlock x:Name="EmptyHint" Text="{DynamicResource Str_Dlg_NoSubfolders}" Visibility="Collapsed"
                                       Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20"/>
                        </Grid>
                    </DockPanel>
                  </Grid>
                </Border>
            </Grid>

            <!-- Buttons: selection details on the left, actions on the right. On 98SE the
                 selection moves into the status bar below and this row is just the actions. -->
            <Grid Grid.Row="4" Margin="{DynamicResource DialogButtonsMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{DynamicResource DialogInlineSelVisibility}">
                    <TextBlock x:Name="SelName" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SelMeta" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Str_Btn_Cancel}" Style="{StaticResource SurfaceButton}" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="{DynamicResource Str_Btn_Select}" Style="{StaticResource OutlineButton}" Width="90" Click="OK_Click"/>
                </StackPanel>
            </Grid>

            <!-- ==== Status bar, 98SE only ====
                 A Win32 file dialog shows the selection in a status bar at the bottom; the
                 family's floating card shows it beside the buttons. DialogStatusBarHeight and
                 DialogStatusBarVisibility are 0 and Collapsed on the other twelve themes, so this
                 row does not exist there and SelName / SelMeta stay in the button row. The cells
                 mirror SelName / SelMeta by binding, so the code keeps one pair to write to.
                 Cell margins, padding and bevels are the main window footer's Footer* keys. -->
            <Border Grid.Row="5" Height="{DynamicResource DialogStatusBarHeight}"
                    Visibility="{DynamicResource DialogStatusBarVisibility}"
                    Background="{DynamicResource BackgroundBrush}">
                <Grid Margin="{DynamicResource FooterPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cell 1: the selected entry's name. -->
                    <Grid Grid.Column="0" Margin="{DynamicResource FooterCellMargin}">
                        <Border Panel.ZIndex="2" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                                BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                        <Border Panel.ZIndex="2" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FooterBevelLightBrush}"
                                BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                        <TextBlock Text="{Binding Text, ElementName=SelName}"
                                   Margin="{DynamicResource FooterCellPadding}"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Cell 2: its size and date, with the resize grip in its bottom-right
                         corner, where Win98 draws it. -->
                    <Grid Grid.Column="1" MinWidth="160" Margin="{DynamicResource FooterCellMargin}">
                        <Border Panel.ZIndex="2" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                                BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                        <Border Panel.ZIndex="2" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FooterBevelLightBrush}"
                                BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                        <TextBlock Text="{Binding Text, ElementName=SelMeta}"
                                   Margin="{DynamicResource FooterCellPadding}" Padding="0,0,14,0"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- The same two grips as the main window footer, on the same keys. -->
                        <Canvas Panel.ZIndex="3" Width="13" Height="13"
                                Visibility="{DynamicResource GripDotsVisibility}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"
                                Background="Transparent" Cursor="SizeNWSE"
                                MouseLeftButtonDown="ResizeGrip_MouseDown">
                            <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                            <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                            <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                            <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                        </Canvas>
                        <Canvas Panel.ZIndex="3" Width="13" Height="13"
                                Visibility="{DynamicResource GripLinesVisibility}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"
                                Background="Transparent" Cursor="SizeNWSE" SnapsToDevicePixels="True"
                                MouseLeftButtonDown="ResizeGrip_MouseDown">
                            <Line X1="12" Y1="1"  X2="1"  Y2="12" Stroke="{DynamicResource FrameOuterDarkBrush}"  StrokeThickness="1"/>
                            <Line X1="11" Y1="1"  X2="1"  Y2="11" Stroke="{DynamicResource FrameOuterLightBrush}" StrokeThickness="1"/>
                            <Line X1="12" Y1="5"  X2="5"  Y2="12" Stroke="{DynamicResource FrameOuterDarkBrush}"  StrokeThickness="1"/>
                            <Line X1="11" Y1="5"  X2="5"  Y2="11" Stroke="{DynamicResource FrameOuterLightBrush}" StrokeThickness="1"/>
                            <Line X1="12" Y1="9"  X2="9"  Y2="12" Stroke="{DynamicResource FrameOuterDarkBrush}"  StrokeThickness="1"/>
                            <Line X1="11" Y1="9"  X2="9"  Y2="11" Stroke="{DynamicResource FrameOuterLightBrush}" StrokeThickness="1"/>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </picker:PickerBorder>
</Window>
