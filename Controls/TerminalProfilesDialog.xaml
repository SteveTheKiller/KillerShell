<Window x:Class="KillerShell.TerminalProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KillerShell" Width="720" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="RootBorder" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Margin="{DynamicResource DialogHaloMargin}">
        <Grid>
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel><Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="0" Click="Cancel_Click" Style="{StaticResource SurfaceButton}" Width="28"/>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15" VerticalAlignment="Center"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock></DockPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,16">
                    <TextBlock Text="{DynamicResource Str_Term_Profiles}" Foreground="{DynamicResource TextBrush}" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Str_Term_ProfileHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <ListBox x:Name="ProfilesList" DisplayMemberPath="Name" Height="280" SelectionChanged="ProfilesList_SelectionChanged" Background="{DynamicResource TextFieldBrush}" Foreground="{DynamicResource TextBrush}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{DynamicResource Str_Term_AddProfile}" Click="Add_Click" Style="{StaticResource SurfaceButton}" Margin="0,0,6,6"/>
                            <Button x:Name="RemoveBtn" Content="{DynamicResource Str_Term_RemoveProfile}" Click="Remove_Click" Style="{StaticResource SurfaceButton}" Margin="0,0,0,6"/>
                            <Button Content="{DynamicResource Str_Term_MoveUp}" Click="Up_Click" Style="{StaticResource SurfaceButton}" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Str_Term_MoveDown}" Click="Down_Click" Style="{StaticResource SurfaceButton}"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,5,0,3"/></Style>
                            <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource TextFieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Padding" Value="5"/></Style>
                            <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{DynamicResource Str_Term_ProfileName}"/><TextBox x:Name="NameBox"/>
                        <TextBlock Text="{DynamicResource Str_Term_Executable}"/><TextBox x:Name="ExeBox"/>
                        <TextBlock Text="{DynamicResource Str_Term_Arguments}"/><TextBox x:Name="ArgsBox"/>
                        <TextBlock Text="{DynamicResource Str_Term_ShellType}"/>
                        <ComboBox x:Name="KindBox" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Str_Term_Custom}" Tag="Custom"/>
                            <ComboBoxItem Content="{DynamicResource Str_Term_PowerShell}" Tag="PowerShell"/>
                            <ComboBoxItem Content="{DynamicResource Str_Term_Cmd}" Tag="Cmd"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Str_Term_StartFolder}"/><TextBox x:Name="FolderBox"/>
                        <CheckBox x:Name="DefaultBox" Content="{DynamicResource Str_Term_DefaultProfile}"/>
                        <CheckBox x:Name="HiddenBox" Content="{DynamicResource Str_Term_HideProfile}"/>
                        <CheckBox x:Name="AdminBox" Content="{DynamicResource Str_Term_RunElevated}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Style="{StaticResource SurfaceButton}" MinWidth="86" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Str_Term_ProfileSave}" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="86"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
