<Window x:Class="KillerShell.ServiceDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Service Details"
        Width="720" SizeToContent="Height" MinWidth="560" MinHeight="260" MaxWidth="1400" MaxHeight="800"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <!-- Same trimmed EventDetailsDialog shape ProcessDetailsDialog.xaml uses, for the Services
         view of the same Processes/Services tab (Tools/ProcessListControl.cs). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Opacity="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <!-- BodyRow starts Auto and becomes Star after the first render
                 (Controls/DialogContentSize.cs). Auto is what SizeToContent="Height" above needs,
                 since a Star row measured against an infinite height collapses to zero - but an
                 Auto row also hands its child an infinite height, so the ScrollViewer in it can
                 never show a scrollbar and simply overflows the window once the height is capped
                 or the user drags the frame. Auto is therefore only used to decide the OPENING
                 size, and the row is released to Star once that is settled. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition x:Name="BodyRow" Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" IsHitTestVisible="False"
                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
            <!-- Raised dialog bevel + caption band, same as ProcessDetailsDialog - inert on
                 every ordinary theme, the Win98 dialog treatment on 98SE. -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}"  BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>

            <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Grid VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15" Margin="1,2,0,0" Opacity="{DynamicResource IconShadowOpacity}">
                                <TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect>
                                <Run Text="Killer" Foreground="#D8000000"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/>
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15">
                                <Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str_Svc_DetailsTitle}" FontFamily="Consolas" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,3,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="NavPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="0,0,40,0">
                        <Button x:Name="PrevBtn" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_SvcPrev}" Margin="0,0,4,0" Click="Prev_Click"/>
                        <Button x:Name="NextBtn" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_SvcNext}" Click="Next_Click"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="Close_Click" HorizontalAlignment="Right" Width="30" Height="26" FontSize="10"
                            FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="xb" Background="Transparent" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                    <Setter TargetName="xb" Property="Background" Value="#33C42B1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{DynamicResource PaneBrush}" CornerRadius="4" Padding="14,12,14,6">
                        <Grid>
                            <!-- Margin cancels the parent Border's Padding - see the same line
                                 in ProcessDetailsDialog. Without it the grain stops short of the
                                 card edges and a bare PaneBrush ring frames the panel. -->
                            <Border IsHitTestVisible="False" CornerRadius="4" Margin="-14,-12,-14,-6"
                                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                            <StackPanel x:Name="FieldsPanel"/>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- E8C8 (Copy, two documents), not E71B (Link, a chain). -->
                    <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                            ToolTip="{DynamicResource Str_TT_SvcCopyDetails}" Margin="0,0,8,0" Click="CopyDetails_Click"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                            ToolTip="{DynamicResource Str_TT_SvcClose}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
