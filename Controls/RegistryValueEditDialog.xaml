<Window x:Class="KillerShell.RegistryValueEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KillerShell"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!-- Same chrome as ConfirmDialog.xaml/RegistryInputDialog.xaml. ONE dialog that adapts its
         input control to the value's RegistryValueKind (RegistryEditorControl.cs Grid_MouseDoubleClick
         / ModifySelectedValue) rather than five separate dialog classes - only ever one of the
         four input panels below is visible at a time. Requires an explicit Save click; there is
         no auto-save on focus-lost anywhere in this dialog (CLAUDE.md safety rule for this
         feature) - tabbing away from a half-typed edit must never silently write bad data. -->
    <Border x:Name="RootBorder" Opacity="0"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" CornerRadius="6"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource IconShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="Killer" Foreground="#D8000000"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                        </Grid>
                        <Button Content="&#x2715;" Click="Cancel_Click" HorizontalAlignment="Right"
                                Width="28" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                        <Setter TargetName="bg" Property="Background" Value="#33C42B1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="NameText" Foreground="{DynamicResource DimTextBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,0,2"/>
                    <TextBlock x:Name="KindText" Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas" FontSize="13" Margin="0,0,0,14"/>

                    <!-- REG_SZ / REG_EXPAND_SZ -->
                    <StackPanel x:Name="StringPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Str_RegEd_ValueData}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="StringBox" Style="{StaticResource DarkTextBox}"
                                 FontFamily="Consolas" FontSize="12.5"/>
                    </StackPanel>

                    <!-- REG_MULTI_SZ -->
                    <StackPanel x:Name="MultiStringPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Str_RegEd_MultiHint}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="MultiStringBox" Style="{StaticResource DarkTextBox}"
                                 FontFamily="Consolas" FontSize="12.5"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="140" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <!-- REG_DWORD / REG_QWORD -->
                    <StackPanel x:Name="NumberPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Str_RegEd_ValueData}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NumberBox" Style="{StaticResource DarkTextBox}"
                                 FontFamily="Consolas" FontSize="12.5" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str_RegEd_Base}" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="HexRadio" GroupName="NumBase" IsChecked="True"
                                         Content="{DynamicResource Str_RegEd_Hexadecimal}"
                                         Foreground="{DynamicResource TextBrush}"
                                         Checked="NumberBase_Changed" Margin="0,0,16,0"/>
                            <RadioButton x:Name="DecRadio" GroupName="NumBase"
                                         Content="{DynamicResource Str_RegEd_Decimal}"
                                         Foreground="{DynamicResource TextBrush}"
                                         Checked="NumberBase_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- REG_BINARY -->
                    <StackPanel x:Name="BinaryPanel" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Str_RegEd_BinaryHint}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="BinaryBox" Style="{StaticResource DarkTextBox}"
                                 FontFamily="Consolas" FontSize="12.5"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="100" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerRed}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}"
                            MinWidth="86" Margin="0,0,8,0"/>
                    <Button x:Name="OkBtn" Content="{DynamicResource Str_RegEd_Save}" Click="OK_Click"
                            Style="{StaticResource OutlineButton}"
                            MinWidth="86"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
