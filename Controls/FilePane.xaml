<!-- One browsing/results pane: tab strip, location row, toolbar, and the results list in
     whichever of the three views is current.

     Extracted from MainWindow.xaml so the window can host TWO of these side by side. The
     markup is UNCHANGED from the single-pane version - same names, same handlers, same
     structure - because two copies of a 600-line pane would drift apart the same way the
     two panel-slide animations did before PanelSlide.cs.

     Handlers resolve against THIS class, not MainWindow, so FilePane.xaml.cs carries a
     forwarder per handler back to its owning window. That is the whole cost of the split:
     the pane owns no logic of its own. -->
<UserControl x:Class="KillerShell.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KillerShell"
             xmlns:svc="clr-namespace:KillerShell.Services"
             xmlns:shellns="clr-namespace:KillerShell.Shell"
             xmlns:models="clr-namespace:KillerShell.Models">

            <UserControl.Resources>
                <!-- Turns the TabChamfer theme scalar into the tab's clip geometry. Win98 tabs cut
                     their top corners at 45 degrees, which a CornerRadius cannot express at all.
                     Returns null when the scalar is 0, so no other theme is clipped. -->
                <local:TabChamferConverter x:Key="TabChamferConv"/>

                <!-- Right-click on any of the pane's menu bars - the folder location row, the
                     shell bar, the editor bar. One shared instance; PlacementTarget follows
                     whichever bar opened it. This is how the hide is DISCOVERED: Ctrl+F10 is the
                     only way back once the bar is gone, so the gesture text here is the menu
                     item's real payload. -->
                <ContextMenu x:Key="BarMenu">
                    <MenuItem Header="{DynamicResource Str_Menu_HideMenuBar}" InputGestureText="Ctrl+F10"
                              Click="BarHideMenu_Click">
                        <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7B3;"/></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </UserControl.Resources>

            <Grid>
              <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Tab band: hidden until there are 2+ tabs (like KillerPDF). Opaque + its own
                   grain so the strip reads as one textured band with the tabs sitting on it. -->
              <!-- ZIndex 20 so the strip draws ABOVE the pane. Without it the pane wins on
                   declaration order alone, and the 1px the pane is pulled up by (its -1 top
                   margin) lands its border ON TOP of the strip instead of behind it - which is
                   exactly the hairline that kept showing under the active tab. -->
              <!-- The band is the WINDOW background, and so are the inactive tabs, so the strip
                   simply disappears into the app behind it and only the active tab reads as a
                   surface. Briefly moved to MenuBackgroundBrush; that lifted the band a step
                   above the tabs sitting on it, and the tabs' 3px top margin turned into a
                   visible gray line above every one of them. -->
              <!-- TRANSPARENT, never BackgroundBrush. On Sepulchre, Decay, Delirium, Ectoplasm
                   and Malaise that key is a full-window LinearGradientBrush, so painting it here
                   re-ramped the ENTIRE window gradient inside the band's own width - a visible
                   strip of mismatched gradient above every tab. Transparent lets the window's
                   one continuous gradient show through, which is the only way the band can line
                   up with the window it sits on. -->
              <!-- Same story as the pane's own margin below: 0,6,8,0 on the rounded themes, all
                   zeros on a flat one. The 8 on the right made the strip narrower than the window
                   on that side only, and the 6 on top was the last gap left between the caption
                   and the client area once ContentPaneMargin went to 0. -->
              <Border Grid.Row="0" x:Name="TabBar" Panel.ZIndex="20" Margin="{DynamicResource TabBarMargin}"
                      Background="Transparent" Visibility="Collapsed"
                      SizeChanged="TabBar_SizeChanged">
               <Grid>
                <!-- NO grain layer of the band's own. ScaleHost's row-wide grain (MainWindow.xaml)
                     already covers this area, so a second tile here DOUBLED the texture across the
                     band and the transparent inactive tabs - the inactive tabs ended up with a
                     different texture than the main bg. The ACTIVE tab still carries
                     its own layer, because its opaque fill hides the shared one. -->
                <!-- The line across the top of the pane: PaneBorderBrush normally, the accent
                     when this pane has focus (DualPane.cs), exactly mirroring the pane border
                     it continues.
                     A 1px strip INSIDE the band, not a BorderThickness on TabBar itself: a
                     Border draws its own border outside the content area, so the active tab
                     could never reach it and the accent ran straight under the tab, boxing it
                     in instead of joining it to the pane.
                     Declared before the tabs so they paint over it. Every tab carries a 1px
                     bottom margin that keeps it clear of this line; the ACTIVE tab alone drops
                     that margin and covers its own segment, which is what breaks the line
                     exactly at the tab - the browser-tab join.
                     Declared after the band's shadow gradient too, or the gradient's 35% black
                     bottom would wash the accent out. -->
                <!-- KillerPDF's tab-strip fade: shadow rising from the pane below, so the band
                     darkens toward the bottom and the tabs read as sitting in front of it.
                     The horizontal OpacityMask cross-fades the shadow out at both ends so it
                     dissolves toward the corners instead of cutting off in a straight line. -->
                <!-- Opacity from the theme: 0 on a flat theme, so 98SE's tab strip is genuinely
                     flat. This gradient is a SHADOW, and it was hardcoded - which is why the tabs
                     still looked shadowed on 98SE after the tab's own DropShadowEffect was made
                     theme-driven. -->
                <Border IsHitTestVisible="False" Opacity="{DynamicResource BarShadowOpacity}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.45"/>
                            <GradientStop Color="#59000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#FFFFFFFF" Offset="0.06"/>
                            <GradientStop Color="#FFFFFFFF" Offset="0.94"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <!-- Not a flat 1px strip: the pane's top corners are rounded under an INACTIVE
                     tab (Tabs.cs), and a straight line ran past the curve and stopped dead at
                     the pane's outer edge. This is the pane's top border drawn again, radii and
                     all - 7px tall with a -6 bottom margin, so its 1px TOP edge lands in the
                     band's last row and its curved sides drop out of the band and land exactly
                     on the pane's own left/right border, same brush, same pixels. Tabs.cs keeps
                     the radii in step with the pane's. -->
                <!-- PaneEdgeBrush, which a flat theme sets TRANSPARENT: on 98SE the tab's own
                     bevel and the pane's bevel already describe the join, and this extra 1px rule
                     drew as a gray line between the active tab and the content below it. Every
                     other theme keeps the ring exactly as before. -->
                <Border x:Name="TabBarRing" Height="7" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                        BorderThickness="1,1,1,0" CornerRadius="{DynamicResource TabCornerRadius}" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource PaneEdgeBrush}"/>
                <DockPanel LastChildFill="True">
                <!-- Overflow chevron: every tab in this pane, hidden ones included (Tabs.cs
                     TabOverflowMenu). Docked BEFORE the strip so the strip's remaining width is
                     what the ScrollViewer measures against - docked after, the strip would take
                     the whole band and the chevron would sit on top of the last tab.
                     Collapsed while everything fits, which is the normal case: a chevron that is
                     always there is a control that does nothing most of the time, and its 26px
                     would be taken out of the tabs to say so. -->
                <Button x:Name="TabOverflowBtn" DockPanel.Dock="Right" Visibility="Collapsed"
                        Style="{StaticResource GrungeCalendarNavButton}"
                        Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Foreground="{DynamicResource MutedTextBrush}"
                        Width="22" Height="20" Margin="2,4,2,3" VerticalAlignment="Center"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="{DynamicResource Str_TT_TabOverflow}" Click="TabOverflow_Click"/>
                <!-- Horizontal scrolling is DISABLED, not hidden: hidden still measures the
                     content at infinite width, which would let the tabs size to their own
                     content and defeat the UniformGrid below. Disabled constrains them to the
                     bar's actual width, which is the point. -->
                <!-- FocusVisualStyle nulled: a ScrollViewer is focusable, and once focus lands
                     here WPF draws its stock dotted rectangle around the whole strip. -->
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}">
                    <ItemsControl x:Name="TabStrip">
                        <!-- The ACTIVE tab draws above its neighbors. Items paint in index
                             order, so the tab to the right of the active one was painting over
                             the active tab's 1px right border and the ring stopped dead at that
                             side - which is why a middle tab lost its right edge while the last
                             tab, having no neighbor after it, kept both. Raising the container
                             makes the raised tab's whole outline (and its shadow) land on top,
                             which is what a browser tab strip does anyway. -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1"/>
                                    </DataTrigger>
                                    <!-- Windowed out of the strip and living in the chevron
                                         instead (Tabs.cs ApplyTabWindow). Collapsed rather than
                                         removed from the collection, which is what makes this
                                         cheap: UniformGrid does not count a collapsed child when
                                         it divides the band, so the survivors fill it edge to
                                         edge on their own, and nothing about the tabs' order,
                                         their drag indices or the session's idea of them moves. -->
                                    <DataTrigger Binding="{Binding IsStripVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <!-- Tabs share the bar equally and fill it, browser-style, instead of
                                 hugging their titles and leaving dead space on the right. -->
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SearchTab}">
                                <!-- No MaxWidth: it would cap each cell and put the dead space
                                     back. The MinWidth floor is low so a lot of open tabs still
                                     divide the bar rather than overflowing it. -->
                                <!-- CornerRadius matches the pane's 6, not the 4 it used to be:
                                     the rightmost tab sits directly above the pane's top-right
                                     corner, and a 4px curve stacked on a 6px one reads as a
                                     mistake rather than as two rounded things. -->
                                <!-- No right MARGIN: the 1px right BorderThickness below already
                                     separates one tab from the next, and the margin only served
                                     to stop the last tab reaching the strip's right edge - which
                                     is the pane's edge, so it left a 1px step under the corner. -->
                                <!-- 1px bottom margin keeps an inactive tab clear of the ring
                                     line at the foot of the band; the active tab drops it and
                                     covers its own segment. -->
                                <!-- TabPadding, not the literal 12,4,5,5: 98SE trims the bottom by
                                     one so the tab sits about a pixel shorter, which is the Win98
                                     proportion that goes alongside the chamfer. -->
                                <Border x:Name="tabBd" CornerRadius="{DynamicResource TabCornerRadius}" Margin="{DynamicResource TabMargin}" Padding="{DynamicResource TabPadding}"
                                        MinWidth="60"
                                        Tag="{DynamicResource TabChamfer}"
                                        Cursor="Hand" Background="Transparent"
                                        BorderThickness="0,0,1,0"
                                        BorderBrush="{DynamicResource PaneEdgeBrush}"
                                        MouseDown="Tab_MouseDown"
                                        PreviewMouseLeftButtonDown="Tab_DragDown"
                                        PreviewMouseMove="Tab_DragMove"
                                        PreviewMouseLeftButtonUp="Tab_DragUp">
                                    <!-- The Win98 chamfer. Null geometry on every theme whose
                                         TabChamfer is 0, so only the flat theme is clipped at all.
                                         The geometry deliberately runs past the tab's foot so the
                                         bevels' negative bottom margin (TabBevelMargin) survives
                                         the clip - only the TOP corners are meant to be cut. -->
                                    <Border.Clip>
                                        <MultiBinding Converter="{StaticResource TabChamferConv}">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </Border.Clip>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Str_Menu_PipeTab}"
                                                      Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="PipeTab_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <!-- Grain follows the tab's radius, or the texture squares
                                             off the corner the border just rounded. -->
                                        <!-- Opacity 0 by default: an INACTIVE tab is transparent, so
                                             it already shows the band's grain through it, and its
                                             own layer on top doubled the texture - the tabs read
                                             visibly grainier than the strip they sit in. The
                                             ACTIVE tab is an opaque PaneBrush
                                             fill that hides the band, so the IsActive trigger
                                             below turns this back on for that one. -->
                                        <Border x:Name="tabGrain" IsHitTestVisible="False"
                                                CornerRadius="{DynamicResource TabCornerRadius}" Margin="-12,-4,-5,-5"
                                                Background="{DynamicResource GrainTileBrush}" Opacity="0"/>
                                        <!-- Win98 tab bevel: light along the top and left, dark
                                             down the right. A Win98 tab is a raised control, not
                                             a flat card. The margins undo the
                                             tab's padding so the bevel sits on its real edges.
                                             Zero-thickness and transparent on the other twelve. -->
                                        <!-- TabBevelMargin, not the literal -12,-4,-5,-5 it used to
                                             be. The bottom slot decides how far the bevel's right
                                             edge hangs below the tab, and the pane now rides up by
                                             the page bevel's full 2px (PaneOuterMargin), so on a
                                             flat theme that overhang showed one pixel of dark line
                                             below the tab's foot. Default is
                                             exactly the old literal. -->
                                        <Border x:Name="tabBevelLight" IsHitTestVisible="False" Margin="{DynamicResource TabBevelMargin}" Panel.ZIndex="4"
                                                BorderBrush="{DynamicResource BevelLightBrush}"
                                                BorderThickness="{DynamicResource BevelLightThickness}"/>
                                        <!-- TabInactiveBevelDarkThickness, not the shared
                                             BevelDarkThickness. That key is 0,0,2,2, so an
                                             INACTIVE tab drew a 2px dark band along its foot, and
                                             a doubled line under the tabs is what made the menu bar
                                             below them read as sunken when it is not. An unselected
                                             Win98 tab has a SINGLE line under it. -->
                                        <Border x:Name="tabBevelDark" IsHitTestVisible="False" Margin="{DynamicResource TabBevelMargin}" Panel.ZIndex="4"
                                                BorderBrush="{DynamicResource BevelDarkBrush}"
                                                BorderThickness="{DynamicResource TabInactiveBevelDarkThickness}"/>
                                        <!-- ACTIVE only (IsActive trigger): the 2x2 white corner
                                             patch that lets the menu bar's white top line run
                                             UNDER the active tab's dark right edge, the same
                                             junction every inactive seam has. Transparent on
                                             every theme but 98SE - see TabSeamPatchBrush. -->
                                        <Border x:Name="tabSeamPatch" IsHitTestVisible="False" Panel.ZIndex="5"
                                                Width="2" Height="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,-5,-4" Visibility="Collapsed"
                                                Background="{DynamicResource TabSeamPatchBrush}"/>
                                        <DockPanel LastChildFill="True">
                                            <!-- Nulled here rather than on the shared DangerButton style,
                                                 which the term and filter x's also use. -->
                                            <Button DockPanel.Dock="Right" Content="x" Style="{StaticResource DangerButton}" Width="18" Height="18" Margin="6,0,0,0"
                                                    FocusVisualStyle="{x:Null}"
                                                    ToolTip="{DynamicResource Str_TT_CloseTab}" Tag="{Binding}" Click="CloseTab_Click"/>
                                            <!-- A browsing tab's real Windows folder icon
                                                 (TabFolderIconConverter) - the same source the
                                                 overflow dropdown already uses. Width/Height
                                                 pinned to 14 like the overflow dropdown pins its
                                                 own Image to 16 - IconCache's px parameter picks
                                                 which shell icon LIST to pull from (32px/48px/
                                                 256px), not the bitmap's actual pixel size, so an
                                                 unconstrained Image rendered at whatever that
                                                 list's real icon size happens to be on the
                                                 machine - the tabs turned into
                                                 giant folders. Stretch=Uniform downscales
                                                 cleanly regardless. Visibility, not size, is what
                                                 makes a null Source (not a folder tab) take no
                                                 room - the collapse trigger below. -->
                                            <Image x:Name="tabFolderIcon" DockPanel.Dock="Left"
                                                   Width="20" Height="20" Stretch="Uniform"
                                                   Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Source="{Binding Converter={StaticResource TabFolderIcon}}"/>
                                            <!-- Shell tabs carry a glyph so a terminal is not
                                                 mistaken for a folder at a glance. Collapsed
                                                 for every other kind of tab, so nothing about
                                                 a folder tab moves. -->
                                            <TextBlock x:Name="tabGlyph" DockPanel.Dock="Left"
                                                       Text="{Binding TabGlyph}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock x:Name="tabLbl" Text="{Binding Title}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding TabGlyph}" Value="">
                                        <Setter TargetName="tabGlyph" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- No art for this tab kind (a search tab): hide the Image and
                                         let the MDL2 glyph above stand in. Every other kind now
                                         resolves to a brand icon, so the glyph is the exception
                                         rather than the rule. -->
                                    <DataTrigger Binding="{Binding Converter={StaticResource TabFolderIcon}}" Value="{x:Null}">
                                        <Setter TargetName="tabFolderIcon" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- ...and where there IS art, drop the glyph, or a shell tab
                                         would carry both its picture and its Segoe character. -->
                                    <DataTrigger Binding="{Binding Converter={StaticResource TabHasArt}}" Value="True">
                                        <Setter TargetName="tabGlyph" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- Last tab drops its right border: that 1px is a divider
                                         BETWEEN tabs, and on the strip's right edge it reads as a
                                         stray rule instead. Declared BEFORE the IsActive trigger
                                         so the active tab's accent-stripe thickness still wins
                                         when the last tab is also the active one. -->
                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                        <Setter TargetName="tabBd" Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource PaneBrush}"/>
                                        <!-- Only the active tab draws its own grain - it is opaque,
                                             so it hides the band's layer and needs to replace it. -->
                                        <Setter TargetName="tabGrain" Property="Opacity" Value="{DynamicResource GrainOpacity}"/>
                                        <!-- The accent stripe is theme-driven now: 3px on top by
                                             default, 0 on a flat theme. A Win98 tab is identified
                                             by its bevel and by being joined to the pane, not by
                                             a colored bar across the top. -->
                                        <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabStripeThickness}"/>
                                        <!-- Reaches the foot of the band so its own fill breaks
                                             the ring line where the tab is - that break is what
                                             joins the tab to the content below it. -->
                                        <Setter TargetName="tabBd" Property="Margin" Value="0,3,0,0"/>
                                        <!-- OPEN BOTTOM. The tab's dark bevel is 0,0,2,2 - right AND
                                             bottom - so the active tab was drawing a 2px gray rule
                                             along its own foot, directly between itself and the
                                             content. That rule is the line that kept showing under
                                             the active tab, and no amount of work on the ring above
                                             or the pane below could remove it, because it belonged
                                             to the tab.
                                             A selected Win98 tab has no bottom edge at all: the
                                             bevel runs top, left and right, and the bottom is open
                                             into the page, which is what makes the two read as one
                                             surface. TabActiveBevelDarkThickness is 0,0,2,0 on 98SE
                                             and 0 everywhere else, where the bevel is 0 regardless. -->
                                        <Setter TargetName="tabBevelDark" Property="BorderThickness" Value="{DynamicResource TabActiveBevelDarkThickness}"/>
                                        <!-- TabActiveBevelDarkMargin: on 98SE the active tab's
                                             dark right edge stops where the menu bar's white top
                                             line begins instead of running 2px through it. The
                                             default is the family TabBevelMargin literal, and
                                             every other theme draws no bevel anyway. -->
                                        <Setter TargetName="tabBevelDark" Property="Margin" Value="{DynamicResource TabActiveBevelDarkMargin}"/>
                                        <Setter TargetName="tabSeamPatch" Property="Visibility" Value="Visible"/>
                                        <!-- Top padding gives back the 3px the accent stripe takes,
                                             so the title doesn't drop when a tab activates. -->
                                        <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabActivePadding}"/>
                                        <!-- TabActiveRingBrush, not PrimaryBrush: it mirrors
                                             PrimaryBrush on every ordinary theme, but 98SE states
                                             it Transparent - the dual-pane focus ring (the 3px
                                             stripe the PaneFocused triggers below hardcode, and
                                             the band's TabEdge verticals) drew in the accent on a
                                             theme whose tabs are marked by bevel alone. The
                                             trigger THICKNESSES stay:
                                             with a transparent brush they paint nothing and the
                                             padding compensation still holds the title steady. -->
                                        <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource TabActiveRingBrush}"/>
                                        <!-- BarShadowEffect, built per palette in ThemeManager and
                                             NULL on a flat theme - a hardcoded effect here kept
                                             the active tab casting a shadow on 98SE, which has
                                             none anywhere. -->
                                        <Setter TargetName="tabBd" Property="Effect" Value="{DynamicResource BarShadowEffect}"/>
                                        <Setter TargetName="tabLbl" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <!-- Bold Consolas at 11px is nearly indistinguishable in Display mode;
                                             the half-point bump makes the active weight actually read as bold. -->
                                        <Setter TargetName="tabLbl" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="tabLbl" Property="FontSize" Value="11.5"/>
                                    </DataTrigger>
                                    <!-- Unfocused pane: the lip drops off the accent entirely and
                                         takes the pane's own border color, so the whole unlit
                                         ring - lip, band line and pane border - is ONE value. At
                                         full accent both panes claimed to be the live one.
                                         It was TabEdgeBrush (the accent at 40%), which is the
                                         right idea and the wrong number: over this band that
                                         blends to about #196033 against a PaneBorderBrush of
                                         #0f4a30 - near enough to read as the same green rendered
                                         wrong rather than as a deliberate step down. Two 1px
                                         lines meeting at almost the same color is the worst of
                                         both; either match or differ, do not nearly match.
                                         The active tab is still obvious on an unfocused pane
                                         from its PaneBrush fill and bold title, which is how a
                                         browser marks it too. Mutually exclusive with
                                         PaneFocused below. -->
                                    <DataTrigger Binding="{Binding PaneDimmed}" Value="True">
                                        <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource PaneBorderBrush}"/>
                                    </DataTrigger>
                                    <!-- Focused pane: the ring continues UP both sides of the
                                         active tab, so the tab and the pane read as one outlined
                                         surface instead of the ring stopping dead at the strip.
                                         Declared LAST on purpose - PaneFocused implies IsActive,
                                         both triggers match, and with multiple matches the last
                                         one wins. Put earlier, IsActive would overwrite the
                                         thickness straight back to a top-only stripe.
                                         Padding drops 1px each side to pay for the new borders,
                                         so the title does not shift when focus arrives. -->
                                    <!-- All four focused-state thickness/padding pairs are theme
                                         tokens now, defaulting to exactly the literals they
                                         replaced. On 98SE every thickness is 0 and every padding
                                         is the active tab's own: the ring brush there is
                                         transparent, and a transparent 1px border still kept the
                                         tab's fill out of its own edge column - which let the menu
                                         bar's white top line show through as a single white pixel
                                         at the tab's right edge. -->
                                    <DataTrigger Binding="{Binding PaneFocused}" Value="True">
                                        <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabFocusThickness}"/>
                                        <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabFocusPadding}"/>
                                    </DataTrigger>
                                    <!-- The OUTERMOST side is the band's to draw (TabEdgeLeft /
                                         TabEdgeRight below), so the first and last tab must not
                                         draw it as well. Two 1px borders at the same x is a 2px
                                         edge on a ring that is 1px everywhere else - and only
                                         SOMETIMES, because whether the tab's own outer border
                                         clears the ScrollViewer's clip depends on how the
                                         UniformGrid divided a fractional band width. That is
                                         where the halo came out uneven, and why it changed when
                                         the split moved.
                                         The padding gives the pixel back on that side so the
                                         title does not shift, exactly as PaneFocused does.
                                         Declared after PaneFocused - all three match on a first
                                         or last tab and the last match wins. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PaneFocused}" Value="True"/>
                                            <Condition Binding="{Binding IsFirst}"     Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabFocusFirstThickness}"/>
                                        <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabFocusFirstPadding}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PaneFocused}" Value="True"/>
                                            <Condition Binding="{Binding IsLast}"      Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabFocusLastThickness}"/>
                                        <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabFocusLastPadding}"/>
                                    </MultiDataTrigger>
                                    <!-- One tab in a focused pane owns BOTH edges, so it draws
                                         neither. Last of the three for the same reason. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PaneFocused}" Value="True"/>
                                            <Condition Binding="{Binding IsFirst}"     Value="True"/>
                                            <Condition Binding="{Binding IsLast}"      Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabFocusOnlyThickness}"/>
                                        <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabFocusOnlyPadding}"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </DockPanel>
                <!-- The ring's two vertical ends, drawn by the BAND rather than by the tab.
                     A tab's own left/right border sits on the strip's clip edge when it is the
                     first or last tab, and the ScrollViewer cuts it: the UniformGrid divides a
                     fractional band width, so the outermost border lands a hair outside the
                     viewport and vanishes. Whether it survives depends on the split width, which
                     is why it came and went. These are anchored to the band's own edges, so
                     there is no arithmetic to land wrong.
                     Declared after the strip so they draw over the tabs, and only shown when the
                     tab that owns that edge is the active one (DualPane.cs) - an inactive tab
                     leaves the pane's corner rounded and there is nothing to continue.
                     Top margin 9 = the tab's own 3 plus its 6px corner radius, so each strip
                     starts where the tab's side actually becomes vertical. Square-topped at 3 it
                     stood proud of the rounded corner as a little spike. Inside the arc the
                     tab's border is inset from the band edge, so it is nowhere near the clip and
                     draws itself fine. -->
                <!-- TabActiveRingBrush = PrimaryBrush everywhere but 98SE, where the focus ring is
                     transparent - see the note on the active tab's BorderBrush setter. -->
                <Border x:Name="TabEdgeLeft" Width="1" HorizontalAlignment="Left" Margin="0,9,0,0"
                        IsHitTestVisible="False" Visibility="Collapsed"
                        Background="{DynamicResource TabActiveRingBrush}"/>
                <Border x:Name="TabEdgeRight" Width="1" HorizontalAlignment="Right" Margin="0,9,0,0"
                        IsHitTestVisible="False" Visibility="Collapsed"
                        Background="{DynamicResource TabActiveRingBrush}"/>
               </Grid>
              </Border>

              <!-- Tab-switch crossfade ghost: SwitchToTab snapshots the outgoing pane into
                   this Image (same slot + margin, ZIndex above the pane) and fades it out
                   over the incoming tab's live content - no dip to the dark background. -->
              <Image x:Name="TabFadeGhost" Grid.Row="1" Margin="0,0,8,0" Stretch="Fill"
                     Panel.ZIndex="40" IsHitTestVisible="False" Visibility="Collapsed"/>

              <!-- RESULTS: distinct recessed surface, bordered + shadowed like KillerPDF.
                   The tab's location and run-status lines live INSIDE the pane now - each tab
                   is its own search, so the old full-width bars were wasted space. -->
              <!-- No bottom margin: PaneShadow is Direction=270 and casts DOWN over the footer,
                   and a DropShadowEffect draws outside the element's bounds without taking any
                   layout space. Any gap here is real padding, not room for the shadow, and it
                   just lifts the pane off the footer. -->
              <!-- -1 top: the pane's own top border tucks UNDER the tab strip band, which is
                   opaque, so the active tab and the pane read as one surface instead of being
                   divided by a hairline. The overlap has to live here rather than on the tab -
                   the strip is inside a ScrollViewer, which clips anything a tab overhangs.
                   With one tab the strip is collapsed and the -1 just eats 1px of the 6px gap.
                   ApplySearchPanel (SearchPanel.cs) reassigns this margin and repeats the -1. -->
              <!-- The listing surface takes the MENU tier and the location row above it takes
                   PaneBrush - swapped from the obvious way round on purpose.
                   It also happens to be the only pairing that reads on Black, where PaneBrush is
                   #0a0a0a against a #000000 window (1.06:1, invisible) while the menu tier is
                   #121212. -->
              <!-- PaneOuterMargin: 0,-1,8,0 as it always was, and 0,-1,0,0 on a flat theme. That 8
                   is an inset on the RIGHT only, with 0 on the left, so the pane sat visibly
                   further from the window edge on one side than the other - the right edge that
                   would not come down to the width of the left. It is right on
                   the rounded themes, where the pane is a floating card with a shadow; a Win98
                   client area fills its frame.
                   PaneEdgeThickness: 1 normally. 0 on 98SE, where PaneEdgeBrush is transparent
                   anyway, so the ring was invisible but still ate the pixel the raised bevel below
                   needs to land on. -->
              <Border x:Name="ResultsPane" Grid.Row="1" Margin="{DynamicResource PaneOuterMargin}" Background="{DynamicResource MenuBackgroundBrush}"
                    BorderBrush="{DynamicResource PaneEdgeBrush}" BorderThickness="{DynamicResource PaneEdgeThickness}" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Effect="{DynamicResource PaneShadowEffect}">
              <!-- Clipped to the pane's own rounded corners (PaneClip.cs). A Border with a
                   CornerRadius does NOT clip its child, so anything that reaches the top of the
                   pane squares those corners off. Nothing did while the location row was always
                   there - the row's own background filled the corner - but F10 hides it, and
                   then the terminal and the results list run straight into the curve. -->
              <Grid x:Name="PaneContent" SizeChanged="PaneContent_SizeChanged">
                <!-- Same treatment as KillerPDF's document pane: the whole content pane is grain-wrapped. -->
                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <!-- THE TAB PAGE BEVEL. A Win98 tab control's page is a RAISED panel - white down
                     the top and left, gray along the bottom and right - and the selected tab's own
                     white left edge is the SAME line continuing upward. That continuity is what
                     makes a tab and its page read as one object rather than a card sitting on a
                     box - the light gray edge of the active tab extends all the way down the
                     side of the terminal to the footer.
                     SUPERSEDED 2026-08-09: this was RAISED (brushes paired with the thicknesses by
                     name), which is what put a white line down the left of the pane. The page
                     should match the sidebar's sunken well instead, so it is now the same
                     double CROSSED bevel - see the block below.
                     Declared here at the TOP of PaneContent so it sits under the terminal, the
                     listing and the details strip; ZIndex lifts it back over them, because the
                     terminal paints an opaque black screen edge to edge. Zero-thickness and
                     transparent on the other twelve, so this costs them nothing. -->
                <!-- NO BEVEL ON PaneContent. It wraps the LOCATION ROW and the pane's whole stack,
                     so any frame drawn here rings the menu bar and the tabs as well as the content
                     - and it is the CONTENT pane that is sunken, not the menu bar and tabs.
                     A raised pair lived here and put a white line down the left of everything; a
                     sunken quad replaced it and boxed in the menu bar. Both were the wrong SCOPE,
                     not the wrong brushes.
                     The recess belongs around the CONTENT only - see the results-list well further
                     down, which carries the same four Borders the sidebar's tree well uses. -->

              <DockPanel>
                <!-- Location row: the tab's folder on the left (click to change), tab-level
                     actions on the right: pipe, export, close tab. -->
                <!-- PaneBrush, the same tier the ACTIVE TAB is filled with, so the tab merges
                     into this bar and the two read as one surface the listing hangs below.
                     Square top corners are fine: PaneClip.cs clips this to the pane's radius. -->
                <Grid x:Name="LocationRow" DockPanel.Dock="Top" SizeChanged="ToolStrip_SizeChanged"
                      Background="{DynamicResource PaneBrush}"
                      ContextMenu="{StaticResource BarMenu}"
                      Margin="{DynamicResource BarPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Its own grain. The pane's grain layer is painted BEFORE this row, so the
                         opaque PaneBrush above covers it and the bar came out as the one flat,
                         textureless strip in the window. Spans every column
                         and is declared first, so it sits under the buttons and the path. -->
                    <Border Grid.ColumnSpan="3" IsHitTestVisible="False"
                            Background="{DynamicResource GrainTileBrush}"
                            Opacity="{DynamicResource GrainOpacity}"/>
                    <!-- The bar's raised top edge. Nothing on any theme but 98SE, where a toolbar
                         is lifted off the surface by a light line along its top and left. -->
                    <!-- RAISED: the pair goes by NAME here - light on the LightThickness. That is
                         the opposite of the content well below, which crosses them to read as
                         pressed in. Menu bar raised, content sunken. -->
                    <Border Grid.ColumnSpan="3" IsHitTestVisible="False" Panel.ZIndex="3"
                            BorderBrush="{DynamicResource BarEdgeBrush}"
                            BorderThickness="{DynamicResource BarEdgeThickness}"/>
                    <Border Grid.ColumnSpan="3" IsHitTestVisible="False" Panel.ZIndex="3"
                            BorderBrush="{DynamicResource BarEdgeDarkBrush}"
                            BorderThickness="{DynamicResource BarEdgeDarkThickness}"/>
                    <!-- The divider between the menu bar and the content, the same
                         BarUnderlineThickness rule the terminal and editor bars always carried -
                         the folder bar never had one, so on the rounded themes the bar just bled
                         into the listing at the active tab's left edge with nothing to divide
                         the menubar from the content. 0 on 98SE,
                         where the raised/sunken bevels are the divider. -->
                    <Border Grid.ColumnSpan="3" IsHitTestVisible="False" Panel.ZIndex="3"
                            BorderBrush="{DynamicResource PaneBorderBrush}"
                            BorderThickness="{DynamicResource BarUnderlineThickness}"/>
                    <!-- Back / forward / up. Browser order and browser glyphs, because that is
                         what everyone's hand already expects at the top left. -->
                    <!-- Tightened across all themes - the bar had too much padding: no separator
                         after Up, the star scoots left, the
                         address follows immediately. The one group separator left is the etched
                         rule before the sort group in ToolStrip. -->
                    <StackPanel x:Name="NavStrip" Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="NavBackBtn" Style="{StaticResource ViewToggleBtn}" Content="&#xE72B;"
                                ToolTip="{DynamicResource Str_TT_Back}" Click="NavBack_Click"/>
                        <Button x:Name="NavForwardBtn" Style="{StaticResource ViewToggleBtn}" Content="&#xE72A;" Margin="2,0"
                                ToolTip="{DynamicResource Str_TT_Forward}" Click="NavForward_Click"/>
                        <Button x:Name="NavUpBtn" Style="{StaticResource ViewToggleBtn}" Content="&#xE74A;"
                                ToolTip="{DynamicResource Str_TT_Up}" Click="NavUp_Click"/>
                        <!-- Favorite: sits immediately LEFT of the address, the way a browser
                             puts its bookmark star next to the URL, so saving where you are is
                             one reach from the path you are reading rather than across the row.
                             E735 filled when saved, E734 outline when not (Bookmarks.cs).
                             Bare glyph, no button chrome: a boxed outline here would read as a
                             fourth nav button and compete with back/forward/up. It still gets a
                             hover tint and a hit area from the transparent border. -->
                        <Button x:Name="FavoriteStarBtn" Content="&#xE734;" Width="22" Height="22" Padding="0"
                                Margin="2,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                VerticalAlignment="Center" Cursor="Hand"
                                ToolTip="{DynamicResource Str_TT_Favorite}" Click="FavoriteStar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                        <!-- Tag="on" is set by Bookmarks.cs alongside the filled
                                             glyph, so a saved location reads as accent even
                                             before you hover it. -->
                                        <Trigger Property="Tag" Value="on">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="ScopeBar" CornerRadius="5,0,0,0" Padding="6,7,8,5"
                            Cursor="Hand" ToolTip="{DynamicResource Str_TT_Scope}" MouseLeftButtonUp="ScopeBar_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>   <!-- recents chevron -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Str_Lbl_In}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ScopePathLabel" Grid.Column="1" Text="{DynamicResource Str_Scope_Empty}"
                                       Foreground="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <!-- Hidden mirror of the tab's search root. Not the address bar -
                                 CaptureTab reads it, so it has to keep meaning "search root"
                                 even while the visible row is being edited. -->
                            <TextBox x:Name="RootPathBox" Visibility="Collapsed"/>
                            <!-- The editable address bar itself, over the label in the same cell
                                 (AddressBar.cs). Collapsed until you click the row, Ctrl+L or
                                 Alt+D. -->
                            <TextBox x:Name="AddressBox" Grid.Column="1" Visibility="Collapsed"
                                     Background="{DynamicResource SearchFieldBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource PrimaryBrush}"
                                     BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                     Padding="4,1" VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     KeyDown="AddressBox_KeyDown" LostFocus="AddressBox_LostFocus"/>
                            <!-- Recents chevron, on the right edge of the row (Recents.cs). Its
                                 own button rather than opening the list on every address click:
                                 clicking the row means "let me type a path", and a list that
                                 covered the box you just asked to type in would be in the way.
                                 Collapsed while searching - a search tab has no folder history
                                 to offer, and the row is the search root there. -->
                            <!-- ViewToggleBtn, not a bare Button: an unstyled Button keeps WPF's
                                 default template and its system-blue hover, which is what made
                                 this square light up against the theme. -->
                            <!-- The brand recents icon rather than the MDL2 chevron. Content is an
                                 Image, so the glyph FontFamily/FontSize no longer apply. -->
                            <Button x:Name="RecentsBtn" Grid.Column="2"
                                    Style="{StaticResource ViewToggleBtn}"
                                    Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Str_TT_Recents}"
                                    Click="Recents_Click">
                                <Button.Content>
                                    <Image Width="15" Height="15" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{x:Static svc:IconCache.RecentsArt}"/>
                                </Button.Content>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="RecentsMenu"/>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- The strip sheds into an overflow menu when the pane is too narrow to hold
                         it (PaneToolbar.cs). Buttons are MOVED between here and OverflowPanel
                         rather than duplicated, so a shed button keeps its handler, its tooltip
                         and its lit/unlit Tag with no second copy to keep in step.
                         SizeChanged drives it; the chevron only appears once something is shed. -->
                    <StackPanel Grid.Column="2" x:Name="ToolStrip" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,4,8,2">
                        <!-- View modes: cards / tile grid / flat rows under sortable columns.
                             Folded up from the row below, so this strip now carries everything
                             that acts on the listing. -->
                        <Button x:Name="ViewListBtn" Style="{StaticResource ViewToggleBtn}" Content="&#xE8FD;"
                                VerticalAlignment="Center" ToolTip="{DynamicResource Str_TT_ViewList}" Click="ViewList_Click"/>
                        <Button x:Name="ViewIconsBtn" Style="{StaticResource ViewToggleBtn}" Content="&#xE80A;" Margin="2,0"
                                VerticalAlignment="Center" ToolTip="{DynamicResource Str_TT_ViewIcons}" Click="ViewIcons_Click"/>
                        <Button x:Name="ViewDetailsBtn" Style="{StaticResource ViewToggleBtn}" Content="&#xE700;" Margin="0,0,2,0"
                                VerticalAlignment="Center" ToolTip="{DynamicResource Str_TT_ViewDetails}" Click="ViewDetails_Click"/>
                        <!-- The one group separator in the strip, between the view modes and the
                             sort controls. Same BarSep* pair, zero width off 98SE. -->
                        <Border Width="{DynamicResource BarSepWidth}" Margin="2,3,4,3"
                                Background="{DynamicResource BarSepBrush}"/>
                        <!-- Sort: key + direction. The key is ONE icon with a flyout, the same
                             shape as export - the 118px combo was the widest control in this
                             strip and the first thing to crush the location path beside it. -->
                        <Button x:Name="SortBtn" Content="&#xE8CB;" Width="26" Height="24" Padding="0" Margin="0,0,2,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                VerticalAlignment="Center" ToolTip="{DynamicResource Str_TT_Sort}" Click="SortMenu_Click"/>
                        <!-- Same flyout construction as export: StaysOpen="False" so an outside
                             click dismisses it, and the shadow on its own border so the text
                             never renders through a bitmap effect or it loses ClearType. -->
                        <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortBtn}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-14" VerticalOffset="-2">
                            <Grid Margin="14">
                                <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270"
                                                                     Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="6">
                                    <!-- The chosen key lights accent through SurfaceButton's
                                         Tag="on" trigger, so Tag is spoken for - the index
                                         rides on CommandParameter instead (Results.cs). -->
                                    <StackPanel MinWidth="104">
                                        <!-- Collapsed while browsing (ViewOptions.cs): "as found" is the
                                             engine's discovery order, which means nothing in a folder
                                             listing that was enumerated in one pass. -->
                                        <Button x:Name="SortFoundItem" CommandParameter="0" Content="{DynamicResource Str_Sort_Found}"
                                                Style="{StaticResource SurfaceButton}" HorizontalContentAlignment="Left"
                                                Padding="10,3" FontSize="11" Margin="0,0,0,3" Click="SortItem_Click"/>
                                        <Button x:Name="SortNameItem" CommandParameter="1" Content="{DynamicResource Str_Col_Name}"
                                                Style="{StaticResource SurfaceButton}" HorizontalContentAlignment="Left"
                                                Padding="10,3" FontSize="11" Margin="0,0,0,3" Click="SortItem_Click"/>
                                        <Button x:Name="SortFolderItem" CommandParameter="2" Content="{DynamicResource Str_Col_Folder}"
                                                Style="{StaticResource SurfaceButton}" HorizontalContentAlignment="Left"
                                                Padding="10,3" FontSize="11" Margin="0,0,0,3" Click="SortItem_Click"/>
                                        <Button x:Name="SortSizeItem" CommandParameter="3" Content="{DynamicResource Str_Col_Size}"
                                                Style="{StaticResource SurfaceButton}" HorizontalContentAlignment="Left"
                                                Padding="10,3" FontSize="11" Margin="0,0,0,3" Click="SortItem_Click"/>
                                        <Button x:Name="SortModifiedItem" CommandParameter="4" Content="{DynamicResource Str_Col_Modified}"
                                                Style="{StaticResource SurfaceButton}" HorizontalContentAlignment="Left"
                                                Padding="10,3" FontSize="11" Click="SortItem_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Popup>
                        <Button x:Name="SortDirButton" Content="&#xE70E;" Width="24" Height="24" Padding="0" Margin="0,0,2,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource SurfaceButton}"
                                VerticalAlignment="Center" Click="SortDir_Click"/>
                        <!-- Expand/collapse all: one glyph button, no words to shift width.
                             Hidden (not collapsed) outside list view - see ResultsView.cs. -->
                        <Button x:Name="ExpandAllButton" Style="{StaticResource SurfaceButton}"
                                Width="26" Height="24" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"
                                ToolTip="{DynamicResource Str_Btn_ExpandAll}" Click="ExpandAll_Click">
                            <TextBlock x:Name="ExpandAllGlyph" Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- View options (ViewOptions.cs). Both accent while on, via the
                             Tag="on" trigger SurfaceButton carries. -->
                        <Button x:Name="ShowHiddenBtn" Content="&#xE7B3;" Width="26" Height="24" Padding="0" Margin="0,0,2,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_ShowHidden}" Click="ShowHidden_Click"/>
                        <!-- Custom composite glyph: no single Segoe MDL2 glyph
                             reads as "folders sort above files", so this stacks FolderHorizontal
                             (F12B) as the base with CaretUpSolid8 (EDDB) centered on top, rather
                             than reusing an unrelated glyph. -->
                        <Button x:Name="FoldersTopBtn" Width="26" Height="24" Padding="0" Margin="0,0,2,0"
                                Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_FoldersTop}" Click="FoldersTop_Click">
                            <Grid>
                                <TextBlock Text="&#xF12B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xEDDB;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </Grid>
                        </Button>
                        <!-- Details/preview strip toggle (Shell/DetailsPane.cs). Slides out of the
                             BOTTOM of this pane, not a side panel - see the strip itself further
                             down. Window-wide like ShowHidden/FoldersTop above it, so both panes
                             agree on whether it is showing. -->
                        <Button x:Name="DetailsPaneBtn" Content="&#xE75B;" Width="26" Height="24" Padding="0" Margin="0,0,2,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_DetailsPane}" Click="DetailsPane_Click"/>
                    <!-- Pipe: search WITHIN these results in a new tab. Collapsed while browsing
                         (ViewOptions.cs) - piping a folder listing into a search tab is the one
                         case where it reads as a filter and surprises you. -->
                        <Button x:Name="PipeBtn" Content="&#xE71C;" Width="26" Height="24" Padding="0" Margin="0,0,2,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_Pipe}" Click="PipeButton_Click"/>
                        <!-- Dual pane moved to the icon rail (MainWindow.xaml). It was the one
                             control in this strip that acts on the WINDOW rather than on this
                             pane, so there were two of them - one per pane - both doing the
                             identical thing, and either could be shed into the overflow. -->
                        <!-- Export: ONE icon, the format picked from a flyout. Two text buttons
                             (CSV + HTML) took enough of this row to crush the location path
                             beside them; a 26px icon sits with the rest of the toolbar. -->
                        <Button x:Name="ExportBtn" Content="&#xE72D;" Width="26" Height="24" Padding="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_Btn_Export}" Click="ExportButton_Click"/>
                        <!-- StaysOpen="False" so an outside click dismisses it - what a two-item
                             format picker should do. The theme flyout deliberately keeps capture
                             instead so the results list scrolls under it; this one has no reason
                             to. A Popup takes no layout space, so it can sit in the row itself.
                             Shadow on its own border, per the family standard: text must never
                             render through a bitmap effect or it loses ClearType. -->
                        <!-- Restyled as a regular CONTEXT-MENU look: grained
                             surface, transparent hover-wash rows instead of pill buttons, an
                             icon gutter on the left (a cell grid for CSV, literal <> for HTML)
                             and each row's real keyboard shortcut right-aligned - Ctrl+Alt+E and
                             Ctrl+Alt+Shift+E are the bindings the shortcuts card already lists.
                             Shadow rides the MenuShadow tokens like the editor popups. -->
                        <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportBtn}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-14" VerticalOffset="-2">
                            <Grid Margin="14">
                                <Grid.Resources>
                                    <Style x:Key="ExportRow" TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="8,4,10,4">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False"
                                        Opacity="{DynamicResource MenuShadowOpacity}"
                                        Effect="{DynamicResource MenuShadowEffect}"/>
                                <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="6">
                                    <StackPanel MinWidth="200">
                                        <!-- Format names, not prose - deliberately unlocalized,
                                             the same way the old two buttons were. -->
                                        <Button Style="{StaticResource ExportRow}" Margin="0,0,0,2" Click="ExportCsv_Click">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Width="22" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+Shift+E" Foreground="{DynamicResource DimTextBrush}"
                                                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                                <TextBlock Text="CSV" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Button>
                                        <Button Style="{StaticResource ExportRow}" Click="Export_Click">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="&lt;&gt;" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                           Width="22" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+E" Foreground="{DynamicResource DimTextBrush}"
                                                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                                <TextBlock Text="HTML" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!-- The grain, OVER the rows like every menu - this popup was the
                                     one untextured surface left. -->
                                <Border Style="{StaticResource FlyoutGrain}" IsHitTestVisible="False"/>
                            </Grid>
                        </Popup>
                        <!-- Overflow chevron. Collapsed until something is actually shed, so a
                             wide pane looks exactly as it did. Kept LAST in the strip and
                             excluded from the shed list, or it could push itself out. -->
                        <Button x:Name="OverflowBtn" Content="&#xE712;" Width="20" Height="24" Padding="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                Visibility="Collapsed" ToolTip="{DynamicResource Str_TT_MoreTools}"
                                Click="Overflow_Click"/>
                        <Popup x:Name="OverflowPopup" PlacementTarget="{Binding ElementName=OverflowBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               HorizontalOffset="-14" VerticalOffset="-2">
                            <Grid Margin="14">
                                <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="4" IsHitTestVisible="False">
                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.5"/></Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="6">
                                    <!-- Horizontal: the shed items are icon buttons, and stacking
                                         them would make a tall thin column of unlabeled glyphs. -->
                                    <StackPanel x:Name="OverflowPanel" Orientation="Horizontal"/>
                                </Border>
                            </Grid>
                        </Popup>
                        <!-- No close button here. Every tab carries its own x in the strip, and
                             with a single tab the strip is hidden and there is nothing to close
                             to - you close the window. Ctrl+W still works either way. -->
                    </StackPanel>
                </Grid>

                <!-- The run-status row used to live here, above the results. It said the same
                     thing the RESULTS (n) header said, in a pane that is now a folder listing
                     rather than a search report - so both moved to the footer status bar, which
                     is where a running commentary belongs. StatusText is in ROW 2 now. -->

                <!-- The view/sort row that used to sit here folded up into the location row
                     above: two strips of chrome over a folder listing is one too many. QueryText
                     went to the footer with the rest of the commentary. -->

                <!-- Details-view column headers. Collapsed in the other two views. The column
                     widths are duplicated in DetailsRowTemplate below and the right margin
                     hand-clears the scrollbar; keep the two in step if you change either. -->
                <!-- Styled to match KillerScan's DataGrid column headers (MainWindow.xaml,
                     DataGrid.ColumnHeaderStyle): TableHeaderBrush behind, MutedTextBrush type at
                     11, and the accent stripe underneath as a 1px HeaderLineBrush bottom border
                     rather than the pane's own gray. Top corners rounded to 5 so the band sits
                     inside the pane's CornerRadius 6 instead of squaring it off. -->
                <Border x:Name="DetailsHeader" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{DynamicResource TableHeaderBrush}" BorderBrush="{DynamicResource HeaderLineBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="5,5,0,0"
                        Padding="{Binding ViewState.HeaderPad, RelativeSource={RelativeSource AncestorType=local:FilePane}}"
                        MouseRightButtonUp="DetailsHeader_MouseRightButtonUp">
                  <!-- The header lives inside a scroll viewer with BOTH bars disabled, which is
                       not about scrolling at all - it is the only thing that stops this Grid's
                       width reaching the window.
                       The columns are fixed pixel widths, so the Grid's minimum desired width is
                       their total (~700px). WPF propagates a child's minimum all the way up, so
                       dragging the window narrower than that pushed the title bar and the footer
                       off the right edge - the whole content was wider than the window and got
                       clipped. The results list never did this because a ListBox has its own
                       ScrollViewer, which absorbs its content's desired width; the header had
                       nothing above it to do the same job.
                       Disabled, not Hidden: hidden still measures the child at infinite width,
                       which is exactly the behavior being prevented. This is the same reason
                       the tab strip is wrapped the same way. -->
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Disabled"
                                FocusVisualStyle="{x:Null}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Tracks the row's icon column, or every row sits off its heading. -->
                            <ColumnDefinition Width="{Binding ViewState.RowIconColumn, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                            <!-- Every column carries its own dragged width and the STAR is last:
                                 a filler that takes whatever is left over. Name used to be the
                                 star, which meant resizing anything had to move Name as well and
                                 a drag could visibly shift a column you were not touching. -->
                            <ColumnDefinition Width="{Binding ViewState.NameWidth, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                            <ColumnDefinition Width="{Binding ViewState.LocationWidth, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                            <ColumnDefinition Width="{Binding ViewState.SizeWidth, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                            <ColumnDefinition Width="{Binding ViewState.ModifiedWidth, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource ColHeaderBtn}" Click="ColName_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_Col_Name}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="ColNameArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ColHeaderBtn}" Click="ColFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_Col_Folder}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="ColFolderArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource ColHeaderBtn}" HorizontalContentAlignment="Right" Click="ColSize_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_Col_Size}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="ColSizeArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource ColHeaderBtn}" Click="ColModified_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_Col_Modified}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="ColModArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Column resize grips (ResultsView.cs). One on EVERY boundary between
                             two headings, plus the outer edge of the last one - a gap with no
                             handle is a gap you try to grab and nothing happens. Tag is the
                             BOUNDARY number, not a column: which two columns a boundary sits
                             between depends on whether the location column is on screen, so
                             ResultsView.BoundaryPair works that out at drag time.
                             Each grip lives in the column to its LEFT and is right-aligned, so
                             it lands on that column's trailing edge.
                             Declared AFTER the header buttons so they win the hit test - a grip
                             overlaps the sort button's last few pixels, and a click that landed
                             on the button instead would re-sort the list when you meant to drag.
                             Transparent, not invisible: Background="Transparent" is what makes a
                             Border hit-testable at all, and a drawn divider would be a stack of
                             vertical rules in a header that already has a bottom border.
                             6px wide and pulled 3 to the right so the target straddles the
                             boundary rather than sitting inside one column - Fitts' law, and it
                             is the difference between a grip you can grab and one you hunt for.
                             The LOCATION grip is the one that goes while browsing, because its
                             column is the one that goes; Name keeps its divider either way. -->
                        <Border Grid.Column="1" Tag="1" Width="6" Margin="0,0,-3,0"
                                HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"
                                PreviewMouseLeftButtonDown="ColGrip_MouseDown"
                                PreviewMouseMove="ColGrip_MouseMove"
                                PreviewMouseLeftButtonUp="ColGrip_MouseUp"
                                ToolTip="{DynamicResource Str_TT_ColResize}"/>
                        <Border Grid.Column="2" Tag="2" Width="6" Margin="0,0,-3,0"
                                HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"
                                Visibility="{Binding ViewState.LocationGripVisibility, RelativeSource={RelativeSource AncestorType=local:FilePane}}"
                                PreviewMouseLeftButtonDown="ColGrip_MouseDown"
                                PreviewMouseMove="ColGrip_MouseMove"
                                PreviewMouseLeftButtonUp="ColGrip_MouseUp"
                                ToolTip="{DynamicResource Str_TT_ColResize}"/>
                        <Border Grid.Column="3" Tag="3" Width="6" Margin="0,0,-3,0"
                                HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"
                                PreviewMouseLeftButtonDown="ColGrip_MouseDown"
                                PreviewMouseMove="ColGrip_MouseMove"
                                PreviewMouseLeftButtonUp="ColGrip_MouseUp"
                                ToolTip="{DynamicResource Str_TT_ColResize}"/>
                        <Border Grid.Column="4" Tag="4" Width="6" Margin="0,0,-3,0"
                                HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"
                                PreviewMouseLeftButtonDown="ColGrip_MouseDown"
                                PreviewMouseMove="ColGrip_MouseMove"
                                PreviewMouseLeftButtonUp="ColGrip_MouseUp"
                                ToolTip="{DynamicResource Str_TT_ColResize}"/>
                    </Grid>
                  </ScrollViewer>
                </Border>

                <!-- PER-PANE STATUS BAR: the short, fixed per-TAB facts only - how many files
                     this tab scanned, how many it matched, and what it searched for. Each tab
                     is its own search, so these belong to the pane and not to one shared window
                     footer that cannot report two panes at once.
                     The live commentary line (StatusText, "Opening C:\...") deliberately does
                     NOT live here: it is the one item with unbounded length, and it gets the
                     full window width down in the footer instead. Splitting them that way is
                     the whole point of having two bars - the alternative is what this row was
                     a moment ago, all four items back on one line, colliding again.
                     COLUMNS, not a horizontal StackPanel: a StackPanel measures its children at
                     INFINITE width in its orientation, so TextTrimming never engages and text
                     just overruns whatever is beside it. QueryText takes the * column.
                     24px row and mono 11.5 status type is the family footer standard. No
                     background: it sits on the pane surface like the location row up top, so
                     while it is showing the pane's own CornerRadius 6 supplies the bottom
                     rounding and the list border below goes square. -->
                <!-- Collapsed whenever all three fields are empty, which is the whole time you
                     are just browsing a folder - a scanned count and a match count belong to a
                     search, and the query label is blank. An empty 24px strip under the listing
                     is dead space. UpdatePaneStatusBar (MainWindow.xaml.cs) toggles this and
                     hands the pane's bottom rounding back to the list surface below. -->
                <Border x:Name="PaneStatusBar" DockPanel.Dock="Bottom" Height="24" Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScannedText" Grid.Column="0" Foreground="{DynamicResource TextFooter}"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="0,0,14,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatsText" Grid.Column="1" Foreground="{DynamicResource PrimaryBrush}"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <!-- What this tab searched for, so an old search tab stays self-explanatory.
                             Empty while browsing, and a collapsed-width TextBlock costs nothing. -->
                        <TextBlock x:Name="QueryText" Grid.Column="2" Foreground="{DynamicResource MutedTextBrush}"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ResultsHeader" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- DETAILS/PREVIEW STRIP (Shell/DetailsPane.cs): slides out of the BOTTOM of
                     this pane, full width, NOT a side panel like Explorer's - it belongs
                     under the listing. Declared AFTER PaneStatusBar (Bottom-docked children stack
                     in declaration order, first = bottommost), so this sits just above the
                     status strip and below the results list.
                     Off by default (Height 0, Collapsed). DetailsPaneBtn (ToolStrip above) and
                     Alt+P toggle it; ApplyDetailsPane animates Height from/to a MEASURED content
                     height, never a guessed constant, until the user drags DetailsPaneGrip below -
                     the Bookmarks-drawer lesson (a fixed pixel target drifts from a variable-
                     length path/attributes row and a variable-aspect image), same estimate-then-
                     measure-and-correct shape. ClipToBounds hides the content overshoot mid-
                     animation.
                     Split into two columns: file details (left) and an image preview / big shell
                     icon (right) - DetailsPaneContent (Shell/DetailsPane.cs). -->
                <!-- PaneBrush, not MenuBackgroundBrush: LocationRow above
                     paints nothing of its own and lets the pane's PaneBrush show through - see
                     the identical note on the shell bar further down - so this strip needs the
                     same brush to read as one continuous band with the toolbar rather than a
                     darker strip stacked under it. -->
                <Border x:Name="DetailsPane" DockPanel.Dock="Bottom" Height="0" Visibility="Collapsed"
                        ClipToBounds="True" Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource PaneBorderBrush}"
                        BorderThickness="{DynamicResource DetailsPaneBorderThickness}">
                    <Grid>
                        <!-- Drawn first, before DetailsPaneContent - the field labels/values below
                             paint no opaque background of their own, so the texture shows through
                             behind the text exactly like PaneContent's own grain layer does further
                             up, instead of sitting on top of it. -->
                        <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        <Grid x:Name="DetailsPaneContent" Margin="14,10,14,10" SizeChanged="DetailsPaneContent_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <!-- Width is set from CODE (Shell/DetailsPane.cs ApplyDetailsPreviewWidth),
                                 tracking the strip's own HEIGHT rather than being independently
                                 draggable - a side splitter was tried here and was not
                                 helpful. The 150 below is only the pre-layout placeholder. -->
                            <ColumnDefinition x:Name="DetailsPreviewCol" Width="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- Blank state: no selection. Fields stay hidden rather than showing
                             empty/dashed rows - there is nothing to be specific about yet. -->
                        <TextBlock x:Name="DetailsEmptyText" Grid.Column="0" Text="{DynamicResource Str_Details_Empty}"
                                   Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}"
                                   FontSize="11.5" VerticalAlignment="Center" Visibility="Collapsed"/>

                        <StackPanel x:Name="DetailsFieldsGrid" Grid.Column="0" VerticalAlignment="Center">
                            <!-- PrimaryBrush, matching ScopePathLabel's treatment of the current
                                 location above (LocationRow) - the family's "this is the title
                                 text" accent, not the plain TextBrush every field value below uses.
                                 WordmarkFont + a size well above the field rows (10/11 below) - it
                                 is the title of what you're looking at, so it should read as more
                                 prominent. -->
                            <!-- DetailsNameFont = WordmarkFont everywhere but 98SE, where the
                                 typewriter face gives way to Courier New - the era's monospace. -->
                            <!-- The filename's chrome is theme-split: the family drop shadow
                                 (DetailsNameEffect, null on 98SE - a flat theme casts nothing)
                                 and, on 98SE only, a hard 1px WHITE copy up-left of the crisp
                                 text - the raised chisel, the same treatment the About wordmark
                                 carries. The copy binds the live text so it
                                 always mirrors what DetailsPane.cs writes. -->
                            <Grid Margin="0,0,0,9">
                                <TextBlock IsHitTestVisible="False" FontFamily="{DynamicResource DetailsNameFont}" FontSize="20"
                                           FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"
                                           Text="{Binding Text, ElementName=DetailsNameText}"
                                           Opacity="{DynamicResource AboutEmbossOpacity}">
                                    <TextBlock.RenderTransform><TranslateTransform X="-1" Y="-1"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="DetailsNameText" FontFamily="{DynamicResource DetailsNameFont}" FontSize="20"
                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                           TextWrapping="Wrap" Effect="{DynamicResource DetailsNameEffect}"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Col_Size}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="DetailsSizeText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Col_Modified}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="DetailsModifiedText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Details_Created}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="DetailsCreatedText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Details_Type}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="DetailsTypeText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <!-- No attributes row - it only ever showed R/H/S flags, which a
                                 normal file lacks, so it read "-" nearly always. The hidden
                                 TextBlock stays so DetailsPane.cs's async stat still has its
                                 target without a code rewrite; nothing renders. -->
                            <TextBlock x:Name="DetailsAttrText" Visibility="Collapsed"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Details_Path}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10"/>
                                <TextBlock x:Name="DetailsPathText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Static 1px divider between the details fields and the preview column -
                             no longer a GridSplitter (dragging it proved not
                             helpful; the preview now widens with the STRIP's height instead, via
                             DetailsPaneGrip below). Kept purely as a visual rule, matching the old
                             splitter's line color. -->
                        <Border Grid.Column="1" Width="{DynamicResource DetailsDividerWidth}" HorizontalAlignment="Center" Margin="0,2"
                                Background="{DynamicResource PaneBorderBrush}"/>

                        <!-- Preview: DetailsPreviewImage is the real decoded thumbnail (images
                             only, off the UI thread - Shell/DetailsPane.cs). DetailsPreviewIcon is
                             the shell's own big icon (IconCache), shown for everything else and as
                             the placeholder while an image decodes. Never both at once.
                             Stretch, not Center: the column/row now sizes with the strip's height
                             (Shell/DetailsPane.cs ApplyDetailsPreviewWidth), and the images need to
                             fill that area - Stretch="Uniform" on each Image is what keeps them
                             proportional inside it while it grows or shrinks. -->
                        <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image x:Name="DetailsPreviewImage" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" SnapsToDevicePixels="True"/>
                            <Image x:Name="DetailsPreviewIcon" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" SnapsToDevicePixels="True"/>
                        </Grid>
                        </Grid>

                        <!-- Horizontal resize grip: the STRIP's own height, not a column width.
                             Same Thumb approach as TreeResizeGrip (Shell/MainWindow.xaml) rather
                             than a GridSplitter - DetailsPane.Height is also the property the
                             open/close animation drives, and a splitter would fight that. Sits on
                             the strip's TOP edge (VerticalAlignment="Top"), so dragging it resizes
                             the boundary between the file listing above and this strip, the way an
                             IDE's bottom-docked panel drags. -->
                        <Thumb x:Name="DetailsPaneGrip" Height="5" VerticalAlignment="Top"
                               Panel.ZIndex="60" Cursor="SizeNS"
                               DragDelta="DetailsPaneGrip_DragDelta"
                               DragCompleted="DetailsPaneGrip_DragCompleted">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <!-- Transparent, not empty: a Border with no Background is
                                         not hit-testable and the grip would be unusable. -->
                                    <Border Background="Transparent">
                                        <Rectangle x:Name="hint" Height="1" VerticalAlignment="Top"
                                                   Fill="{DynamicResource PaneBorderBrush}" Opacity="0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                            <Setter TargetName="hint" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>

                <!-- The list area sits on the in-between tone (MenuBackgroundBrush - between
                     the bar and pane tiers, like KillerPDF's annotation bars), grain-wrapped.
                     CornerRadius is driven from code (UpdatePaneStatusBar): square while the
                     status bar is showing, because the bar owns the pane's bottom edge then -
                     and rounded back to 5 the moment the bar collapses, or the list would sit
                     square-cornered inside the pane's own radius 6. -->
                <Border x:Name="ResultsSurface" Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="0">
                <Grid>
                <Border x:Name="ResultsSurfaceGrain" IsHitTestVisible="False" CornerRadius="0"
                        Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <!-- A shell tab draws here instead of the listing. Declared BEFORE the list so
                     the list's context menus and drag handlers keep working normally when it is
                     the one showing; only one of the two is ever visible.
                     The terminal paints SurfaceBrush itself (TerminalPalette.cs) - a step below
                     PaneBrush, the same "elevated but not stark" surface KillerPDF's floating
                     annotation bars use - so a shell reads as a screen sunk slightly into the
                     pane rather than either the pane's own flat color or a black hole cut into
                     it. -->
                <Grid x:Name="TerminalHost" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- The shell's own bar (TerminalBar.cs), in place of the folder location
                         row. Back, forward, up and the address box were never anything a shell
                         could act on - you cannot cd a pty by clicking Back - so what is left is
                         the one thing that IS live: where the shell currently is, tracked from
                         OSC 7. The buttons are the rows a hand reaches for often enough not to
                         want a right-click first; the rest stay in the menu.
                         PaneBrush, not MenuBackgroundBrush: the folder
                         browsing LocationRow paints nothing of its own and lets the pane's own
                         PaneBrush show through, which is what makes it blend into the active
                         tab above it; MenuBackgroundBrush here was a full step darker, so this
                         bar visibly seamed against the tab where the folder view never did. -->
                    <!-- BarUnderlineThickness, not a literal 0,0,0,1: this rule is the line under
                         the menu bar that had to go on 98SE (2026-08-09). The token defaults
                         to exactly the literal it replaced, so the twelve rounded themes keep it. -->
                    <!-- Height 32, NOT 26: 32 is the folder LocationRow's natural height (the
                         ScopeBar's 20px recents button plus its 12,7,8,5 padding), and this bar
                         being shorter made the content pane start at a different height on a shell
                         tab than on a folder tab - jarring on every tab switch.
                         If ScopeBar's padding or button size ever changes, keep this
                         and the editor bar below in step. -->
                    <Border x:Name="TerminalBarRow" Grid.Row="0" Height="32" Background="{DynamicResource PaneBrush}"
                            BorderBrush="{DynamicResource PaneBorderBrush}"
                            ContextMenu="{StaticResource BarMenu}"
                            BorderThickness="{DynamicResource BarUnderlineThickness}">
                        <Grid>
                            <Border IsHitTestVisible="False"
                                    Background="{DynamicResource GrainTileBrush}"
                                    Opacity="{DynamicResource GrainOpacity}"/>
                            <!-- The same raised bar edges the folder LocationRow carries. This bar
                                 never had them, which is why a TERMINAL tab's menu bar came out
                                 completely flat - no white line down its left continuing the
                                 active tab's bevel, no raised top, no dark right - while a folder
                                 tab looked right. Zero-thickness on every theme but 98SE. -->
                            <Border IsHitTestVisible="False" Panel.ZIndex="3"
                                    BorderBrush="{DynamicResource BarEdgeBrush}"
                                    BorderThickness="{DynamicResource BarEdgeThickness}"/>
                            <Border IsHitTestVisible="False" Panel.ZIndex="3"
                                    BorderBrush="{DynamicResource BarEdgeDarkBrush}"
                                    BorderThickness="{DynamicResource BarEdgeDarkThickness}"/>
                            <Grid Margin="8,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Lbl_In}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <!-- Click to edit: type a folder and press Enter to cd the LIVE
                                     shell there (TerminalBar.cs TermCwd_Click / TermCwdBox_*).
                                     Opening the path as a folder TAB is TermFolderBtn's job
                                     (the folder icon to the right) - this text is about the
                                     shell, not the pane, so it no longer duplicates that button. -->
                                <TextBlock x:Name="TermCwdText" Grid.Column="1"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Cursor="IBeam" ToolTip="{DynamicResource Str_TT_TermCwd}"
                                           MouseLeftButtonUp="TermCwd_Click"/>
                                <TextBox x:Name="TermCwdBox" Grid.Column="1" Visibility="Collapsed"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         PreviewKeyDown="TermCwdBox_KeyDown"
                                         LostFocus="TermCwdBox_LostFocus"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button x:Name="TermNewBtn" Content="&#xE756;" Width="24" Height="20" Padding="0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_TermNew}" Click="TermNew_Click"/>
                                    <Button x:Name="TermAdminBtn" Content="&#xE7EF;" Width="24" Height="20" Padding="0" Margin="4,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_TermAdmin}" Click="TermAdmin_Click"/>
                                    <Button x:Name="TermFolderBtn" Content="&#xE8B7;" Width="24" Height="20" Padding="0" Margin="4,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_TermFolder}" Click="TermFolder_Click"/>
                                    <Button x:Name="TermClearBtn" Content="&#xE894;" Width="24" Height="20" Padding="0" Margin="4,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_TermClear}" Click="TermClear_Click"/>
                                    <Button x:Name="TermFontsBtn" Content="&#xE8D2;" Width="24" Height="20" Padding="0" Margin="4,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_TermFonts}" Click="TermFonts_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- No grain Border here: the terminal paints its own
                         background AND every character it draws as one opaque surface
                         (TerminalPalette.cs) with no gap for a Border behind this ContentControl
                         to show through. The grain itself is NOT missing though - TerminalControl
                         .OnRender washes the tile onto its own background fill directly, under
                         the glyphs, so texture still shows in every blank cell without ever
                         landing on top of the writing. -->
                    <ContentControl Grid.Row="1" x:Name="TerminalSlot" Focusable="False"/>
                    <!-- The terminal's own sunken well - Grid.Row 1 ONLY, so it rings the black
                         screen and nothing else. Scoped here rather than across the pane because a
                         well drawn at pane level rings the shell bar and the tab strip too, which
                         is what put a black line down the left of the menu bar and under the tabs.
                         Same four Borders as the sidebar's tree well and the listing's: outer
                         #808080/#ffffff, inner #000000/#c0c0c0 at a 1px margin, brushes CROSSED so
                         it reads as pressed in. ZIndex 5 because the terminal paints an opaque
                         screen edge to edge and would otherwise cover it; within this Grid that
                         cannot reach the bar in row 0. Inert on the twelve rounded themes, where
                         every PaneBevel* thickness is 0. -->
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            BorderBrush="{DynamicResource PaneBevelDarkBrush}"  BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelDark2Brush}"  BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                </Grid>
                <!-- A document tab draws here, on the same terms as the shell above it: declared
                     before the list, only ever one of the three visible. The editor paints its
                     own background (SurfaceBrush + the grain tile baked together into one
                     DrawingBrush, Editing/EditorControl.ApplyTheme/SurfaceWithGrain) rather than
                     sitting on a Border behind it - same reason as the terminal above: AvalonEdit
                     fills its whole rect opaquely itself, so nothing behind it would ever show. -->
                <Grid x:Name="EditorHost" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- The document's own bar (EditorBar.cs), in place of the folder location
                         row - back, forward, up, the address box and the view buttons are all
                         about a LISTING and mean nothing over an open file.
                         Verbs on the bar, preferences behind the gear. Encoding and line ending
                         are readouts rather than controls: a script PowerShell 5.1 will read
                         depends on both and neither is visible in the text, but changing either
                         rewrites somebody's file just to look at it.
                         PaneBrush, not MenuBackgroundBrush: same fix as the
                         shell bar above - MenuBackgroundBrush is a full step darker than the
                         pane, so this bar visibly seamed against the tab above it where the
                         folder view's own location row never does. -->
                    <!-- BarUnderlineThickness, not a literal 0,0,0,1: this rule is the line under
                         the menu bar that had to go on 98SE (2026-08-09). The token defaults
                         to exactly the literal it replaced, so the twelve rounded themes keep it. -->
                    <!-- Height 32 = the folder LocationRow's natural height, same as the shell bar
                         above, so the content starts at one height whatever kind of tab is up. -->
                    <Border x:Name="EditorBarRow" Grid.Row="0" Height="32" Background="{DynamicResource PaneBrush}"
                            BorderBrush="{DynamicResource PaneBorderBrush}"
                            ContextMenu="{StaticResource BarMenu}"
                            BorderThickness="{DynamicResource BarUnderlineThickness}">
                        <Grid>
                            <Border IsHitTestVisible="False"
                                    Background="{DynamicResource GrainTileBrush}"
                                    Opacity="{DynamicResource GrainOpacity}"/>
                            <!-- Same raised bar edges as the folder LocationRow and the shell bar
                                 above - a DOCUMENT tab's menu bar was the same flat strip the
                                 terminal's was. Zero-thickness off 98SE. -->
                            <Border IsHitTestVisible="False" Panel.ZIndex="3"
                                    BorderBrush="{DynamicResource BarEdgeBrush}"
                                    BorderThickness="{DynamicResource BarEdgeThickness}"/>
                            <Border IsHitTestVisible="False" Panel.ZIndex="3"
                                    BorderBrush="{DynamicResource BarEdgeDarkBrush}"
                                    BorderThickness="{DynamicResource BarEdgeDarkThickness}"/>
                            <Grid Margin="6,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Lights in the accent while there is something to save,
                                         via the Tag="on" trigger SurfaceButton already carries -
                                         the same signal the tab title's dot gives. -->
                                    <Button x:Name="EditorSaveBtn" Content="&#xE74E;" Width="24" Height="20" Padding="0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_EdSave}" Click="EditorSave_Click"/>
                                    <Button x:Name="EditorUndoBtn" Content="&#xE7A7;" Width="24" Height="20" Padding="0" Margin="6,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_EdUndo}" Click="EditorUndo_Click"/>
                                    <Button x:Name="EditorRedoBtn" Content="&#xE7A6;" Width="24" Height="20" Padding="0" Margin="2,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_EdRedo}" Click="EditorRedo_Click"/>
                                    <Button x:Name="EditorFindBtn" Content="&#xE721;" Width="24" Height="20" Padding="0" Margin="6,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_EdFind}" Click="EditorFind_Click"/>
                                    <Button x:Name="EditorGotoBtn" Content="&#xE8A1;" Width="24" Height="20" Padding="0" Margin="2,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_EdGoto}" Click="EditorGoto_Click"/>
                                    <!-- Go to line, as a popup rather than a dialog: it is one
                                         number and an Enter, and a modal window for that is more
                                         ceremony than the command is worth. -->
                                    <Popup x:Name="EditorGotoPopup" PlacementTarget="{Binding ElementName=EditorGotoBtn}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           HorizontalOffset="-14" VerticalOffset="-2">
                                        <Grid Margin="14">
                                            <!-- MenuShadow tokens, not FlyoutShadowOpacity: that key is 0 on
                                                 98SE, which erased these popups' shadows there - the tokens keep
                                                 the ordinary themes' soft shadow and give 98SE the Win98 offset
                                                 shadow. -->
                                            <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False"
                                                    Opacity="{DynamicResource MenuShadowOpacity}"
                                                    Effect="{DynamicResource MenuShadowEffect}"/>
                                            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Str_Ed_GotoLabel}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontFamily="{DynamicResource MonoFont}" FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="EditorGotoBox" Width="74"
                                                             Background="{DynamicResource TextFieldBrush}"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             CaretBrush="{DynamicResource PrimaryBrush}"
                                                             BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                                                             FontFamily="Consolas" FontSize="12" Padding="4,1"
                                                             VerticalContentAlignment="Center"
                                                             KeyDown="EditorGotoBox_KeyDown"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                    <!-- The return arrow in Segoe UI Symbol, which is what
                                         KillerNotes' wrap toggle uses: MDL2 has no wrap glyph
                                         and every near miss reads as something else. -->
                                    <Button x:Name="EditorWrapBtn" Width="24" Height="20" Padding="0" Margin="6,0,0,0"
                                            Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_EdWrap}" Click="EditorWrap_Click">
                                        <TextBlock Text="&#x21B5;" FontFamily="Segoe UI Symbol" FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="EditorGearBtn" Content="&#xE713;" Width="24" Height="20" Padding="0" Margin="2,0,0,0"
                                            FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource SurfaceButton}"
                                            ToolTip="{DynamicResource Str_TT_EdSettings}" Click="EditorGear_Click"/>
                                    <!-- Everything that is a preference about reading code, in
                                         one place, so the bar keeps only the verbs. Same flyout
                                         construction as the sort menu above. -->
                                    <Popup x:Name="EditorGearPopup" PlacementTarget="{Binding ElementName=EditorGearBtn}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           HorizontalOffset="-14" VerticalOffset="-2">
                                        <Grid Margin="14">
                                            <!-- MenuShadow tokens, not FlyoutShadowOpacity: that key is 0 on
                                                 98SE, which erased these popups' shadows there - the tokens keep
                                                 the ordinary themes' soft shadow and give 98SE the Win98 offset
                                                 shadow. -->
                                            <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False"
                                                    Opacity="{DynamicResource MenuShadowOpacity}"
                                                    Effect="{DynamicResource MenuShadowEffect}"/>
                                            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="6">
                                                <!-- CheckRow, not accent-filled SurfaceButtons: these are TOGGLED
                                                     OPTIONS, so they read as check-marked menu rows now, and the
                                                     indent picker is three more of the same with the check on the
                                                     active width. Tag="on" comes from the same
                                                     code that always set it. -->
                                                <StackPanel MinWidth="188">
                                                    <Button x:Name="EdOptLineNumbers" Content="{DynamicResource Str_Ed_OptLineNumbers}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdOptLineNumbers_Click"/>
                                                    <Button x:Name="EdOptCurrentLine" Content="{DynamicResource Str_Ed_OptCurrentLine}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdOptCurrentLine_Click"/>
                                                    <Button x:Name="EdOptWhitespace" Content="{DynamicResource Str_Ed_OptWhitespace}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdOptWhitespace_Click"/>
                                                    <Button x:Name="EdOptSpaces" Content="{DynamicResource Str_Ed_OptSpaces}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,6" Click="EdOptSpaces_Click"/>

                                                    <TextBlock Text="{DynamicResource Str_Ed_OptIndent}" Margin="10,0,0,3"
                                                               Foreground="{DynamicResource DimTextBrush}"
                                                               FontFamily="Consolas" FontSize="10"/>
                                                    <Button x:Name="EdIndent2" CommandParameter="2" Content="2"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdIndent_Click"/>
                                                    <Button x:Name="EdIndent4" CommandParameter="4" Content="4"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdIndent_Click"/>
                                                    <Button x:Name="EdIndent8" CommandParameter="8" Content="8"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,6" Click="EdIndent_Click"/>

                                                    <!-- Font and size are NOT here. They live in
                                                         the Fonts dialog beside the app and
                                                         terminal slots (Fonts.cs), because a
                                                         font picker belongs with the other font
                                                         pickers rather than buried in a gear on
                                                         one surface - and only there can it
                                                         offer the installed fixed-width faces
                                                         instead of a nudge button. -->
                                                    <Button x:Name="EdOptFonts" Content="{DynamicResource Str_Ed_OptFonts}"
                                                            Style="{StaticResource SurfaceButton}" HorizontalContentAlignment="Left"
                                                            Padding="10,3" FontSize="11" Click="EdOptFonts_Click"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- The grain, OVER the rows like every menu - a
                                                 checked row's solid fill painted over it when it
                                                 sat below the items. -->
                                            <Border Style="{StaticResource FlyoutGrain}" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Popup>
                                </StackPanel>

                                <!-- The full path, because the tab only has room for the name and
                                     two files called settings.json are otherwise identical. Click
                                     to edit and press Enter to rename/move the file on disk
                                     (EditorBar.cs EdPath_Click / EditorPathBox_*) - the same
                                     click-to-edit shape as the shell's cwd box above. Cursor and
                                     ToolTip are set from code (SyncEditorBar), not here, because
                                     they only turn on once the document has a real path; an
                                     untitled document has nothing yet to rename. -->
                                <TextBlock x:Name="EditorPathText" Grid.Column="1" Margin="10,0,10,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonUp="EdPath_Click"/>
                                <TextBox x:Name="EditorPathBox" Grid.Column="1" Visibility="Collapsed"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                         VerticalContentAlignment="Center"
                                         PreviewKeyDown="EditorPathBox_KeyDown"
                                         LostFocus="EditorPathBox_LostFocus"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- The encoding readout is a picker, not just a label - click
                                         it to change what the NEXT save writes (EditorBar.cs
                                         EditorEncoding_Click / EdEncoding_Click). Same borderless-
                                         chip treatment as the readout it replaces at rest;
                                         SurfaceButton's own hover/press states are what says it is
                                         now clickable. Popup anchored to THIS button, not a fixed
                                         point (the locked family flyout rule) - Placement="Bottom"
                                         because the bar sits at the top of the pane, same as the
                                         gear and go-to popups right next to it. -->
                                    <Button x:Name="EditorEncodingBtn" Style="{StaticResource SurfaceButton}"
                                            Background="Transparent" BorderThickness="0" Padding="4,2"
                                            Foreground="{DynamicResource DimTextBrush}"
                                            FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"
                                            ToolTip="{DynamicResource Str_TT_EdEncoding}" Click="EditorEncoding_Click"/>
                                    <Popup x:Name="EditorEncodingPopup" PlacementTarget="{Binding ElementName=EditorEncodingBtn}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           HorizontalOffset="-14" VerticalOffset="-2">
                                        <Grid Margin="14">
                                            <!-- MenuShadow tokens, not FlyoutShadowOpacity: that key is 0 on
                                                 98SE, which erased these popups' shadows there - the tokens keep
                                                 the ordinary themes' soft shadow and give 98SE the Win98 offset
                                                 shadow. -->
                                            <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False"
                                                    Opacity="{DynamicResource MenuShadowOpacity}"
                                                    Effect="{DynamicResource MenuShadowEffect}"/>
                                            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="6">
                                                <!-- CheckRow - same conversion as the gear popup: the picked
                                                     encoding wears the check instead of an accent fill.
                                                     SyncEditorEncodingMenu already sets Tag="on". -->
                                                <StackPanel MinWidth="168">
                                                    <Button x:Name="EdEncUtf8" CommandParameter="utf8" Content="{DynamicResource Str_Ed_EncUtf8}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdEncoding_Click"/>
                                                    <Button x:Name="EdEncUtf8Bom" CommandParameter="utf8bom" Content="{DynamicResource Str_Ed_EncUtf8Bom}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdEncoding_Click"/>
                                                    <Button x:Name="EdEncUtf16Le" CommandParameter="utf16le" Content="{DynamicResource Str_Ed_EncUtf16Le}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdEncoding_Click"/>
                                                    <Button x:Name="EdEncUtf16Be" CommandParameter="utf16be" Content="{DynamicResource Str_Ed_EncUtf16Be}"
                                                            Style="{StaticResource CheckRow}" Margin="0,0,0,2" Click="EdEncoding_Click"/>
                                                    <Button x:Name="EdEncAnsi" CommandParameter="ansi" Content="{DynamicResource Str_Ed_EncAnsi}"
                                                            Style="{StaticResource CheckRow}" Click="EdEncoding_Click"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- The grain, OVER the rows like every menu - same
                                                 gap as the gear popup above. -->
                                            <Border Style="{StaticResource FlyoutGrain}" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Popup>
                                    <TextBlock x:Name="EditorEolText" Margin="10,0,0,0"
                                               Foreground="{DynamicResource DimTextBrush}"
                                               FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- No grain layer here either, same reasoning as TerminalSlot above: the
                         editor paints its own background and text as one opaque surface
                         (Editing/EditorControl.ApplyTheme), so grain declared after it would only
                         ever sit on top of the document's own writing. -->
                    <ContentControl Grid.Row="1" x:Name="EditorSlot" Focusable="False"/>
                    <!-- The document's own sunken well, exactly the terminal's four Borders one
                         host up: Grid.Row 1 ONLY so it rings the text surface and not the editor
                         bar, ZIndex over the editor because AvalonEdit paints opaquely edge to
                         edge. It puts something around the edge to define it - a sunken pane like
                         the sidebar's. Inert off 98SE - every thickness is 0. -->
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            BorderBrush="{DynamicResource PaneBevelDarkBrush}"  BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelDark2Brush}"  BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                    <Border Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="5"
                            Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                </Grid>
                <!-- A Task Manager tab draws here, on the same terms as the shell and the
                     document above it: declared before the list, only ever one of the four
                     visible, and grain-wrapped so it sits on the pane's texture instead of in a
                     hole cut out of it. Unlike the other two this has no separate bar row of its
                     own - ProcessListControl carries its filter box and grid in one surface, so
                     there is nothing here for a location-style bar to say. -->
                <Grid x:Name="ProcessListHost" Visibility="Collapsed">
                    <ContentControl x:Name="ProcessListSlot" Focusable="False"/>
                    <!-- NO grain layer. PaneContent above already paints grain across the whole
                         content pane, so a second tile inside a tool host DOUBLED it - which is
                         why every tool tab looked heavily textured next to the file listing,
                         which never had the extra layer (2026-08-09). Same mistake the bookmarks
                         drawer had against the sidebar's continuous grain. -->
                    <!-- No host-level well here: a ring at this scope boxed in the control's own
                         filter bar too. The 98SE tiers live INSIDE ProcessListControl now
                         (ToolTabChrome: raised bar, sunken grid well). -->
                </Grid>
                <!-- An Event Viewer tab draws here, on the same terms as the Task Manager grid
                     above: declared before the list, only ever one of the four visible, and
                     grain-wrapped so it sits on the pane's texture instead of in a hole cut out
                     of it. EventViewerControl carries its own log/level pickers and filter box
                     in one surface, so there is nothing here for a location-style bar to say. -->
                <Grid x:Name="EventViewerHost" Visibility="Collapsed">
                    <ContentControl x:Name="EventViewerSlot" Focusable="False"/>
                    <!-- NO grain layer. PaneContent above already paints grain across the whole
                         content pane, so a second tile inside a tool host DOUBLED it - which is
                         why every tool tab looked heavily textured next to the file listing,
                         which never had the extra layer (2026-08-09). Same mistake the bookmarks
                         drawer had against the sidebar's continuous grain. -->
                    <!-- No host-level well - same reasoning as ProcessListHost above; the 98SE
                         tiers live inside EventViewerControl now (ToolTabChrome). -->
                </Grid>
                <!-- A Performance Monitor tab draws here, on the same terms as the Task Manager
                     and Event Viewer grids above: declared before the list, only ever one of the
                     five visible, and grain-wrapped so it sits on the pane's texture instead of in
                     a hole cut out of it. PerformanceMonitorControl carries its own hardware panel
                     and live gauges in one surface, so there is nothing here for a location-style
                     bar to say. -->
                <Grid x:Name="PerformanceHost" Visibility="Collapsed">
                    <ContentControl x:Name="PerformanceSlot" Focusable="False"/>
                    <!-- NO grain layer. PaneContent above already paints grain across the whole
                         content pane, so a second tile inside a tool host DOUBLED it - which is
                         why every tool tab looked heavily textured next to the file listing,
                         which never had the extra layer (2026-08-09). Same mistake the bookmarks
                         drawer had against the sidebar's continuous grain. -->
                    <!-- Sunken well, same as the two hosts above - the performance tab needs the
                         bevel lines around it to separate it from the rest. Inert off 98SE. -->
                    <Border IsHitTestVisible="False" Panel.ZIndex="5"
                            BorderBrush="{DynamicResource PaneBevelDarkBrush}"  BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                    <Border IsHitTestVisible="False" Panel.ZIndex="5"
                            BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                    <Border IsHitTestVisible="False" Panel.ZIndex="5"
                            Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelDark2Brush}"  BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                    <Border IsHitTestVisible="False" Panel.ZIndex="5"
                            Margin="{DynamicResource PaneBevelInnerMargin}"
                            BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                </Grid>
                <!-- A Registry Editor tab draws here, on the same terms as the other four host
                     grids above: declared before the list, only ever one of six visible, and
                     grain-wrapped so it sits on the pane's texture instead of in a hole cut out
                     of it. RegistryEditorControl carries its own address bar, tree and value
                     grid in one surface, so there is nothing here for a location-style bar to
                     say. Admin-only tab - see Shell/RegistryEditorTabs.cs. -->
                <Grid x:Name="RegistryEditorHost" Visibility="Collapsed">
                    <ContentControl x:Name="RegistryEditorSlot" Focusable="False"/>
                    <!-- NO grain layer. PaneContent above already paints grain across the whole
                         content pane, so a second tile inside a tool host DOUBLED it - which is
                         why every tool tab looked heavily textured next to the file listing,
                         which never had the extra layer (2026-08-09). Same mistake the bookmarks
                         drawer had against the sidebar's continuous grain. -->
                </Grid>
                <!-- A Storage Analyzer tab draws here, on the same terms as the other tool
                     hosts above: declared before the list, only ever one visible, grain-wrapped.
                     StorageAnalyzerControl carries its own target bar, treemap and storage-info
                     footer in one surface (Tools/StorageAnalyzerControl.cs). Same sunken well
                     as PerformanceHost, inert off 98SE. -->
                <Grid x:Name="StorageHost" Visibility="Collapsed">
                    <ContentControl x:Name="StorageSlot" Focusable="False"/>
                    <!-- NO grain layer. PaneContent above already paints grain across the whole
                         content pane, so a second tile inside a tool host DOUBLED it - which is
                         why every tool tab looked heavily textured next to the file listing,
                         which never had the extra layer (2026-08-09). Same mistake the bookmarks
                         drawer had against the sidebar's continuous grain. -->
                    <!-- No host-level well - same reasoning as ProcessListHost/EventViewerHost:
                         a well around the WHOLE host wrapped the control's own target bar in
                         the sunken frame, so on 98SE the dark bevel ran ABOVE the bar and the
                         bar read as recessed chrome (2026-08-09). The sunken tier is the
                         TREEMAP only, and its bevels live inside StorageAnalyzerControl. -->
                </Grid>
                <!-- SurfaceBrush, not the pane's own PaneBrush: a list with
                     nothing painted behind it let the pane's own PaneBrush show through behind
                     every row, so the folder listing - list, icons and details views alike, all
                     three switch panels on this one ListBox - read as the exact same flat color
                     as the surrounding pane. The terminal screen and the document editor already
                     sit one step below the pane on SurfaceBrush (TerminalPalette.cs,
                     EditorControl.cs); this brings the file browser's own content surface onto the
                     same step.
                     SurfaceBrush and the grain are their OWN Border layers below, not the
                     ListBox's own Background - texture belongs on the flat surface only, never
                     painted over the icons/text a row draws, so the ListBox itself stays
                     Transparent and lets both layers show through in the gaps around its content
                     (2026-08-03 fix: an opaque ListBox.Background here had been covering the grain
                     outright, and a grain Border added AFTER the list instead painted texture
                     straight over every icon). -->
                <!-- Visibility bound to ResultsList's own, not left unconditional: every other tab
                     type (shell, editor, registry, processes, events) collapses ResultsList when
                     IT activates (TerminalTabs.cs and siblings all set Pane.ResultsList.Visibility
                     = Collapsed), but these two backing layers are new elements those switches
                     never knew to touch - left unconditional they kept painting an opaque flat
                     layer over whatever tab type was actually showing (2026-08-03 fix: this is
                     exactly what turned a live terminal into a blank textured tab). -->
                <!-- MenuBackgroundBrush, matching the terminal screen (TerminalPalette.cs): the
                     listing and the shell are the same tier, the content half of a tab. This was
                     SurfaceBrush, which is #000000 on Black against the terminal's #121212 - so
                     the file browser came up pure black while the terminal did not, in the same
                     window. -->
                <!-- ListPaneBrush: the menu tier on every ordinary theme (matching the terminal
                     screen), and the sunken WHITE list well on 98SE, whose menu tier is #c0c0c0
                     and would otherwise leave the file listing gray. -->
                <Border IsHitTestVisible="False" Background="{DynamicResource ListPaneBrush}"
                        Visibility="{Binding Visibility, ElementName=ResultsList}"/>
                <!-- Recessed list bevel - brushes CROSSED against the thicknesses so it reads as
                     sunken, not raised. Nothing on any theme but 98SE. -->
                <!-- The CONTENT well, and the only recess in the pane - the menu bar above is
                     raised, this is sunken. The full DOUBLE bevel the sidebar's
                     tree well uses: outer #808080/#ffffff, inner #000000/#c0c0c0 at a 1px margin,
                     brushes CROSSED against the thicknesses. The requirement is that this look
                     like the sunken sidebar pane, so it is literally the same four Borders.
                     NO Visibility binding to ResultsList. These used to carry one, which meant the
                     well existed ONLY on a folder tab - open a terminal and the recess vanished,
                     which is why the bevel "was not added" on the shell tab. The well belongs to
                     the content AREA, whatever is currently in it. -->
                <!-- NO ZIndex, and Visibility bound to ResultsList exactly as the original pair
                     was. Both stray black lines - the one down the LEFT of the menu bar
                     and the one UNDER the inactive tabs - were THIS block: PaneBevelDark2Brush is
                     #000000 on 98SE (the only pure black in the pane), and ZIndex 70 lifted the
                     inner ring over the tab strip and the location row, so its left edge and its
                     top edge drew straight across both. Nothing was ever "added under the tabs" on
                     purpose; it was this ring showing through where it had no business being.
                     Scoped back to the listing, the well cannot reach either. -->
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}"
                        BorderBrush="{DynamicResource PaneBevelDarkBrush}"  BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}"
                        BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}"
                        Margin="{DynamicResource PaneBevelInnerMargin}"
                        BorderBrush="{DynamicResource PaneBevelDark2Brush}"  BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}"
                        Margin="{DynamicResource PaneBevelInnerMargin}"
                        BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"
                        Visibility="{Binding Visibility, ElementName=ResultsList}"/>
                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Padding="8,4,8,0" Focusable="True"
                         FocusVisualStyle="{x:Null}" SelectionMode="Extended"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseWheel="ResultsList_PreviewMouseWheel"
                         PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ResultsList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown"
                         ContextMenuOpening="ResultsList_ContextMenuOpening"
                         SelectionChanged="ResultsList_SelectionChanged"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources>
                        <!-- One menu for all three views. No per-item Tag bindings: the
                             right-click records what is under the pointer and each command asks
                             FilesForCommand what to act on, which is what lets a command work on
                             a whole selection ("copy 12 paths") instead of a single Tag.
                             Flat rather than nested. That USED to be forced - the MenuItem
                             template had no submenu popup, so a Copy submenu would silently
                             never open - but the template carries KillerPDF's SubPopup now, so
                             nesting the six Copy items is on the table if this list grows. -->
                        <ContextMenu x:Key="ResultMenu">
                            <MenuItem Header="{DynamicResource Str_Menu_OpenFile}"      Click="MenuOpen_Click"           InputGestureText="Enter">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8E5;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- Edit opens the file in a TAB rather than through its association,
                                 which is the point on a script: opening a .ps1 the normal way
                                 runs it (ResultsMenu.cs MenuEdit_Click). -->
                            <MenuItem Header="{DynamicResource Str_Menu_Edit}"          Click="MenuEdit_Click"           InputGestureText="F7">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE70F;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_OpenWith}"      Click="MenuOpenWith_Click"       InputGestureText="Ctrl+Shift+O">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7AC;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_OpenAdmin}"     Click="MenuOpenAdmin_Click"      InputGestureText="Ctrl+Shift+Enter">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Str_Menu_ShowExplorer}"  Click="MenuShowInExplorer_Click" InputGestureText="F6">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE838;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_SearchHere}"    Click="MenuSearchHere_Click"     InputGestureText="F3">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE721;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- Shells, grouped with the other "act on this folder" verbs above
                                 rather than with the file commands: a terminal opens ON a folder,
                                 the same way Show in Explorer and Search inside this folder do.
                                 The keyboard had these from the start (F8 / Ctrl+F8) and the
                                 menu did not, which made the whole feature keyboard-only. -->
                            <MenuItem Header="{DynamicResource Str_Menu_OpenTerminal}"  Click="MenuTerminal_Click"       InputGestureText="F8">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE756;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_OpenTerminalAdmin}" Click="MenuTerminalAdmin_Click" InputGestureText="Ctrl+F8">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7EF;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- Another "act on this folder" verb, so it sits with the shells
                                 rather than with the file commands. The same row appears on a
                                 tree node and a saved place - a folder offers the same verbs
                                 wherever it is drawn. -->
                            <MenuItem Header="{DynamicResource Str_Menu_AnalyzeStorage}" Click="MenuAnalyze_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEDA2;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_ExcludeFolder}" Click="MenuExcludeFolder_Click"  InputGestureText="Ctrl+Shift+E">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE738;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- Header swaps between add and remove as the menu opens, so one
                                 item covers both directions (ResultsMenu.cs). -->
                            <MenuItem Tag="fav" Header="{DynamicResource Str_Menu_AddFavorite}"
                                      Click="MenuFavorite_Click" InputGestureText="Ctrl+D">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE734;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <!-- E8C8 is MDL2's Copy (two stacked documents). This was E71B, which
                                 is LINK - a chain - and read as "make a shortcut" rather than
                                 "copy". E8C8 is what Copy below already uses, and the editor,
                                 terminal, Registry Editor and Storage Analyzer menus too. -->
                            <MenuItem Header="{DynamicResource Str_Menu_CopyPath}"      Click="MenuCopyPath_Click"   InputGestureText="Ctrl+Shift+C">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C8;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_CopyName}"      Click="MenuCopyName_Click"   InputGestureText="Ctrl+Shift+M">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8AC;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_CopyFolder}"    Click="MenuCopyFolder_Click" InputGestureText="Ctrl+Shift+D">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8B7;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_CopyLines}"     Click="MenuCopyLines_Click"  InputGestureText="Ctrl+Shift+Y">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A5;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- "Copy file" used to sit here. It was PutFilesOnClipboard(Copy)
                                 written twice - same CF_HDROP, same Preferred DropEffect blob,
                                 same status key as Ctrl+C / Copy below. Removed as redundant. -->
                            <MenuItem Header="{DynamicResource Str_Menu_CopyHash}"      Click="MenuCopyHash_Click"   InputGestureText="Ctrl+Shift+H">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE72E;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- File operations (FileCommands.cs). Cut / Copy / Paste sit above
                                 the destructive pair, and New folder last, so Delete never lands
                                 where the eye expects Paste. -->
                            <Separator/>
                            <!-- InputGestureText is the literal chord, never a localized string:
                                 a key name is the same in every language, and this is how
                                 KillerPDF's MakeMenuItem passes it. Each one below is a binding
                                 that really exists in Window_PreviewKeyDown - an item showing a
                                 shortcut that does nothing is worse than showing none. -->
                            <MenuItem Header="{DynamicResource Str_Menu_Cut}"           Click="MenuCut_Click"       InputGestureText="Ctrl+X">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C6;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_Copy}"          Click="MenuCopy_Click"      InputGestureText="Ctrl+C">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C8;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_Paste}"         Click="MenuPaste_Click"     InputGestureText="Ctrl+V">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE77F;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_Rename}"        Click="MenuRename_Click"    InputGestureText="F2">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8AC;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_Delete}"        Click="MenuDelete_Click"    InputGestureText="Delete">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE74D;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_NewFolder}"     Click="MenuNewFolder_Click" InputGestureText="Ctrl+Shift+N">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8F4;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Str_Menu_Properties}"    Click="MenuProperties_Click" InputGestureText="Alt+Enter">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE946;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Menu_ShellMenu}"     Click="MenuShell_Click"      InputGestureText="Shift+F10" Tag="shellmenu">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE712;"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>

                        <!-- Panels. List and details stack; icons wrap. The wrap panel virtualizes
                             (VirtualizingWrapPanel.cs) because a results list is not a directory
                             listing - it reaches six figures, and a plain WrapPanel would realize
                             every tile. Tile geometry comes from the shared view state, so one
                             size change relays the whole grid. -->
                        <ItemsPanelTemplate x:Key="PanelStack">
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                        <ItemsPanelTemplate x:Key="PanelWrap">
                            <local:VirtualizingWrapPanel
                                ItemWidth="{Binding Tag.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                ItemHeight="{Binding Tag.TileHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </ItemsPanelTemplate>

                        <!-- ICON VIEW. Fixed-size tile: art on top, name wrapped to two lines
                             under it. No expander - a tile cannot carry matched content lines,
                             and the wrap panel needs every item the same height anyway. The art
                             is set by an attached behavior rather than a plain binding because it
                             depends on both the file and the current size, and containers get
                             recycled onto different files as the grid scrolls (ResultsView.cs). -->
                        <DataTemplate x:Key="TileTemplate" DataType="{x:Type models:SearchResult}">
                            <!-- x:Name="TileBd" so TileResultText (AppStyles.xaml) can bind the
                                 filename's hover-green to this Border's own IsMouseOver - the
                                 exact same condition that already drives the gray hover
                                 background below, so the two effects light up together. -->
                            <Border x:Name="TileBd" CornerRadius="4" Cursor="Hand"
                                    Margin="{Binding Tag.TileMargin, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Padding="{Binding Tag.TilePad, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Tag="{Binding FilePath}" ToolTip="{Binding FilePath}"
                                    PreviewMouseLeftButtonDown="ResultHeader_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Image HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MaxWidth="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           Height="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           shellns:TileArt.Path="{Binding FilePath}"
                                           shellns:TileArt.IsDirectory="{Binding IsDirectory}"
                                           shellns:TileArt.Size="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                    <!-- TileResultText, not the shared ResultText: the filename here
                                         turns accent-green on HOVER, not on selection
                                         - moved off the selected state, which now shows
                                         the default text color. Scoped to this tile template only;
                                         the details/list view's Name column still uses ResultText
                                         and keeps its selected-row-turns-green behavior. -->
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource TileResultText}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="10.5"
                                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="30"
                                               Margin="{Binding Tag.TileNamePad, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!-- DETAILS VIEW. One flat row per result under the sortable column
                             headers above. Column widths and the scrollbar-clearing right pad
                             are duplicated from DetailsHeader; change both together. -->
                        <DataTemplate x:Key="DetailsRowTemplate" DataType="{x:Type models:SearchResult}">
                            <Border Cursor="Hand" Tag="{Binding FilePath}"
                                    Padding="{Binding Tag.RowPad, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    PreviewMouseLeftButtonDown="ResultHeader_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBg}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource SelectionFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Grows with the icon (RowIconColumn) - keep DetailsHeader in step. -->
                                        <ColumnDefinition Width="{Binding Tag.RowIconColumn, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <!-- Same five plus a trailing star filler as DetailsHeader,
                                             in the same order. Change one, change both. -->
                                        <ColumnDefinition Width="{Binding Tag.NameWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <!-- Collapses to 0 while browsing - see LocationWidth. -->
                                        <ColumnDefinition Width="{Binding Tag.LocationWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <ColumnDefinition Width="{Binding Tag.SizeWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <ColumnDefinition Width="{Binding Tag.ModifiedWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- TileArt rather than {Binding Icon}, which is a fixed 32px
                                         bitmap: Ctrl+wheel climbs to 64 here, and past 32 that
                                         one would be upsampled. Same attached properties the
                                         tile grid uses, so the shell hands back the right image
                                         at each step instead of a resized copy of one. -->
                                    <Image Grid.Column="0"
                                           Width="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           Height="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           shellns:TileArt.Path="{Binding FilePath}"
                                           shellns:TileArt.IsDirectory="{Binding IsDirectory}"
                                           shellns:TileArt.Size="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource ResultText}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Directory}" Style="{StaticResource ResultDim}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource ResultMuted}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center"
                                               TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedLabel}" Style="{StaticResource ResultMuted}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.Resources>

                    <!-- The menu hangs off the ListBox rather than off the Border inside each of
                         the three item templates. One owner instead of one per realized
                         container: a ContextMenu is a FrameworkElement, so assigning the same
                         resource instance to every Border gave it a single owner anyway -
                         whichever container WPF handed it to last, which recycling then
                         unparents as the list scrolls. Attaching here sidesteps that entirely,
                         and the seed comes from whatever is under the pointer when the menu
                         opens, so all three views behave the same. -->
                    <ListBox.ContextMenu>
                        <StaticResource ResourceKey="ResultMenu"/>
                    </ListBox.ContextMenu>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SearchResult}">
                            <Border Style="{StaticResource Card}" BorderThickness="1" Padding="0" Margin="2,0,4,8" Effect="{StaticResource ShadowBar}">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource PrimaryPressedBrush}" BorderThickness="2,0,0,0" CornerRadius="3,3,0,0"
                                            Padding="{Binding Tag.CardPad, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        Cursor="Hand" Tag="{Binding FilePath}"
                                            ToolTip="{DynamicResource Str_TT_Result}" MouseLeftButtonUp="ResultHeader_Click"
                                            PreviewMouseLeftButtonDown="ResultHeader_MouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Real shell icon for the file type, sized by
                                                 Ctrl+wheel (ResultsView.cs). TileArt, not
                                                 {Binding Icon}: that one is a fixed 32px bitmap
                                                 and this climbs past it. -->
                                            <Image Grid.Column="0" VerticalAlignment="Center"
                                                   Width="{Binding Tag.CardIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   Height="{Binding Tag.CardIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   shellns:TileArt.Path="{Binding FilePath}"
                                                   shellns:TileArt.IsDirectory="{Binding IsDirectory}"
                                                   shellns:TileArt.Size="{Binding Tag.CardIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{DynamicResource TextBrush}"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <!-- Size / modified columns so the sort keys are visible -->
                                            <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                                       TextAlignment="Right" MinWidth="62" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ModifiedLabel}" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CountBadge}" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <!-- Inline row actions: open file / show in Explorer -->
                                            <Button Grid.Column="5" Content="&#xE8E5;" Style="{StaticResource GrungeCalendarNavButton}"
                                                    Width="28" Height="24" FontSize="14" Margin="8,0,0,0"
                                                    ToolTip="{DynamicResource Str_Menu_OpenFile}" Tag="{Binding FilePath}" Click="OpenFile_Click"/>
                                            <Button Grid.Column="6" Content="&#xE838;" Style="{StaticResource GrungeCalendarNavButton}"
                                                    Width="28" Height="24" FontSize="14" Margin="2,0,0,0"
                                                    ToolTip="{DynamicResource Str_Menu_ShowExplorer}" Tag="{Binding FilePath}" Click="ShowInExplorer_Click"/>
                                        </Grid>
                                    </Border>
                                    <!-- Collapsed by default: folder + content matches only show once expanded. -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <!-- DirectoryWrapped = break opportunities after each backslash, so
                                         long paths wrap cleanly at separators instead of mid-name -->
                                    <TextBlock Text="{Binding DirectoryWrapped}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource MonoFont}"
                                               FontSize="10" TextWrapping="Wrap" Margin="10,6,10,0"/>
                                    <!-- Only content matches get detail rows; filename hits carry no
                                         useful detail (the header's query line says what was searched). -->
                                    <ItemsControl ItemsSource="{Binding ContentMatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TermMatch}">
                                                <StackPanel Margin="10,6,10,4">
                                                    <TextBlock Foreground="{DynamicResource PrimaryPressedBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Margin="0,0,0,3">
                                                        <Run Text="["/><Run Text="{Binding Term.ModeLabel, Mode=OneWay}"/><Run Text="]  "/><Run Text="{Binding Term.Pattern}" Foreground="{DynamicResource MutedTextBrush}"/>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:LineMatch}">
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="42"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding LineNumber}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding LineText}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Rubber-band selection layer. Sits over the list in the same cell so mouse
                     coordinates taken against the ListBox drop straight onto this canvas with no
                     conversion. Never hit-testable, or it would eat the drag it is drawing. -->
                <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False" Panel.ZIndex="10">
                    <Rectangle x:Name="MarqueeRect" Visibility="Collapsed"
                               Fill="{DynamicResource PrimaryBrush}" Opacity="0.22"
                               Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1"/>
                </Canvas>
                </Grid>
                </Border>
              </DockPanel>

              <!-- Quick-filter bar (Ctrl+F): drops down from the results pane's top edge and
                   behaves like KillerPDF's annotation bars - grain-wrapped, slideable along
                   the top via the 6-dot grip, position persisted. Esc or the x closes it. -->
              <Border x:Name="ResultFilterBar" Visibility="Collapsed" Panel.ZIndex="20"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,192,0"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                      BorderThickness="1,0,1,1" CornerRadius="0,0,5,5" Padding="10,7" Effect="{StaticResource ShadowBar}">
                  <Grid>
                      <Border IsHitTestVisible="False" CornerRadius="0,0,4,4" Margin="-10,-7"
                              Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                      <StackPanel Orientation="Horizontal">
                          <Canvas Width="10" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                  Background="Transparent" Cursor="Hand" ToolTip="{DynamicResource Str_TT_FilterResults}"
                                  MouseLeftButtonDown="FilterGrip_MouseDown" MouseMove="FilterGrip_MouseMove"
                                  MouseLeftButtonUp="FilterGrip_MouseUp">
                              <Rectangle Canvas.Left="0" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                              <Rectangle Canvas.Left="5" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                              <Rectangle Canvas.Left="0" Canvas.Top="7"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                              <Rectangle Canvas.Left="5" Canvas.Top="7"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                              <Rectangle Canvas.Left="0" Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                              <Rectangle Canvas.Left="5" Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                          </Canvas>
                          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                     Foreground="{DynamicResource DimTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBox x:Name="ResultFilterBox" Width="280" Height="28" FontSize="13" VerticalContentAlignment="Center"
                                   ToolTip="{DynamicResource Str_TT_FilterResults}" TextChanged="ResultFilterBox_TextChanged"/>
                          <Button Content="x" Style="{StaticResource DangerButton}" Width="24" Height="24" Margin="7,0,0,0" FontSize="12"
                                  Click="ResultFilterClose_Click"/>
                      </StackPanel>
                  </Grid>
              </Border>
              </Grid>
              </Border>
            </Grid>
</UserControl>
