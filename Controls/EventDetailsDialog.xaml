<Window x:Class="KillerShell.EventDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Event Details"
        Width="720" SizeToContent="Height" MinWidth="560" MinHeight="280" MaxWidth="1400" MaxHeight="900"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">

    <!-- Same shape as the About card (MainWindow.xaml AboutOverlay): a grain-wrapped surface with
         its own drop shadow on a separate border so the text never renders through a bitmap
         effect. This one is a real Window rather than an overlay Grid, because the control that
         opens it (Shell/EventViewerControl.cs) is a stand-alone control with no MainWindow overlay
         to reach - the same reason ProcessListControl's KillWithConfirm opens ConfirmDialog as its
         own Window instead. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Opacity="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <!-- Auto, not Star: SizeToContent="Height" above measures this Grid with an infinite
                 available height, and a Star row collapses to zero under an infinite constraint.
                 The ScrollViewer/AvalonEdit below still cap overflow once MaxHeight clamps the
                 window - only one of FormattedScroll/XmlHost is ever visible, and a Collapsed
                 element does not contribute to the row's measured height, so the row (and the
                 window) re-sizes when XmlToggle_Click flips which one is shown. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" IsHitTestVisible="False"
                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>

            <!-- Title bar: same wordmark-left / close-right shape as FolderPickerDialog. -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Grid VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15" Margin="1,2,0,0" Opacity="{DynamicResource IconShadowOpacity}">
                                <TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect>
                                <Run Text="Killer" Foreground="#D8000000"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/>
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15">
                                <Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Shell" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str_Evt_DetailsTitle}" FontFamily="Consolas" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,3,0,0"/>
                    </StackPanel>
                    <!-- Previous/Next: steps through the grid's current sort/filter order without
                         closing and reopening the dialog. E76B/E76C is the same chevron
                         pair the rest of the app family uses for "points toward where you're
                         going" (the sidebar rail collapse chevron convention) - Left steps back,
                         Right steps forward. Placed in the title bar, clear of the four action
                         buttons in the footer, so navigation reads as its own concept rather than
                         blending in with copy/search/xml/close. SurfaceButton's own IsEnabled
                         trigger (Controls.xaml) dims a disabled end-of-list button rather than
                         wrapping around. -->
                    <StackPanel x:Name="NavPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="0,0,40,0">
                        <Button x:Name="PrevBtn" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_EvtPrev}" Margin="0,0,4,0" Click="Prev_Click"/>
                        <Button x:Name="NextBtn" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                                ToolTip="{DynamicResource Str_TT_EvtNext}" Click="Next_Click"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="Close_Click" HorizontalAlignment="Right" Width="30" Height="26" FontSize="10"
                            FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="xb" Background="Transparent" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                    <Setter TargetName="xb" Property="Background" Value="#33C42B1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Body: the formatted field list, or the raw XML, never both - XmlToggle_Click
                 swaps which of the two is visible. -->
            <Grid Grid.Row="1" Margin="16,0,16,12">
                <ScrollViewer x:Name="FormattedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{DynamicResource PaneBrush}" CornerRadius="4" Padding="14,12,14,6">
                        <Grid>
                            <Border IsHitTestVisible="False" CornerRadius="4"
                                    Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                            <StackPanel x:Name="FieldsPanel"/>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Raw XML - collapsed until the toggle is clicked. Read-only, monospace, its
                     own scrollbars since one record's XML easily runs past the window both ways.
                     The actual editor is an AvalonEdit TextEditor, built and themed in code-behind
                     (BuildXmlEditor) the same way EditorControl.cs wires one up for a document
                     tab, so this stays wrapped rather than needing a horizontal scrollbar - and
                     unlike a plain TextBox it can carry real XML syntax highlighting. -->
                <Border x:Name="XmlHost" Visibility="Collapsed" Background="{DynamicResource PaneBrush}" CornerRadius="4"/>
            </Grid>

            <!-- Footer: icon-only buttons with tooltips (glyphs over words), each
                 also bound to a dialog-scoped shortcut (see OnKeyDown) with the shortcut shown in
                 its own tooltip - the same "description  (shortcut)" format the rest of the app's
                 tooltips use (e.g. Str_TT_SearchPanel). Online lookup + XML toggle on the left,
                 copy + close on the right. Same 26x26 / Padding(0) / SurfaceButton shape as the
                 Event Viewer toolbar's own icon buttons (EventViewerControl.cs refreshBtn). -->
            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- E943 (Code): "view raw XML" has no existing precedent in this app, so this
                         is a fresh glyph pick - checked against the rest of the app first. -->
                    <Button x:Name="XmlToggleBtn" Content="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                            ToolTip="{DynamicResource Str_TT_EvtViewXml}" Margin="0,0,8,0" Click="XmlToggle_Click"/>
                    <!-- E721: the same glyph the main window's search-panel rail button uses
                         (Shell/MainWindow.xaml SearchPanelBtn) - this is also a search action. -->
                    <Button Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                            ToolTip="{DynamicResource Str_TT_EvtSearchOnline}" Click="SearchOnline_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- E71B: the same "copy" glyph the folder tree's own Copy full path row uses
                         (MainWindow.xaml TreeCopyPath_Click) and this dialog's own right-click menu
                         (EventViewerControl.cs Grid_ContextMenuOpening) - one glyph, one action. -->
                    <Button Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                            ToolTip="{DynamicResource Str_TT_EvtCopyDetails}" Margin="0,0,8,0" Click="CopyDetails_Click"/>
                    <!-- E8BB: the same glyph this dialog's own title-bar close-X already uses. -->
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            Width="26" Height="26" Padding="0" Style="{StaticResource SurfaceButton}"
                            ToolTip="{DynamicResource Str_TT_EvtClose}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
