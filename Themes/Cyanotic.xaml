<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="GrainOpacity">0.32</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">1.0</sys:Double>

    <!-- Text-stroke shadows behind button labels (nulled on Light). -->
    <DropShadowEffect x:Key="TextStroke"     Color="Black" BlurRadius="3" ShadowDepth="0.8" Direction="270" Opacity="0.7"/>
    <DropShadowEffect x:Key="TextStrokeSoft" Color="Black" BlurRadius="2" ShadowDepth="0.6" Direction="270" Opacity="0.45"/>

    <!-- KillerShell additions for the shared KillerUI CYANOTIC theme. -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#3aa0d8" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#3aa0d8" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#3aa0d8" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#2a7099" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#04222e" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#e0d49a" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBrush"     Color="#6a8092" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"          Color="#4a88bb" po:Freeze="True"/>

    <SolidColorBrush x:Key="BackgroundBrush"     Color="#001a28" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#00263a" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBrush"           Color="#002e48" po:Freeze="True"/>
    <SolidColorBrush x:Key="TableHeaderBrush"    Color="#00263a" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush"     Color="#183450" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeLineBrush"       Color="#21466b" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"           Color="#e0d49a" po:Freeze="True"/>
    <!-- Status dot "all fine" - see Dark.xaml. Cooled toward the theme's cyan. -->
    <SolidColorBrush x:Key="OkBrush"             Color="#5fd39b" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush"     Color="#183450" po:Freeze="True"/>

    <SolidColorBrush x:Key="TextBrush"           Color="#fffde8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedTextBrush"      Color="#e0d49a" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChromeTextBrush"     Color="#ece2bc" po:Freeze="True"/>
    <SolidColorBrush x:Key="DimTextBrush"        Color="#c0aa68" po:Freeze="True"/>

    <SolidColorBrush x:Key="RowAltBrush"         Color="#18FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHoverBrush"       Color="#0a5478" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#44ffffff" po:Freeze="True"/>
    <!-- Selection fill + its text. Split from RowSelectedBrush so the light family can
         use the darker shared KillerUI accent fill with white text without
         dragging the button pressed-states dark with it. -->
    <SolidColorBrush x:Key="SelectionBg"        Color="#44ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"        Color="#3aa0d8" po:Freeze="True"/>

    <SolidColorBrush x:Key="InputBorderBrush"    Color="#183450" po:Freeze="True"/>
    <!-- Menu surface compatibility defaults; KillerUI overlays the authoritative values. -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#001624" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBorderBrush"     Color="#093250" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"       Color="#e0d49a" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush"      Color="#0a5478" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#44ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#aae0d49a" po:Freeze="True"/>
    <!-- Resting accent edge - see Dark.xaml. -->
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#663aa0d8" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#f2ead0" po:Freeze="True"/>

    <!-- Device-type label colors (bright, for dark panes) -->
    <SolidColorBrush x:Key="TypeRouter"     Color="#F0A030" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeWindows"    Color="#8FC4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypePrinter"    Color="#D080A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSwitch"     Color="#C0C0C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHypervisor" Color="#E06060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeNas"        Color="#40C080" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeIot"        Color="#A24FD8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeServer"     Color="#E08050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeLinux"      Color="#D0C050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDns"        Color="#50B0D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHa"         Color="#50D0A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMobile"     Color="#A0A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCamera"     Color="#F0C060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSmarttv"    Color="#E0A0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMedia"      Color="#70C0E0" po:Freeze="True"/>

    <!-- Shortcut categories - see Dark.xaml. -->
    <SolidColorBrush x:Key="KsCatFile"      Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatNav"       Color="#8c1eff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatView"      Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatSearch"    Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatEdit"      Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatTabs"      Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatHelp"      Color="#39ff14" po:Freeze="True"/>

</ResourceDictionary>
