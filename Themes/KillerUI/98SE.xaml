<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <SolidColorBrush x:Key="PrimaryBrush" Color="#004f00"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3a7d44"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#003600"/>
  <SolidColorBrush x:Key="HeaderLineBrush" Color="#004f00"/>
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="OutlineBtnBrush" Color="#004f00"/>
  <SolidColorBrush x:Key="InputHoverBrush" Color="#000000"/>
  <!-- #c0c0c0 - the real Win95/98 3D-object face, and the ONE grey every surface in this theme
       uses. It was #d4d0c8 for a while, which is the Windows 2000 / XP Classic
       face: a step warmer and lighter, and visibly not the colour in any Win98 screenshot. Real
       Win98 paints the window, the dialogs, the menus, the button faces and the status cells all
       in this one value. -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#c0c0c0"/>
  <!-- GREY, not white. In Win98 the CHROME is #c0c0c0 and only a WELL - a list, a text field, a
       tree - is white. PaneBrush is KillerShell's chrome tier: the active tab, the location bar,
       the Performance backdrop. White made all of those read as inset panels floating in a grey
       window, when they are the window (verified against a Win98 screenshot). The wells
       stay white below: ListPaneBrush, SidebarPaneBrush, TextFieldBrush, SearchFieldBrush,
       RadioWellBrush. Diverges from KillerNotes' copy on purpose - there "pane" is the note
       editor, which genuinely is a white well. -->
  <SolidColorBrush x:Key="PaneBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="TableHeaderBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#808080"/>
  <SolidColorBrush x:Key="PaneBorderBrush" Color="#808080"/>
  <SolidColorBrush x:Key="AppBorderBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="#404040"/>
  <SolidColorBrush x:Key="ChromeTextBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="DimTextBrush" Color="#606060"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#08000000"/>
  <SolidColorBrush x:Key="RowHoverBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="SelectionBg" Color="#004f00"/>
  <SolidColorBrush x:Key="SelectionFg" Color="#ffffff"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#808080"/>
  <!-- Transparent: a field that carries the sunken bevel already has its edge, and drawing this
       flat line too gives it two. -->
  <SolidColorBrush x:Key="InputEdgeBrush" Color="#00000000"/>
  <!-- The era's selection shape: a SOLID block with WHITE text, in the picked accent's dark
       tone. TWO mechanisms deliver the white, because WPF has no single one that covers both
       control kinds:
       - Plain TextBoxes (search, title): SelectionTextBrush works there, but only under
         non-adorner selection rendering, which App.xaml.cs opts into via the
         UseAdornerForTextboxSelectionRendering AppContext switch in its static ctor.
       - The note editor (RichTextBox): NO property can recolor its selected text -
         SelectionTextBrush and the non-adorner renderer are documented for TextBox and
         PasswordBox only. Its white text is drawn by hand: SelectionTextAdorner
         (Shell/EditorSelectionText.cs) repaints the selected glyphs in
         TextSelectionTextBrush over the solid fill, switched on by EditorSelectionOverlay below.
       History, so nobody relives 2026-08-08: navy alone at 1.0 was an unreadable solid bar,
       0.6 and 0.4 washed out to purple, #1084d0-with-black was rejected as not the asked-for
       look, and hardcoded navy under a GREEN accent was rejected too - when the user picks an
       accent they expect the selection in that accent. The fill is SOLID, the adorner supplies
       the white, and the COLOR FOLLOWS THE ACCENT: this base file is the green accent (green
       gets no overlay), and every file in Accents/98SE/ overrides TextSelectionBrush with its
       own dark tone, matching its SelectionBg. -->
  <SolidColorBrush x:Key="TextSelectionBrush" Color="#004f00"/>
  <sys:Double x:Key="TextSelectionOpacity">1.0</sys:Double>
  <!-- The EDITOR's native selection layer. The settled spec (2026-08-08, final): selected TEXT is
       the solid accent block with white glyphs (the adorner's opaque band draws that, covering
       this layer), and a selected IMAGE gets THIS - the same dark accent at 75% - laid over it.
       No lighter "tint" brush, no border, no other cleverness. The plain TextBoxes keep the 1.0
       above: they cannot contain images and their white selected text needs the solid fill. -->
  <sys:Double x:Key="EditorSelectionOpacity">0.75</sys:Double>
  <SolidColorBrush x:Key="TextSelectionTextBrush" Color="#ffffff"/>
  <!-- The EXPLICIT opt-in for SelectionTextAdorner (Shell/EditorSelectionText.cs). The adorner
       must NOT key off the brushes above existing - ThemeManager synthesizes those for every
       theme - so this boolean is the one and only switch, and only this palette states it. -->
  <sys:Boolean x:Key="EditorSelectionOverlay">True</sys:Boolean>
  <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="MenuBorderBrush" Color="#808080"/>
  <SolidColorBrush x:Key="MenuHoverBrush" Color="#000080"/>
  <CornerRadius x:Key="WindowCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="SmallCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="FlyoutCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="AccentSwatchCornerRadius">0</CornerRadius>
  <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#004000" Offset="0"/><GradientStop Color="#3a7d44" Offset="1"/></LinearGradientBrush>

  <!-- ============================================================================================
       98SE is the kit's ONE bevelled, flat, square theme, and everything below is what makes the
       derived-token defaults in ThemeManager.ApplyDerivedTokens actually do something. Without
       this block the twelve other themes are correct and 98SE simply renders as a grey Dark - the
       kit documented a bevelled theme it could not produce.

       No theme name appears anywhere in code. Every key here is an OPT-IN override of a default,
       so a new palette that says nothing keeps the family look exactly as it was.
       ============================================================================================ -->

  <!-- Deliberately FLAT: no grain, no drop shadows, a hard 2px frame, and raised control bevels
       instead of elevation. -->
  <sys:Double x:Key="GrainOpacity">0</sys:Double>
  <sys:Double x:Key="IconShadowOpacity">0</sys:Double>
  <sys:Double x:Key="PaneShadowOpacity">0</sys:Double>
  <sys:Double x:Key="BarShadowOpacity">0</sys:Double>
  <sys:Double x:Key="FlyoutShadowOpacity">0</sys:Double>
  <!-- 3, and uniform. Total frame is 1 outer bevel + 3 face + 1 inner bevel = 5px on every side,
       which is what a real 98 sizing border measures. See WindowFrameBrush below. -->
  <Thickness x:Key="WindowFrameThickness">3</Thickness>
  <Thickness x:Key="BevelLightThickness">2,2,0,0</Thickness>
  <Thickness x:Key="BevelDarkThickness">0,0,2,2</Thickness>
  <!-- The dark bevel with its BOTTOM dropped, for the selected tab only. A Win98 tab that is
       selected has no foot: top, left and right are bevelled and the bottom is open into the page,
       which is the whole reason it reads as joined to the content rather than sitting on it. -->
  <Thickness x:Key="TabActiveBevelDarkThickness">0,0,2,0</Thickness>
  <!-- An INACTIVE tab: 2px dark down its right, ONE pixel along its foot. This value is settled -
       do not move it again in either direction. The shared BevelDarkThickness is 0,0,2,2 and that
       2px foot read as a doubled rule that made the raised menu bar below look sunken; 0 was then
       tried and removed the line under the inactive tabs entirely, which is also wrong. A single
       1px line is the settled answer (2026-08-09). -->
  <Thickness x:Key="TabInactiveBevelDarkThickness">0,0,2,1</Thickness>
  <!-- The family literal is -12,-4,-5,-5. The bottom is trimmed to -4 here: the pane rides up by
       the page bevel's full 2px now (PaneOuterMargin), so a -5 overhang put the tab's right-hand
       dark edge one pixel below its own foot, into the pane. -->
  <Thickness x:Key="TabBevelMargin">-12,-4,-5,-4</Thickness>
  <!-- The ACTIVE tab's DARK bevel margin, settled after THREE rounds (2026-08-09):
       -4 ran the dark edge 2px through the white line ("dripping down"), -2 alone left the
       tab's own fill plugging the line ("a dot of light gray"). The answer is BOTH pieces:
       -2 ends the dark edge level with the strip line, and TabSeamPatchBrush (below) paints
       the tab's bottom-right 2x2 white so the bar's white top line runs beneath the dark edge
       exactly as it does at every inactive seam. Change one without the other and one of the
       two complaints comes back. -->
  <Thickness x:Key="TabActiveBevelDarkMargin">-12,-4,-5,-2</Thickness>
  <!-- The 2x2 white corner patch under the active tab's dark right edge - see the note above. -->
  <SolidColorBrush x:Key="TabSeamPatchBrush" Color="#ffffff"/>
  <!-- ComboBox as Win98 drew it: WHITE edit field, WHITE dropdown list, a
       raised grey arrow button filling the field's right edge with Marlett's solid triangle,
       and WHITE text on the navy highlight bar. The ChevMargin undoes the field's 7,3 padding
       (minus its 1px border) so the button reaches the field edges. -->
  <SolidColorBrush x:Key="ComboFieldBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="ComboPopupBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="ComboButtonBrush" Color="#c0c0c0"/>
  <sys:Double x:Key="ComboButtonMinWidth">16</sys:Double>
  <Thickness x:Key="ComboChevMargin">5,-2,-6,-2</Thickness>
  <Thickness x:Key="ComboChevGlyphMargin">0</Thickness>
  <sys:String x:Key="ComboChevGlyph">6</sys:String>
  <FontFamily x:Key="ComboChevFont">Marlett</FontFamily>
  <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#ffffff"/>
  <!-- The dual-pane FOCUSED tab draws NO ring here at all: thicknesses zero, paddings the
       active tab's own. The family defaults (ThemeManager) are the accent ring's 1,3,1,0 sets;
       with this theme's transparent ring brush even those transparent borders kept the tab's
       fill out of its edge columns, letting the menu bar's white top line show through as a
       stray white pixel at the tab's right edge (2026-08-09). -->
  <Thickness x:Key="TabFocusThickness">0</Thickness>
  <Thickness x:Key="TabFocusFirstThickness">0</Thickness>
  <Thickness x:Key="TabFocusLastThickness">0</Thickness>
  <Thickness x:Key="TabFocusOnlyThickness">0</Thickness>
  <Thickness x:Key="TabFocusPadding">12,4,5,4</Thickness>
  <Thickness x:Key="TabFocusFirstPadding">12,4,5,4</Thickness>
  <Thickness x:Key="TabFocusLastPadding">12,4,5,4</Thickness>
  <Thickness x:Key="TabFocusOnlyPadding">12,4,5,4</Thickness>
  <!-- The family literal is 4,6,2,6. A Win98 list well is filled edge to edge: the 6px top was the
       3px white strip measured inside the sunken frame, and it pushed the scrollbar down
       with it. 2px of left inset is kept so the first glyph is not welded to the bevel; top,
       bottom and right go to zero so the scrollbar meets the frame (2026-08-09). -->
  <Thickness x:Key="TreePanePadding">2,0,0,0</Thickness>
  <!-- Square, like every other radius here. The Performance tab's tiles and sparkline hosts are
       code-built, so they cannot take a DynamicResource and carried C# literals instead - the same
       class of bug as the pane and tab radii. ThemeManager.Radius reads this. -->
  <CornerRadius x:Key="ChartCornerRadius">0</CornerRadius>
  <!-- The 45-degree cut across each top corner of a tab, in device pixels. 0 everywhere else, so
       no other theme grows a chamfer. TabChamferConverter turns this into the clip geometry. -->
  <sys:Double x:Key="TabChamfer">3</sys:Double>
  <!-- The family literal is 12,4,5,5. One pixel off the bottom: a Win98 tab is slightly shorter
       than the family's, which goes alongside the chamfer (2026-08-09). -->
  <Thickness x:Key="TabPadding">12,4,5,4</Thickness>
  <!-- The ACTIVE tab's padding. The derived default is 12,4,5,5, but the tab's bevel borders undo
       the padding with a FIXED margin (TabBevelMargin, bottom -4) - so with a 5px bottom the
       active tab's white left bevel stopped 1px above its own foot, and that pixel of bare face
       broke the line where the tab joins the menu bar's white left edge - 1px of gray in that
       left bevel line between the active tab and the menubar. Bottom 4
       matches TabBevelMargin exactly, so the bevel reaches the foot and the join is unbroken. -->
  <Thickness x:Key="TabActivePadding">12,4,5,4</Thickness>
  <SolidColorBrush x:Key="BevelLightBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="BevelDarkBrush" Color="#808080"/>
  <!-- The page well's bevel is NOT stated here: it reuses the PaneBevel* keys further down, the
       same four this theme already gives the sidebar's tree well, so the two cannot drift apart.
       A single-ring PageBevel* pair was tried on 2026-08-09 and came out completely wrong - it
       is supposed to look like the sunken sidebar pane. A Win98 recess is a
       DOUBLE bevel; one 2px line is not it. -->

  <!-- No borders at all on the details strip: flat down the left and right, and no rule along its
       top either. The strip is meant to be completely flat on its sides (2026-08-09). -->
  <Thickness x:Key="DetailsPaneBorderThickness">0</Thickness>
  <!-- The divider between the detail fields and the preview image, gone with them. -->
  <sys:Double x:Key="DetailsDividerWidth">0</sys:Double>
  <!-- The family literal, unchanged. DO NOT put a gap between tabs. A 2px right margin was tried
       here to make the tab's RIGHT chamfer visible against the band, and it was rejected
       immediately - do not add space between tabs. Win98 tabs
       butt against each other. If the right chamfer needs to read, it has to be solved by drawing
       it, not by moving the tabs apart (2026-08-09). -->
  <!-- Top 5 against the active tab's 3: an INACTIVE tab tops out 2px LOWER than the selected
       one, which is how Win98 tells them apart. Top 4 was measured off a screenshot at only 1px
       of difference, which did not read at all - the inactive tabs need to be 1-2 px shorter
       than the active tab. The active tab overrides this margin with 0,3,0,0 in
       its IsActive trigger.
       Bottom is 2, matching the pane's 2px ride-up (PaneOuterMargin): at 1 the inactive tab's
       LAST row landed on the bar's FIRST white row, so its dark foot and every 2px dark divider
       between tabs poked one pixel into the white line - the "1px gray dot" at each seam.
       At 2 the tab ends exactly where the white line begins. -->
  <Thickness x:Key="TabMargin">0,5,0,2</Thickness>
  <!-- The family literal, unchanged vertically. The cell grows by shedding FooterCellMargin, not
       by padding the text - padding it inside a fixed 24px row only squeezes the line box. -->
  <Thickness x:Key="FooterStatusPadding">10.5,0,12,0</Thickness>
  <!-- The tab band's ring when the pane is not the lit half of a dual pane. Transparent here: the
       tab's own bevel and the page bevel already describe the join, and this ring was drawing a
       grey rule under the active tab plus two 1px verticals hanging 6px into the top of the pane,
       the left one landing right where the menu bar starts. Mirrors
       PaneBorderBrush everywhere else, so only this theme changes. -->
  <SolidColorBrush x:Key="TabRingIdleBrush" Color="Transparent"/>
  <!-- The dual-pane FOCUS ring, transparent like the idle ring above. It defaults to PrimaryBrush
       (ThemeManager), which in dual pane drew the accent as a 1px line across the focused pane's
       band, down its outer verticals, and a stripe over the active tab - all alien here, where a
       tab is marked by its bevel and its join to the page. The focused pane
       still reads from its selection and title colors. -->
  <SolidColorBrush x:Key="TabActiveRingBrush" Color="Transparent"/>
  <!-- No rule under the shell/document menu bar. A Win98 toolbar is a raised band with a highlight
       along its top, not a panel underlined in grey. -->
  <Thickness x:Key="BarUnderlineThickness">0</Thickness>
  <!-- 24, the family height. DO NOT raise this. It was briefly 32, which was wrong: it is the
       sunken CELL that grows about 4px above and below - the box INSIDE the footer - not the
       footer bar itself. The cell grows via FooterCellMargin below, which is the only thing that
       should ever change here (2026-08-09). -->
  <sys:Double x:Key="FooterHeight">24</sys:Double>

  <!-- The window's RAISED double bevel, exactly what Win32 draws for EDGE_RAISED on a sizing
       border. Two 1px rings wrapping the face, and BOTH are directional - light on the top/left,
       dark on the bottom/right - which is what makes every right and bottom edge in the reference
       screenshot look bevelled.

         outer ring   #dfdfdf top/left   #000000 bottom/right   (3DLight / DkShadow)
         inner ring   #ffffff top/left   #808080 bottom/right   (Highlight / Shadow)
         face         4px

       The black is on the bottom/right ONLY. Earlier this was black on all four sides, which read
       as a hard outline bolted around the app; directional, it is just the window's shadow side.

       This is NOT the sunken bevel that marks a white client area - that one is crossed (dark on
       the top/left) and belongs to the notes list, the editor and the text fields, not here. -->
  <SolidColorBrush x:Key="FrameOuterLightBrush" Color="#dfdfdf"/>
  <SolidColorBrush x:Key="FrameOuterDarkBrush" Color="#000000"/>
  <Thickness x:Key="FrameOuterLightThickness">1,1,0,0</Thickness>
  <Thickness x:Key="FrameOuterDarkThickness">0,0,1,1</Thickness>
  <SolidColorBrush x:Key="FrameInnerLightBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="FrameInnerDarkBrush" Color="#808080"/>

  <!-- The window frame, 5px on EVERY side. Measured off a real 98 window it
       is 1px outer bevel + 3px of face + 1px inner bevel, the same all the way round - so the top
       matches the sides matches the bottom, and it lines up with the footer spacer. It used to
       carry the shared 2px control bevel, which made the left and right raised edges visibly
       fatter than the frame they sit in.

       The face is a GRADIENT, not the flat #c0c0c0 it was. Win98's frame catches the light across
       its width; 3px of one grey reads as a slab, and this is the difference between "there is a
       border here" and "this window has an edge". Lit at the top/left corner, falling to shadow
       at the bottom/right, matching the direction every bevel in the theme already implies. -->
  <LinearGradientBrush x:Key="WindowFrameBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#cbcbcb" Offset="0"/>
    <GradientStop Color="#bcbcbc" Offset="1"/>
  </LinearGradientBrush>
  <!-- 1px outer bevel + 4px face = 5px, and the content is held off by exactly that 5 so the two
       never overlap. Nothing else is added on top: the sidebar's own inset is zeroed below, or it
       stacks on the frame and the band comes out at 13px. -->
  <!-- 1 outer ring + 1 inner ring + 3 face = 5, and the content is held off by exactly that 5 so
       the two never overlap. Each layer is inset past the one outside it, or they all anchor to
       pixel 0 and paint over each other. -->
  <Thickness x:Key="WindowFrameMargin">2</Thickness>
  <!-- EXACTLY the frame: 1px outer ring + 1px inner ring = 2, so the content starts on the first
       pixel past the bevel and there is NO face gutter anywhere. Win98 has no gap between a
       window's raised edge and its caption, and none between the caption and the client area.
       This was 5,4,5,5, which left 3px of bare grey down the left, right and bottom and 2px above
       the caption - the "bar above the titlebar that needs trimming", and the reason the right
       edge did not read the same width as the left.
       Uniform on all four sides, so left and right are the same width by construction and cannot
       drift apart again. -->
  <Thickness x:Key="WindowFramePadding">2</Thickness>
  <!-- Zero, now that the padding above IS the frame. The -1 bleed existed to drag the caption back
       out over a gutter that no longer exists; leaving it in would push the caption UNDER the
       inner bevel and clip a pixel off each end of the gradient. -->
  <Thickness x:Key="TitleBarBleed">0</Thickness>
  <!-- 2,2,2: the About card's bevel is painted OVER its outer 2px by sibling borders, and with
       no margin the caption band ran underneath it - flush left/top under the WHITE bevel (which
       read as a gap) but meeting the GRAY bevel edge-to-edge on the right (which read as the
       caption running 1-2px past the frame). Win98 leaves a sliver of face color between a
       dialog's raised edge and its caption; with the card's own 1px border this margin yields
       exactly that: 2px bevel, 1px face, then the band, symmetric on left, top and right. -->
  <Thickness x:Key="AboutCaptionMargin">2,2,2,0</Thickness>
  <!-- The About card's CONTENT inset. Sides match the caption band's 2; the top adds breathing
       room between the band and the wordmark. -->
  <Thickness x:Key="AboutContentMargin">2,10,2,0</Thickness>
  <!-- The details pane's big filename: Courier New, the era's monospace, instead of the family
       typewriter face. -->
  <FontFamily x:Key="DetailsNameFont">Courier New</FontFamily>
  <!-- The etched toolbar divider: 2px, grey then white, hard stop between them. Offset 0.5 on
       both stops is what makes it two solid 1px rules instead of a blend. -->
  <!-- Menus get the same EDGE_RAISED double bevel as a window: white over BLACK outside, #dfdfdf
       over #808080 within. 1px per ring - a menu's edge is 2px total, not the 5 a sizing border
       gets. Context menus carry the darker bevel too. -->
  <SolidColorBrush x:Key="MenuBevel2LightBrush" Color="#ffffff"/>
  <!-- #808080, no longer #000000: the black outer ring made a context menu's right and bottom
       edges read too dark next to the flyouts' plain white/#808080 bevel.
       Both menu surfaces carry the same shadow tone now. -->
  <SolidColorBrush x:Key="MenuBevel2DarkBrush" Color="#808080"/>
  <Thickness x:Key="MenuBevel2LightThickness">1,1,0,0</Thickness>
  <Thickness x:Key="MenuBevel2DarkThickness">0,0,1,1</Thickness>
  <SolidColorBrush x:Key="MenuBevelLightBrush" Color="#dfdfdf"/>
  <SolidColorBrush x:Key="MenuBevelDarkBrush" Color="#808080"/>
  <Thickness x:Key="MenuBevelLightThickness">1,1,0,0</Thickness>
  <Thickness x:Key="MenuBevelDarkThickness">0,0,1,1</Thickness>
  <Thickness x:Key="MenuBevelInnerMargin">1</Thickness>

  <!-- The dialog's rows sit tight against the 5px frame - a Win98 dialog has almost no gutter of
       its own, the frame IS the border. 16 on top of 5 was a 21px band down each side. -->
  <!-- The Win32 status bar, on. The selection moves out of the button row and into it. -->
  <sys:Double x:Key="DialogStatusBarHeight">24</sys:Double>
  <Visibility x:Key="DialogStatusBarVisibility">Visible</Visibility>
  <Visibility x:Key="DialogInlineSelVisibility">Collapsed</Visibility>

  <Thickness x:Key="DialogContentMargin">3,3,3,3</Thickness>
  <Thickness x:Key="DialogRowMargin">3,0,3,0</Thickness>
  <Thickness x:Key="DialogFieldMargin">3,4,3,0</Thickness>
  <Thickness x:Key="DialogButtonsMargin">3,4,3,4</Thickness>

  <sys:Double x:Key="BarSepWidth">2</sys:Double>
  <LinearGradientBrush x:Key="BarSepBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#808080" Offset="0"/>
    <GradientStop Color="#808080" Offset="0.5"/>
    <GradientStop Color="#ffffff" Offset="0.5"/>
    <GradientStop Color="#ffffff" Offset="1"/>
  </LinearGradientBrush>
  <Thickness x:Key="FrameInnerMargin">1</Thickness>
  <Thickness x:Key="FrameInnerLightThickness">1,1,0,0</Thickness>
  <Thickness x:Key="FrameInnerDarkThickness">0,0,1,1</Thickness>
  <!-- The sidebar sits FLUSH against the frame. The family's 8px inset assumes a 1px window edge
       and stacks on this theme's 5px frame. -->
  <Thickness x:Key="SidebarPanelMargin">0,5,0,0</Thickness>

  <!-- Win98 scrollbars: 16px wide, a dithered channel sunk into the panel, and a square raised
       thumb that FILLS the groove rather than floating in it. #dfdfdf is the era's scrollbar
       channel - the 50% checker of white and button face, flattened. -->
  <sys:Double x:Key="ScrollBarThickness">16</sys:Double>
  <CornerRadius x:Key="ScrollThumbRadius">0</CornerRadius>
  <!-- The scalar halves of the two radii above, for the code that builds a CornerRadius one corner
       at a time from which tab is active (Tabs.cs, MainWindow.xaml.cs UpdatePaneStatusBar). Those
       had 6 and 5 hardcoded, so the pane and the terminal kept three rounded corners here however
       many CornerRadius attributes in the markup were zeroed. -->
  <sys:Double x:Key="PaneCornerRadiusValue">0</sys:Double>
  <sys:Double x:Key="BarCornerRadiusValue">0</sys:Double>
  <Thickness x:Key="ScrollThumbMargin">0</Thickness>
  <!-- The HORIZONTAL thumb's inset. The shared template squeezed a horizontal thumb to 0,4 for
       the slim-overlay look, which left an 8px thumb floating in this theme's 16px track - the
       "too skinny" tree scrollbar. A Win98 thumb fills its track. -->
  <Thickness x:Key="ScrollThumbMarginH">0</Thickness>
  <SolidColorBrush x:Key="ScrollTrackBrush" Color="#dfdfdf"/>
  <!-- Despite the names, these two are the THUMB's bevel - the ScrollBar template pairs them
       with the Bevel*Thickness keys on the thumb's own borders, and nothing draws them on the
       track. They were set transparent here on the reasoning that the CHANNEL should be flat
       (which it is - ScrollTrackBrush is a plain fill), and that left the thumb a flat grey
       slab - the scrollbars should be raised, not flat. A Win98 thumb is a
       raised button: white top/left, #808080 bottom/right. -->
  <SolidColorBrush x:Key="ScrollTrackBevelDark" Color="#808080"/>
  <SolidColorBrush x:Key="ScrollTrackBevelLight" Color="#ffffff"/>
  <!-- 16px square line buttons at each end of the bar, matching the bar's own width. -->
  <sys:Double x:Key="ScrollArrowSize">16</sys:Double>

  <!-- Client areas are RECESSED here - Notepad's text area, Explorer's list. Crossed against the
       bevel thicknesses (dark on top/left, light on bottom/right) so they read as pressed in. -->
  <!-- A white client area's SUNKEN edge, two-tone, exactly as Notepad's list box draws it:

         top/left      #808080 outer, #000000 inner
         bottom/right  #ffffff outer, #c0c0c0 inner

       1px per ring, not the 2px control bevel: a button's raised edge is 2px of one tone, a
       client area's recess is 2px of TWO. Ours was 2px of flat #808080, which had the right width
       and the wrong depth - it read as a drawn line instead of an edge. -->
  <SolidColorBrush x:Key="PaneBevelDarkBrush" Color="#808080"/>
  <SolidColorBrush x:Key="PaneBevelLightBrush" Color="#ffffff"/>
  <Thickness x:Key="PaneBevelLightThickness">1,1,0,0</Thickness>
  <Thickness x:Key="PaneBevelDarkThickness">0,0,1,1</Thickness>
  <SolidColorBrush x:Key="PaneBevelDark2Brush" Color="#000000"/>
  <SolidColorBrush x:Key="PaneBevelLight2Brush" Color="#c0c0c0"/>
  <Thickness x:Key="PaneBevel2LightThickness">1,1,0,0</Thickness>
  <Thickness x:Key="PaneBevel2DarkThickness">0,0,1,1</Thickness>
  <Thickness x:Key="PaneBevelInnerMargin">1</Thickness>
  <!-- Transparent: a pane carrying the sunken bevel already has its edge. -->
  <SolidColorBrush x:Key="PaneEdgeBrush" Color="#00000000"/>
  <!-- The pane fills its frame: no card inset on the right, and no 1px ring eating the pixel the
       raised page bevel needs.
       -2 on the top, not -1 (2026-08-09). The page bevel across the top of PaneContent is
       2px of white (BevelLightThickness 2,2,0,0). At -1 the pane rode up only one of those two,
       so the second pixel drew a white rule edge to edge UNDER the active tab, dividing the tab
       from the menu bar below it. A full-width Border cannot be broken by one tab, so the pane
       has to ride up by the bevel's whole thickness and let the active tab's own opaque PaneBrush
       fill cover it. If BevelLightThickness ever changes here, this changes with it. -->
  <Thickness x:Key="PaneOuterMargin">0,-2,0,0</Thickness>
  <Thickness x:Key="TabBarMargin">0</Thickness>
  <Thickness x:Key="PaneEdgeThickness">0</Thickness>

  <!-- Status bar: sunk a hair into the window face, and split into cells by the era's two-tone
       1px rule (dark line, light line to its right) before the version panel. -->
  <SolidColorBrush x:Key="FooterBevelDarkBrush" Color="#808080"/>
  <SolidColorBrush x:Key="FooterBevelLightBrush" Color="#ffffff"/>
  <!-- 1px, crossed: dark on the LIGHT thickness (top/left) and light on the dark one, which is the
       inversion that reads as pressed in. 1 rather than the 2px control bevel - a status cell is
       the shallowest recess in the UI. The 3px margin is the GAP between cells, and that gap is
       what a Win98 divider actually is. -->
  <Thickness x:Key="FooterCellLightThickness">1,1,0,0</Thickness>
  <Thickness x:Key="FooterCellDarkThickness">0,0,1,1</Thickness>
  <!-- The gap around the cells is the SAME on all four sides. It was 2 top and
       bottom, 3 to the right and 0 to the left, so the cells sat off-centre in the footer and the
       inter-cell divider was a different width from the border gap. Each cell carries 2 on its
       top, right and bottom; the footer's own 2 on the left supplies the matching gap at the start
       of the row, so the last cell's own right margin closes it symmetrically. -->
  <!-- IDENTICAL to KillerNotes (Themes/KillerUI/98SE.xaml) - do not "improve" it. KillerNotes is
       the family reference and its footer is the approved one. It was briefly 0,0,2,0
       here in an attempt to grow the cell; the real defect was never this margin. -->
  <Thickness x:Key="FooterCellMargin">0,2,2,2</Thickness>
  <Thickness x:Key="FooterCellPadding">4,0,4,0</Thickness>
  <!-- Cells run the FULL width, flush with the sidebar's sunken edge above them - no inset of
       their own at all. The frame is already the window's border; the footer does not need to
       inset from it again.

       The right was -2, cancelling the last cell's own right margin so it finished flush. That
       worked while WindowFramePadding was 5 and there were 3 spare pixels of frame face to spend;
       with the padding now exactly the 2px frame, -2 would push the footer's last cell out ON TOP
       of the bevel and paint over the window's edge. 0 instead, which leaves the last cell the
       same 2px gap it already carries on its top and bottom - symmetric, and inside the frame. -->
  <Thickness x:Key="FooterPadding">0</Thickness>

  <!-- Edit fields and radio wells are WHITE client areas here, like every other input. -->
  <SolidColorBrush x:Key="TextFieldBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="RadioWellBrush" Color="#ffffff"/>
  <!-- The picker's tree/places column is a client area here, like Explorer's. -->
  <SolidColorBrush x:Key="SidebarPaneBrush" Color="#ffffff"/>
  <!-- Chips are BUTTONS: button-face grey with a raised bevel, never the white client colour. -->
  <SolidColorBrush x:Key="ChipFaceBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="ChipEdgeBrush" Color="#00000000"/>
  <SolidColorBrush x:Key="ChipHoverBrush" Color="#dfdfdf"/>
  <!-- OK and Cancel are the SAME button here. Win98 gives every dialog button the one grey face
       and marks the default with a heavier border, never with a different fill or text colour,
       so the family's accent-outlined confirm button beside a grey Cancel reads as two unrelated
       controls. Both keys default to the accent outline, so only this theme opts out. -->
  <SolidColorBrush x:Key="OutlineFaceBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="OutlineTextBrush" Color="#000000"/>
  <!-- RowHoverBrush is #c0c0c0 here, the same grey as the button face, so a button hovering to it
       does not change. The lighter #dfdfdf is the era's button highlight. -->
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#dfdfdf"/>
  <SolidColorBrush x:Key="OutlineHoverBrush" Color="#dfdfdf"/>
  <SolidColorBrush x:Key="OutlineHoverTextBrush" Color="#000000"/>

  <!-- Syntax highlighting. The code defaults to the VS Code Dark+ palette, built for a near-black
       editor; the page here is pure white, where its number green (#B5CEA8) lands at about 1.7:1
       and the comment green not much better - unreadable, and this theme was the worst hit of the
       thirteen. These are the Light+ equivalents, which are also the closer match to how a
       code-aware editor of the era coloured text: saturated, high contrast, no pastels. -->
  <SolidColorBrush x:Key="Syn_Comment"  Color="#008000"/>
  <SolidColorBrush x:Key="Syn_String"   Color="#a31515"/>
  <SolidColorBrush x:Key="Syn_Number"   Color="#098658"/>
  <SolidColorBrush x:Key="Syn_Variable" Color="#001080"/>
  <SolidColorBrush x:Key="Syn_Type"     Color="#267f99"/>
  <SolidColorBrush x:Key="Syn_Operator" Color="#af00db"/>
  <SolidColorBrush x:Key="Syn_Keyword"  Color="#0000ff"/>

  <!-- The format bar as a TASKBAR: a raised strip with a white top/left highlight rather than a
       floating card outlined in grey, so the tool buttons read as sitting on it. A little more
       padding for the same reason - a taskbar has air around its buttons. -->
  <SolidColorBrush x:Key="BarEdgeBrush" Color="#ffffff"/>
  <!-- LEFT and BOTTOM, both white. This is the exact path required (2026-08-09): the
       active tab's white left strip continues DOWN the left of the menu bar, then turns and runs
       HORIZONTALLY UNDER the menu bar. Left gives the vertical run, bottom gives the turn.
       No TOP: the tab band is directly above and a white line there would cut the tab off from
       the bar instead of letting the tab's own left edge flow into this one.
       The dark half is RIGHT only for the same reason - a dark bottom would paint straight over
       the horizontal white run this exists to draw. -->
  <!-- LEFT is 2, matching the tab's own white edge exactly (BevelLightThickness is 2,2,0,0), so
       the active tab's raised highlight CONTINUES down the side of the menu bar as one unbroken
       line instead of stepping from 2px to 1px at the join. The bottom stays 1
       - that is the horizontal run under the bar, a different edge doing a different job. -->
  <!-- TOP is 2 now as well (the white line must continue to the LEFT of the
       address bar, and the menu bar must read RAISED above the inactive tabs). The bar's top 2px
       sit in the rows the pane rides up under the band (PaneOuterMargin -2), so the ACTIVE tab's
       opaque fill covers its own segment and the line breaks at the tab exactly like a Win98 tab
       page's top edge. Under the shorter inactive tabs it shows below their 1px dark foot. -->
  <Thickness x:Key="BarEdgeThickness">2,2,0,1</Thickness>
  <SolidColorBrush x:Key="BarEdgeDarkBrush" Color="#808080"/>
  <Thickness x:Key="BarEdgeDarkThickness">0,0,1,0</Thickness>
  <!-- No TOP inset. The 3px on top left a gap between the tab band and the location row, and
       ResultsPane's MenuBackgroundBrush shows through it - a full step darker than the bar's
       PaneBrush - so it read as a dark line under the active tab. Only the FOLDER branch has this
       margin, which is why the terminal tab came out clean and the file browser did not.
       Sides and bottom keep their inset. -->
  <!-- ZERO on all four sides. The menu bar has to sit FLUSH LEFT or its white left edge lands 3px
       inside the pane and cannot line up with the active tab's white left strip above it - the two
       have to be one continuous line. The bottom goes to 0 for the same
       reason: the horizontal white run belongs directly under the bar, not floating 3px above the
       content. A Win98 toolbar fills its page. -->
  <Thickness x:Key="BarPadding">0</Thickness>

  <!-- The About card's info panel. Every other theme inherits the context-menu fill from
       ThemeManager; here that would be the same #c0c0c0 button face as the card behind it, so the
       panel would vanish. White plus a crossed (sunken) bevel makes it a recessed client area. -->
  <SolidColorBrush x:Key="AboutPanelBrush" Color="#ffffff"/>

  <!-- Caption buttons. A real button face INSET from the caption, so the title bar gradient ends
       AT the button rather than running under it - the thing that makes a close glyph look painted
       onto the gradient. The inset turns the 44x36 caption slot into a ~20x16 button, the Win98
       proportion. The raised bevel comes from the Bevel* keys above and reverses on press, exactly
       like every other button in this theme. Close is a BLACK glyph on the same face, not a red
       one, and does not fill on hover: Win98 had neither. -->
  <SolidColorBrush x:Key="CaptionButtonBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="CaptionCloseBrush" Color="#000000"/>
  <!-- #c0c0c0, the SAME face as CaptionButtonBrush - NOT transparent (this was got wrong
       twice). "No hover effect" here does not mean a transparent fill: the
       hover setters replace the button's opaque grey face, so transparent makes the face vanish
       and the BLUE title bar gradient show straight through it. That blue wash is exactly what
       kept showing on the close X. The only way to have nothing happen on hover is to
       repaint the same colour the button already is. Win98 caption buttons have no hover state at
       all - they are a raised bevel that reverses to sunken on press. -->
  <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="CaptionHoverBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="CaptionCloseHoverFgBrush" Color="#000000"/>
  <!-- Black glyphs, not ChromeTextBrush's white: the buttons have their own grey face now, so a
       white glyph would be invisible on it. -->
  <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#000000"/>

  <!-- Win98 caption geometry: a short bar with buttons that fill it, 3px in from the frame and 1px
       apart, with a wider gutter before close. The wordmark shrinks to fit the shorter bar rather
       than being clipped. -->
  <sys:Double x:Key="TitleBarHeight">22</sys:Double>
  <sys:Double x:Key="CaptionButtonWidth">18</sys:Double>
  <sys:Double x:Key="CaptionButtonHeight">16</sys:Double>
  <Thickness x:Key="CaptionButtonMargin">0,0,1,0</Thickness>
  <Thickness x:Key="CaptionCloseGap">2,0,0,0</Thickness>
  <!-- No top inset. This used to be 2, compensating for the frame being a RowSpan overlay that
       painted over the top of the caption band - the visible band was shorter than the key said,
       so a centred button had to be nudged down. The frame is a sibling of the content now
       (WindowFramePadding), covers nothing, and the band is its full height, so the nudge would
       only push the buttons off centre again. Right stays 3: that is the gap to the frame. -->
  <Thickness x:Key="CaptionButtonsMargin">0,0,3,0</Thickness>
  <!-- Tahoma Bold sits low in its line box at this size, so the centred caption reads a pixel
       below centre in a 20px band. -1 on the top lifts it. -->
  <Thickness x:Key="TitleTextMargin">0,-1,0,0</Thickness>
  <sys:Double x:Key="TitleWordmarkSize">11</sys:Double>
  <sys:Double x:Key="TitleWordmarkBoldSize">14</sys:Double>
  <!-- The blurred shadow is off here (IconShadowOpacity 0 - the theme is flat), so the wordmark
       gets the hard 1px offset copy instead: a stroke, not a glow. -->
  <sys:Double x:Key="WordmarkEmbossOpacity">1</sys:Double>
  <!-- Tahoma, NOT "MS Sans Serif": MS Sans Serif is a raster .FON, and WPF cannot render bitmap
       fonts - it silently falls back to a default face, which is why captions come out wrong.
       Tahoma is TrueType, ships with Windows, and is the Win98-era UI font. -->
  <FontFamily x:Key="ChromeFontFamily">Tahoma</FontFamily>
  <sys:Double x:Key="TitleIconSize">16</sys:Double>
  <Thickness x:Key="TitleIconMargin">0,0,4,0</Thickness>
  <!-- Not the family's 14px inset, but not flush either: 4 to MATCH the gap on the right, where
       the close button's face ends up 4px from the frame (CaptionButtonsMargin 3 + CaptionButtonMargin
       1). At 2 the icon sat visibly tighter to the left edge than the buttons did to the right. -->
  <Thickness x:Key="TitleBarPadding">4,2,0,0</Thickness>

  <!-- The content pane's inset: ZERO, flush, like the family default.

       It was 0,5,0,0, on the reasoning that this theme's caption is a distinct coloured band and
       the pane would read as jammed under it. That was wrong about Win98, where the menu bar butts
       the caption with no gap at all, and it is the "bar below the titlebar" half of the frame
       complaint - now that WindowFramePadding is exactly the frame with no face gutter above the
       caption, a 5px gutter below it is the only asymmetry left. Above the
       caption: nothing. Below it: nothing. They match. -->
  <Thickness x:Key="ContentPaneMargin">0</Thickness>

  <!-- Win98 client areas are WHITE, and both of these are client areas: an edit field and a list.
       The family rule that inputs take the darkest tone is right on a theme where the darkest tone
       is actually dark, but here it IS the button face, so the search box came out the same grey as
       the panel holding it and the note list looked like part of the window frame. -->
  <SolidColorBrush x:Key="SearchFieldBrush" Color="#ffffff"/>
  <SolidColorBrush x:Key="ListPaneBrush" Color="#ffffff"/>
  <!-- No soft scroll fades. Win98 lists end at a hard edge; a gradient hint is a modern idiom and
       is the one thing left in the sidebar that gives the era away. -->
  <sys:Double x:Key="EdgeFadeOpacity">0</sys:Double>

  <!-- No flat outline: here a button's edge IS the bevel (white top/left, grey bottom/right). A
       visible OutlineRestBrush would draw a second, flat line in the same place. Transparent
       rather than absent, so the button still reserves its 1px border and the text does not shift. -->
  <SolidColorBrush x:Key="OutlineRestBrush" Color="#00000000"/>
  <SolidColorBrush x:Key="ButtonEdgeBrush" Color="#00000000"/>

  <!-- The 1px line ringing the whole window. On the top and left it hides against the white bevel,
       but on the bottom and right it lands OUTSIDE the dark bevel as a bright stripe. The THICKNESS
       has to go to 0 as well: RootBorder wraps the whole window, so its border band sits outside
       the bevel layer, and at 1px the window's own grey Background shows through it. -->
  <SolidColorBrush x:Key="WindowEdgeBrush" Color="#00000000"/>
  <Thickness x:Key="WindowEdgeThickness">0</Thickness>

  <!-- Dialogs get a real caption band here, unlike the rest of the family where the title blends
       into the card. ThemeManager sees this marker and points DialogTitleBarBrush at whatever
       TitleBarBrush the current accent resolved to, so the band follows the accent gradient. -->
  <sys:Boolean x:Key="UseDialogCaption">True</sys:Boolean>
  <!-- 20, not 28: a Windows 98 caption is short. -->
  <sys:Double x:Key="DialogTitleBarHeight">20</sys:Double>
  <!-- No halo. There is no drop shadow to make room for, and the halo is the resize grab band - an
       invisible one puts the grab handle out in space beyond the visible window edge. -->
  <Thickness x:Key="DialogHaloMargin">0</Thickness>

  <SolidColorBrush x:Key="RowSelectedBrush" Color="#004f00"/>
  <SolidColorBrush x:Key="MenuTextBrush" Color="#000000"/>
  <SolidColorBrush x:Key="OutlinePressedBrush" Color="#a0a0a0"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#c0c0c0"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#a0a0a0"/>
  <SolidColorBrush x:Key="BgFlyout" Color="#c0c0c0"/>
  <!-- The slider's sunken groove, and the sort button's recessed white field. -->
  <SolidColorBrush x:Key="SliderTrack" Color="#808080"/>
  <!-- Button FACE, not white. These are buttons sitting on the window face, not client areas, so
       they take the same grey as every other button and only light up on hover. White at rest read
       as inverted next to the search field beside them. NOTE: the app half states this key too, and
       THIS copy wins because the contract dictionary is applied over it - so the two must agree or
       an edit to the app half silently does nothing. -->
  <SolidColorBrush x:Key="SortButtonBrush" Color="#c0c0c0"/>
  <!-- AccentLogo is deliberately NOT stated. ThemeManager defaults it to HeaderLineBrush after the
       accent overlay merges, and every 98SE accent restates HeaderLineBrush, so the wordmark's bold
       run follows whichever accent is chosen instead of being pinned to one colour. -->
</ResourceDictionary>
