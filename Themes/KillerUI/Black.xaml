<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <CornerRadius x:Key="WindowCornerRadius">7</CornerRadius><CornerRadius x:Key="PanelCornerRadius">6</CornerRadius><CornerRadius x:Key="ControlCornerRadius">4</CornerRadius><CornerRadius x:Key="SmallCornerRadius">3</CornerRadius><CornerRadius x:Key="FlyoutCornerRadius">0,0,4,4</CornerRadius><CornerRadius x:Key="AccentSwatchCornerRadius">9</CornerRadius>
  <SolidColorBrush x:Key="TitleBarBrush" Color="#000000"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#000000"/><SolidColorBrush x:Key="SurfaceBrush" Color="#000000"/><SolidColorBrush x:Key="PaneBrush" Color="#0a0a0a"/><SolidColorBrush x:Key="TableHeaderBrush" Color="#000000"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#18FFFFFF"/><SolidColorBrush x:Key="RowHoverBrush" Color="#333333"/><SolidColorBrush x:Key="MenuHoverBrush" Color="#333333"/>
  <!-- #2a2a2a, not the #787878 this shared file carried. Black's whole premise is that elements
       read by BACKGROUND rather than by bright borders, which Themes/Black.xaml states in its own
       header, and a mid-gray hairline on a #000000 surface is a 4.8:1 edge where every other dark
       theme in the set sits between 1.1 and 1.7. It framed every dialog, every card and every
       keycap in a light box. The app layer already said #2a2a2a and could not win: this file is
       overlaid ON TOP of it (Services/KillerThemeContract.cs), so the value has to be corrected
       here. -->
  <SolidColorBrush x:Key="CardBorderBrush" Color="#2a2a2a"/><SolidColorBrush x:Key="PaneBorderBrush" Color="#1c1c1c"/><SolidColorBrush x:Key="AppBorderBrush" Color="#2a2a2a"/>
  <SolidColorBrush x:Key="TextBrush" Color="#ffffff"/><SolidColorBrush x:Key="MutedTextBrush" Color="#cccccc"/><SolidColorBrush x:Key="ChromeTextBrush" Color="#e6e6e6"/><SolidColorBrush x:Key="DimTextBrush" Color="#aaaaaa"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#1c1c1c"/><SolidColorBrush x:Key="InputHoverBrush" Color="#aaaaaa"/><SolidColorBrush x:Key="MenuBackgroundBrush" Color="#121212"/><SolidColorBrush x:Key="MenuBorderBrush" Color="#1c1c1c"/>
  <SolidColorBrush x:Key="SelectionBg" Color="#003314"/><SolidColorBrush x:Key="SelectionFg" Color="#ffffff"/><SolidColorBrush x:Key="PrimaryBrush" Color="#00ff66"/><SolidColorBrush x:Key="PrimaryHoverBrush" Color="#00ff66"/><SolidColorBrush x:Key="PrimaryPressedBrush" Color="#00ff66"/><SolidColorBrush x:Key="OnPrimaryBrush" Color="#ffffff"/><SolidColorBrush x:Key="OutlineBtnBrush" Color="#00ff66"/><SolidColorBrush x:Key="HeaderLineBrush" Color="#00ff66"/>
</ResourceDictionary>
