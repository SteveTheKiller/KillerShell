<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="MonitorCellBrush"        Color="#000000" po:Freeze="True"/>
    <!-- ...and the text ON that black. 98SE's TextBrush is #000000 and its PrimaryBrush #004f00,
         both picked against a light gray app - on a black console they are invisible and nearly
         invisible. The console's own light gray and bright green, as CMD had. -->
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#c0c0c0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TerminalAccentBrush"     Color="#00c000" po:Freeze="True"/>
    <!-- Text ON the black monitor cells (Performance tab). TextBrush is black here and MutedText
         near-black, both invisible on the CRT readouts, so the cells get phosphor greens instead:
         the console green above for values and titles, a dimmer green for labels and captions -
         a retro green for the text in the black squares. -->
    <SolidColorBrush x:Key="MonitorTextBrush"  Color="#00c000" po:Freeze="True"/>
    <SolidColorBrush x:Key="MonitorMutedBrush" Color="#008000" po:Freeze="True"/>
    <!-- The Events/Processes/Registry tables' alternate-row stripe: a SOLID light gray on the
         white rows, deliberately NOT the #c0c0c0 window face - white and gray striped, but not
         the same gray as the main window color. #dfdfdf is the era's scrollbar
         channel gray, already in the palette. -->
    <SolidColorBrush x:Key="GridRowAltBrush" Color="#dfdfdf" po:Freeze="True"/>
    <!-- A hovered monitor tile: a slightly lifted black, NOT RowHoverBrush - that is the window
         face gray here and made the tile vanish into the window. -->
    <SolidColorBrush x:Key="MonitorHoverBrush" Color="#1c1c1c" po:Freeze="True"/>
    <!-- The tool tabs' sunken wells are WHITE client areas: the Events/Processes tables, the
         Registry value grid (ToolContentBrush) and the Registry tree (ToolTreeBrush), like
         Explorer's own panes. -->
    <SolidColorBrush x:Key="ToolContentBrush" Color="#ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="ToolTreeBrush"    Color="#ffffff" po:Freeze="True"/>
    <!-- The fill that masks the tree's connecting line where the chevron crosses it
         (arrowFill, Controls/Controls.xaml). Its only job is to vanish into the surface behind
         the chevron, so it has to BE that surface. ThemeManager mirrors it onto
         SolidBackgroundBrush, which is right for every other theme - there the tree is
         transparent and the window really does show through it. Here it is wrong twice over:
         the folder tree sits in the sunken WHITE list well (SidebarPaneBrush) and the Registry
         tree in its own white well (ToolTreeBrush), while SolidBackgroundBrush is the #c0c0c0
         window face - so the mask painted a gray wedge through the middle of every chevron.
         Stated here so only this theme differs; the Mirror is skipped whenever the key already
         exists. WHITE, tracking SidebarPaneBrush and ToolTreeBrush above - if either of those
         stops being #ffffff, this has to follow. -->
    <SolidColorBrush x:Key="TreeChevronMaskBrush" Color="#ffffff" po:Freeze="True"/>
    <!-- The Performance tab's black cells sit together with thin 2px seams instead of floating
         in gray gutters, and the info panel and detail card run flush to the pane edges - the
         padding between all the black cells goes away, and the right edge lines up with
         the tab strip. -->
    <Thickness x:Key="MonitorDetailMargin">0,0,0,2</Thickness>
    <Thickness x:Key="MonitorInfoMargin">0,0,0,2</Thickness>
    <Thickness x:Key="MonitorTileListMargin">0,0,2,2</Thickness>
    <Thickness x:Key="MonitorTileMargin">0,0,0,2</Thickness>
    <!-- The cell grid runs flush to the pane edges; the cells' own 1px PaneBorderBrush frames
         are the seams between neighbors. -->
    <Thickness x:Key="MonitorGridMargin">0</Thickness>
    <!-- The tool-tab wells are filled edge to edge: no gutters around the Events/Processes
         grids, and the Registry split runs flush left and right with only the skinny splitter
         dividing tree from values. -->
    <Thickness x:Key="ToolGridMargin">0</Thickness>
    <Thickness x:Key="RegSplitMargin">0</Thickness>
    <Thickness x:Key="RegGridMargin">0</Thickness>
    <sys:Double x:Key="RegSplitterWidth">3</sys:Double>
    <!-- Selected DataGrid cell text: white on the solid navy selection block. -->
    <SolidColorBrush x:Key="GridSelectedTextBrush" Color="#ffffff" po:Freeze="True"/>

    <sys:Double x:Key="GrainOpacity" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">0</sys:Double>
    <sys:Double x:Key="IconShadowOpacity" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">0</sys:Double>

    <!-- Text-stroke shadows behind button labels. Nulled, as on Light: any Effect
         rasterizes ClearType, so on a light surface the label just looks blurry. -->
    <x:Null x:Key="TextStroke"/>
    <x:Null x:Key="TextStrokeSoft"/>

    <!-- Chrome the shared layer leaves to the app -->
    <SolidColorBrush x:Key="TextFooter"          Color="#606060" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush" Color="#000000" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="TreeLineBrush"       Color="#808080" po:Freeze="True"/>
    <!-- A faint wash, NOT the base layer's SelectionBg - see the note in Sepulchre.xaml. A
         translucent BLACK rather than the white the dark themes use: 98SE's surfaces are
         #c0c0c0 and #ffffff, so a white wash would be invisible on both. -->
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#004f00" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#a0a0a0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#08000000" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />

    <!-- Resting accent edge: the accent at 40%, for a lip that reads as accent-colored
         without claiming to be the live thing. The active tab of the UNFOCUSED pane. -->
    <SolidColorBrush x:Key="TabEdgeBrush"          Color="#66004f00" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#c0c0c0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#a0a0a0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />

    <!-- Traffic light. Three FIXED colors on purpose: the status dot sits in the footer
         permanently, and using the accent made "all fine" mean whatever accent was picked. -->
    <SolidColorBrush x:Key="OkBrush"   Color="#1a7f37" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#a86a00" po:Freeze="True"/>

