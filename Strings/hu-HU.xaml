    <!-- About overlay -->
    <!-- Tagline is composed in XAML: DescA + "GPLv3 " + [Killer Tools link] + DescB.
         GPLv3 and the product name stay out of the translatable text (family standard). -->
    <sys:String x:Key="Str_About_Title">A KillerShellről</sys:String>
    <sys:String x:Key="Str_Status_TextSize">Szövegméret: {0}%</sys:String>
    <sys:String x:Key="Str_About_DescA" xml:space="preserve">Egy hordozható alkalmazás a számítógép és fájljainak kezelésére. A fájlböngésző, terminál, szövegszerkesztő, tárolóelemző és adminisztrációs eszközök egy ablakon osztoznak. A </sys:String>
    <sys:String x:Key="Str_About_DescB" xml:space="preserve"> hasznosság.</sys:String>
    <sys:String x:Key="Str_About_Version">VERZIÓ</sys:String>
    <sys:String x:Key="Str_About_Publisher">KIADÓ</sys:String>
    <sys:String x:Key="Str_About_Thumbprint">ujjlenyomat</sys:String>
    <sys:String x:Key="Str_About_Sha">EXE SHA-256</sys:String>
    <sys:String x:Key="Str_About_ConfirmFolderDelete">Kérdezze meg, mielőtt mappát küldene a Lomtárba</sys:String>
    <!-- Clear all Data: the link, its confirm and its result. Kept with the About keys rather than
         split across three sections - one feature, and a translator needs to see them together. -->
    <sys:String x:Key="Str_About_ClearData">Minden adat törlése</sys:String>
    <sys:String x:Key="Str_Dlg_ClearDataMsg">Ezzel törli az összes mentett beállítást – a témát, a nyelvet, a betűtípusokat, a mentett helyeket, a legutóbbi bejegyzéseket és a munkamenetet –, valamint az archívumokból kivont ideiglenes fájlokat. A saját fájljait nem érinti meg. Folytatja?</sys:String>
    <sys:String x:Key="Str_Status_DataCleared">Adatok törölve – indítsa újra a KillerShell-t a még használatban lévő elemek törlésének befejezéséhez</sys:String>
