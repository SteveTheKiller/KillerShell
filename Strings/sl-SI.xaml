    <sys:String x:Key="Str_Dlg_InstallMsg">Namestim KillerShell v ta računalnik?</sys:String>
    <sys:String x:Key="Str_Dlg_InstallBullets">Prenosna aplikacija se kopira v vašo mapo Programs. Dodata se bližnjica v meniju Start in vnos na seznamu za dodajanje/odstranjevanje programov. To prenosno datoteko lahko nato ohranite ali izbrišete.</sys:String>
