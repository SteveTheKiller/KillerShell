    <sys:String x:Key="Str_About_DescA" xml:space="preserve">Ena prenosna aplikacija za upravljanje računalnika in njegovih datotek. Brskalnik datotek, terminal, urejevalnik besedila, analizator shrambe in skrbniška orodja v enem oknu. Orodje družine </sys:String>
    <sys:String x:Key="Str_About_DescB" xml:space="preserve">.</sys:String>
