    <sys:String x:Key="Str_About_Thumbprint">PRSTNI ODTIS</sys:String>
    <sys:String x:Key="Str_About_Sha">EXE SHA-256</sys:String>
    <sys:String x:Key="Str_About_ConfirmFolderDelete">Vprašaj pred pošiljanjem mape v koš</sys:String>
    <sys:String x:Key="Str_About_ClearData">Počisti vse podatke</sys:String>
